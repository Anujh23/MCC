---
// Compact footer: logo, phone, the main pages. Per-item lists live in the header nav.
import { Phone } from '@lucide/astro';
import Logo from './Logo.astro';
import { site, contact, href } from '../data/site';

const links = [
  { label: 'Services', path: '/services/' },
  { label: 'Products', path: '/products/' },
  { label: 'Industries', path: '/industries/' },
  { label: 'About', path: '/about/' },
  { label: 'Careers', path: '/careers/' },
  { label: 'Insights', path: '/insights/' },
  { label: 'Contact', path: '/contact/' },
];
const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-ink-950 text-ink-300">
  <div class="container-page flex flex-col gap-5 py-10 lg:flex-row lg:items-center lg:justify-between lg:gap-12 lg:py-12">
    <div class="flex flex-wrap items-center gap-x-8 gap-y-3">
      <a href={href('/')} aria-label={`${site.name}, home`} class="inline-block rounded-lg"><Logo tone="light" /></a>
      {contact.phone && (
        <a href={contact.phoneHref} class="inline-flex items-center gap-2 py-2 text-sm font-semibold text-white hover:text-brand-200">
          <Phone size={15} class="text-saffron-400" aria-hidden="true" />{contact.phone}
        </a>
      )}
    </div>
    <nav aria-label="Footer">
      <ul class="-mx-2 flex flex-wrap text-sm lg:justify-end">
        {links.map((l) => (
          <li><a href={href(l.path)} class="inline-block px-2 py-2 transition hover:text-white">{l.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>

  <div class="border-t border-white/10">
    <div class="container-page flex flex-wrap items-center justify-between gap-x-6 py-2 text-xs text-ink-400">
      <p class="py-2">© {year}. All rights reserved.</p>
      <div class="flex gap-5">
        <a href={href('/privacy/')} class="inline-block py-2 hover:text-white">Privacy</a>
        <a href={href('/terms/')} class="inline-block py-2 hover:text-white">Terms</a>
      </div>
    </div>
  </div>
</footer>
