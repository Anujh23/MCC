---
import Logo from './Logo.astro';
import { site, contact, services, products, industries, company, href } from '../data/site';

const columns = [
  { title: 'Services', base: '/services', items: services },
  { title: 'Products', base: '/products', items: products },
  { title: 'Industries', base: '/industries', items: industries },
  { title: 'Company', base: '', items: company },
];
const year = new Date().getFullYear();
---

<footer class="border-t border-white/10 bg-ink-950 text-ink-300">
  <div class="container-page grid grid-cols-2 gap-x-6 gap-y-10 py-16 lg:grid-cols-[1.4fr_repeat(4,1fr)] lg:gap-x-8">
    <div class="col-span-2 max-w-sm lg:col-span-1">
      <Logo tone="light" />
      <p class="mt-5 text-sm leading-relaxed text-ink-400">{site.description}</p>
      <div class="mt-5 text-sm">
        {contact.email && <a href={`mailto:${contact.email}`} class="inline-block py-2 text-white hover:text-saffron-400">{contact.email}</a>}
        {contact.phone && <a href={contact.phoneHref} class="block w-fit py-2 hover:text-white">{contact.phone}</a>}
        <p class="py-2">{site.location}</p>
      </div>
    </div>

    {columns.map((col) => (
      <div>
        <h2 class="text-xs font-semibold tracking-[0.14em] text-white uppercase">{col.title}</h2>
        <ul class="mt-3 text-sm">
          {col.items.map((item) => (
            <li><a href={href(`${col.base}/${item.slug}`)} class="inline-block py-2 transition hover:text-white">{item.title}</a></li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <div class="border-t border-white/10">
    <div class="container-page flex flex-col gap-1 py-4 text-xs text-ink-400 sm:flex-row sm:items-center sm:justify-between">
      <p class="py-2">© {year} {site.name}. All rights reserved.</p>
      <div class="flex gap-5">
        <a href={href('/privacy')} class="inline-block py-3 hover:text-white">Privacy</a>
        <a href={href('/terms')} class="inline-block py-3 hover:text-white">Terms</a>
        {contact.linkedin && <a href={contact.linkedin} rel="noopener" class="inline-block py-3 hover:text-white">LinkedIn</a>}
      </div>
    </div>
  </div>
</footer>
