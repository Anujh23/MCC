---
// Shared layout for Privacy and Terms: compact dark header with the draft notice,
// sticky table of contents and readable prose. Put <section id="..."> blocks in the slot
// whose ids match `sections`.
import { TriangleAlert } from '@lucide/astro';
import Base from '../../layouts/Base.astro';
import Prose from './Prose.astro';
import Breadcrumbs from '../ui/Breadcrumbs.astro';

interface Props {
  title: string;
  description: string;
  updated: string;
  sections: { id: string; title: string }[];
}
const { title, description, updated, sections } = Astro.props;
---

<Base title={title} description={description} noindex>
  <section class="relative overflow-hidden bg-ink-950 text-white">
    <div class="bg-grid mask-fade-y pointer-events-none absolute inset-0"></div>
    <div class="animate-glow pointer-events-none absolute -top-48 -right-40 h-[30rem] w-[30rem] rounded-full bg-brand-600/30 blur-3xl"></div>
    <div class="container-page relative py-12 lg:py-16">
      <Breadcrumbs items={[{ label: title }]} class="-mt-2" />
      <h1 class="mt-4 text-4xl font-extrabold text-white sm:text-5xl">{title}</h1>
      <p class="mt-4 text-sm text-ink-400">Last updated: {updated}</p>
      <div class="mt-6 flex max-w-3xl gap-3 rounded-2xl bg-saffron-50 p-4 text-sm leading-relaxed text-ink-900 ring-1 ring-saffron-100 sm:p-5" role="note">
        <TriangleAlert size={20} class="mt-0.5 shrink-0 text-saffron-700" aria-hidden="true" />
        <p>
          <strong class="font-semibold">Draft, not yet reviewed by a lawyer.</strong>
        </p>
      </div>
    </div>
  </section>

  <div class="bg-white py-12 lg:py-16">
    <div class="container-page">

      <div class="grid gap-10 lg:grid-cols-[16rem_minmax(0,1fr)] lg:gap-16">
        <nav aria-label="Table of contents" class="lg:sticky lg:top-28 lg:self-start">
          <div class="rounded-2xl bg-ink-50 p-5 ring-1 ring-ink-100">
            <p class="text-xs font-semibold tracking-[0.14em] text-ink-500 uppercase">Contents</p>
            <ol class="mt-3 space-y-0.5 text-sm">
              {sections.map((s, i) => (
                <li>
                  <a href={`#${s.id}`} class="flex gap-2.5 rounded-lg px-2 py-1.5 text-ink-600 transition hover:bg-white hover:text-ink-900">
                    <span class="w-5 shrink-0 text-right font-semibold text-brand-700 tabular-nums">{i + 1}.</span>{s.title}
                  </a>
                </li>
              ))}
            </ol>
          </div>
        </nav>
        <Prose class="legal max-w-3xl min-w-0">
          <slot />
        </Prose>
      </div>
    </div>
  </div>
</Base>

<style>
  /* .legal sits on Prose's root div (another component), so these must be global. */
  :global(.prose-manka.legal section) { scroll-margin-top: 6rem; }
  :global(.prose-manka.legal > section + section) { margin-top: 2.5rem; padding-top: 2.5rem; border-top: 1px solid var(--color-ink-100); }
  :global(.prose-manka.legal section > h2) { margin-top: 0; margin-bottom: 0; }
  :global(.prose-manka.legal section > * + *) { margin-top: 1em; }
</style>
