---
// Contact form ("Book a free call"): name and mobile, plus an optional topic and note. We call back, so
// no email is asked for. Posts JSON to Web3Forms (works on static hosting like GitHub Pages). With no form
// key yet ('offline', staging only) it validates but sends nothing.
// ?interest=<slug> preselects the topic and retitles the element marked [data-cf-title].
import { Send, LoaderCircle, CircleCheck, CircleAlert, ArrowRight } from '@lucide/astro';
import { site, contact, interests, products, industryInterest, href, cta } from '../../data/site';

const mode = contact.formKey ? 'live' : 'offline';

const groups = [
  { label: 'Services', kind: 'service' },
  { label: 'Products', kind: 'product' },
  { label: 'Other', kind: 'other' },
] as const;
const shortName = (slug: string) => products.find((p) => p.slug === slug)?.short;

const field =
  'mt-2 block w-full rounded-xl border border-ink-400 bg-white px-4 py-3 text-[0.95rem] text-ink-900 transition placeholder:text-ink-500 focus:border-brand-600 focus:ring-2 focus:ring-brand-500/30 focus:outline-hidden aria-[invalid=true]:border-rose-600 aria-[invalid=true]:ring-2 aria-[invalid=true]:ring-rose-600/20';
const label = 'block text-sm font-semibold text-ink-900';
const optional = 'font-normal text-ink-500';
// Empty until the field is invalid, so aria-describedby reads nothing on a fresh form. Text lives in data-msg.
const errorCls = 'mt-1.5 text-sm font-medium text-rose-700 empty:hidden';
const chevron = 'pointer-events-none absolute top-1/2 right-4 mt-1 h-4 w-4 -translate-y-1/2 text-ink-500';
---

<form
  id="contact-form"
  class="relative"
  action="https://api.web3forms.com/submit"
  method="POST"
  novalidate
  data-mode={mode}
  data-aliases={JSON.stringify(industryInterest)}
  data-cta-call={cta.call}
  data-cta-demo={cta.demo}
  data-cta-introduce={cta.introduce}
>
  {contact.formKey && <input type="hidden" name="access_key" value={contact.formKey} />}
  <input type="hidden" name="subject" value={`Call-back request from ${site.shortName} website`} />
  <input type="hidden" name="from_name" value={`${site.shortName} website`} />
  <!-- Honeypot: humans never see or tick this. Web3Forms drops submissions where it is checked. -->
  <input type="checkbox" name="botcheck" class="hidden" style="display: none" tabindex="-1" autocomplete="off" aria-hidden="true" />

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="cf-name" class={label}>Your name <span class="text-rose-600" aria-hidden="true">*</span></label>
      <input id="cf-name" name="name" type="text" autocomplete="name" required class={field} placeholder="Priya Sharma" aria-describedby="cf-name-error" data-field="Your name" />
      <p id="cf-name-error" class={errorCls} data-msg="Please tell us your name."></p>
    </div>
    <div>
      <label for="cf-phone" class={label}>Mobile number <span class="text-rose-600" aria-hidden="true">*</span></label>
      <input id="cf-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" required maxlength="16" class={field} placeholder="98765 43210" aria-describedby="cf-phone-error" data-field="Mobile number" />
      <p id="cf-phone-error" class={errorCls} data-msg="Please enter a 10-digit mobile number."></p>
    </div>
    <div>
      <label for="cf-interest" class={label}>What do you need? <span class={optional}>(optional)</span></label>
      <div class="relative">
        <select id="cf-interest" name="interest" class={`${field} appearance-none pr-10`}>
          <option value="">Not sure yet</option>
          {groups.map((g) => (
            <optgroup label={g.label}>
              {interests.filter((i) => i.kind === g.kind).map((i) => (
                <option value={i.label} data-slug={i.value} data-kind={i.kind} data-short={shortName(i.value)}>{i.label}</option>
              ))}
            </optgroup>
          ))}
        </select>
        <svg class={chevron} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
      </div>
    </div>
    <div>
      <label for="cf-message" class={label}>Anything else? <span class={optional}>(optional)</span></label>
      <input id="cf-message" name="message" type="text" maxlength="300" class={field} placeholder="Company, deadline, best time to call…" />
    </div>
  </div>

  <button type="submit" class="btn btn-primary group mt-7 w-full px-7 py-3.5 text-base disabled:cursor-wait disabled:opacity-70">
    <span data-label>{cta.call}</span>
    <Send size={17} data-icon class="transition group-hover:translate-x-0.5" aria-hidden="true" />
    <LoaderCircle size={17} data-spinner class="hidden animate-spin" aria-hidden="true" />
  </button>
  <p class="mt-3 text-center text-xs text-ink-500">
    {mode === 'offline' && <>This form goes live at launch. </>}By sending, you agree to our <a href={href('/privacy/')} class="font-semibold text-brand-700 underline underline-offset-2">privacy policy</a>.
  </p>

  <p class="sr-only" aria-live="polite" data-summary></p>

  <div id="cf-status" class="mt-6" role="status" aria-live="polite">
    <div data-state="success" class="hidden gap-3 rounded-xl bg-emerald-50 p-4 text-sm leading-relaxed text-emerald-900 ring-1 ring-emerald-200">
      <CircleCheck size={20} class="mt-0.5 shrink-0 text-emerald-600" aria-hidden="true" />
      <div>
        <p><strong class="font-semibold">Got it.</strong> An engineer will call you within one working day.</p>
        <a href={href('/about/#how-we-work')} class="group mt-2 inline-flex items-center gap-1 py-1 font-semibold text-emerald-900 underline underline-offset-2">
          While you wait: how we work<ArrowRight size={15} class="transition group-hover:translate-x-0.5" aria-hidden="true" />
        </a>
      </div>
    </div>
    <div data-state="error" class="hidden gap-3 rounded-xl bg-rose-50 p-4 text-sm leading-relaxed text-rose-900 ring-1 ring-rose-200">
      <CircleAlert size={20} class="mt-0.5 shrink-0 text-rose-600" aria-hidden="true" />
      <p>
        <strong class="font-semibold">That didn’t go through.</strong> <span data-error-text>Please try again in a moment</span>{contact.phone
          ? <>, or call us on <a href={contact.phoneHref} class="font-semibold underline underline-offset-2">{contact.phone}</a>.</>
          : '.'}
      </p>
    </div>
    <div data-state="offline" class="hidden gap-3 rounded-xl bg-ink-50 p-4 text-sm leading-relaxed text-ink-800 ring-1 ring-ink-200">
      <CircleAlert size={20} class="mt-0.5 shrink-0 text-ink-600" aria-hidden="true" />
      <p><strong class="font-semibold">This form goes live at launch.</strong> Your details look fine, but nothing was sent.</p>
    </div>
  </div>
</form>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  if (form) {
    const status = form.querySelector<HTMLElement>('#cf-status')!;
    const summary = form.querySelector<HTMLElement>('[data-summary]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const buttonLabel = button.querySelector<HTMLElement>('[data-label]')!;
    const select = form.querySelector<HTMLSelectElement>('#cf-interest')!;
    const title = document.querySelector<HTMLElement>('[data-cf-title]');
    const { mode, ctaCall = '', ctaDemo = '', ctaIntroduce = '' } = form.dataset;
    const aliases: Record<string, string> = JSON.parse(form.dataset.aliases || '{}');
    const defaultTitle = title?.textContent ?? '';

    // Heading and submit label follow the chosen topic: products ask for a demo, careers for an intro.
    let submitLabel = ctaCall;
    const updateIntent = () => {
      const opt = select.selectedOptions[0];
      const kind = opt?.dataset.kind;
      const slug = opt?.dataset.slug;
      let heading = defaultTitle;
      submitLabel = ctaCall;
      if (kind === 'product') {
        heading = `Request a ${opt.dataset.short ?? opt.textContent} demo`;
        submitLabel = ctaDemo;
      } else if (slug === 'careers') {
        heading = submitLabel = ctaIntroduce;
      }
      if (title) title.textContent = heading;
      buttonLabel.textContent = submitLabel;
    };

    const wanted = new URLSearchParams(location.search).get('interest');
    if (wanted) {
      const key = aliases[wanted] ?? wanted;
      const opt = select.querySelector<HTMLOptionElement>(`option[data-slug="${CSS.escape(key)}"]`);
      if (opt) opt.selected = true;
    }
    updateIntent();
    select.addEventListener('change', updateIntent);

    // Indian mobile: optional +91 / 91 / 0 prefix, then 10 digits starting 6–9. Spaces and dashes are fine.
    const mobile = (v: string) => /^(?:\+?91|0)?[6-9]\d{9}$/.test(v.replace(/[\s()-]/g, ''));
    const rules: Record<string, (el: HTMLInputElement) => boolean> = {
      name: (el) => el.value.trim().length >= 2,
      phone: (el) => mobile(el.value),
    };

    const setError = (el: HTMLInputElement, bad: boolean) => {
      el.setAttribute('aria-invalid', bad ? 'true' : 'false');
      const err = document.getElementById(`${el.id}-error`);
      if (err) err.textContent = bad ? (err.dataset.msg ?? '') : '';
    };

    const validate = () => {
      const bad: HTMLInputElement[] = [];
      for (const [name, ok] of Object.entries(rules)) {
        const el = form.elements.namedItem(name) as HTMLInputElement | null;
        if (!el) continue;
        const isBad = !ok(el);
        setError(el, isBad);
        if (isBad) bad.push(el);
      }
      return bad;
    };

    // Re-validate a field once the user has been told it's wrong
    const recheck = (e: Event) => {
      const el = e.target as HTMLInputElement;
      if (el.getAttribute('aria-invalid') === 'true' && rules[el.name]) setError(el, !rules[el.name](el));
    };
    form.addEventListener('input', recheck);

    const show = (state: 'success' | 'error' | 'offline' | null) => {
      status.querySelectorAll<HTMLElement>('[data-state]').forEach((s) => {
        const on = s.dataset.state === state;
        s.classList.toggle('hidden', !on);
        s.classList.toggle('flex', on);
      });
    };

    const setLoading = (on: boolean) => {
      button.disabled = on;
      button.setAttribute('aria-busy', String(on));
      buttonLabel.textContent = on ? 'Sending…' : submitLabel;
      button.querySelector('[data-icon]')?.classList.toggle('hidden', on);
      button.querySelector('[data-spinner]')?.classList.toggle('hidden', !on);
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      show(null);
      const bad = validate();
      if (bad.length) {
        const names = bad.map((el) => el.dataset.field).join(', ');
        summary.textContent = `${bad.length} ${bad.length === 1 ? 'field needs' : 'fields need'} attention: ${names}.`;
        bad[0].focus();
        return;
      }
      summary.textContent = '';

      if (mode === 'offline') {
        show('offline');
        return;
      }

      setLoading(true);
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        const json = await res.json().catch(() => ({}));
        if (res.ok && json.success) {
          form.reset();
          form.querySelectorAll('[aria-invalid]').forEach((el) => el.setAttribute('aria-invalid', 'false'));
          updateIntent();
          show('success');
        } else {
          const msg = status.querySelector('[data-error-text]');
          if (msg && json.message) msg.textContent = json.message;
          show('error');
        }
      } catch {
        show('error');
      } finally {
        setLoading(false);
      }
    });
  }
</script>
