---
// Insights card. variant="featured" renders the large dark card used at the top of /insights.
import type { CollectionEntry } from 'astro:content';
import { href } from '../../data/site';

interface Props {
  post: CollectionEntry<'insights'>;
  variant?: 'default' | 'featured';
  delay?: number;
}
const { post, variant = 'default', delay = 0 } = Astro.props;
const { title, description } = post.data;
const url = href(`/insights/${post.id}/`);
// Focus shows as an outline on the whole card (box-shadow rings vanish in forced-colours mode).
---

{variant === 'featured' ? (
  <article class="reveal relative overflow-hidden rounded-3xl bg-ink-950 text-white ring-1 ring-ink-900 has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-2 has-[a:focus-visible]:outline-saffron-400" style={`--d: ${delay}ms`}>
    <div class="bg-grid mask-fade-y pointer-events-none absolute inset-0"></div>
    <div class="animate-glow pointer-events-none absolute -top-24 -right-24 h-80 w-80 rounded-full bg-brand-600/40 blur-3xl"></div>
    <div class="relative max-w-3xl p-6 sm:p-10 lg:p-14">
      <h2 class="text-2xl leading-tight font-extrabold text-white sm:text-4xl">
        <a href={url} class="after:absolute after:inset-0 after:rounded-3xl focus-visible:outline-hidden">{title}</a>
      </h2>
      <p class="mt-4 text-base leading-relaxed text-ink-300 sm:text-lg">{description}</p>
    </div>
  </article>
) : (
  <article class="reveal card-link relative flex h-full flex-col p-7 has-[a:focus-visible]:outline-2 has-[a:focus-visible]:outline-offset-2 has-[a:focus-visible]:outline-brand-500" style={`--d: ${delay}ms`}>
    <h3 class="text-xl leading-snug font-bold">
      <a href={url} class="after:absolute after:inset-0 after:rounded-2xl focus-visible:outline-hidden">{title}</a>
    </h3>
    <p class="mt-3 text-[0.95rem] leading-relaxed text-ink-600">{description}</p>
  </article>
)}
