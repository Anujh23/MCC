---
// Long-form text styling (articles, legal pages). Tailwind typography isn't installed,
// so markdown/HTML inside the slot is styled here with :global() selectors.
interface Props { class?: string }
const { class: className = '' } = Astro.props;
---

<div class={`prose-manka ${className}`}><slot /></div>

<style>
  .prose-manka {
    color: var(--color-ink-600);
    font-size: 1.0625rem;
    line-height: 1.8;
    overflow-wrap: break-word;
  }
  .prose-manka > :global(* + *) { margin-top: 1.25em; }
  .prose-manka :global(h2) {
    margin-top: 2.4em;
    margin-bottom: -0.25em;
    font-size: 1.5rem;
    line-height: 1.3;
    font-weight: 800;
    color: var(--color-ink-900);
    scroll-margin-top: 6rem;
  }
  .prose-manka > :global(h2:first-child) { margin-top: 0; }
  .prose-manka :global(h3) {
    margin-top: 1.9em;
    margin-bottom: -0.4em;
    font-size: 1.175rem;
    line-height: 1.4;
    font-weight: 700;
    color: var(--color-ink-900);
    scroll-margin-top: 6rem;
  }
  .prose-manka :global(strong) { color: var(--color-ink-900); font-weight: 700; }
  .prose-manka :global(a) {
    color: var(--color-brand-700);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--color-brand-200);
    text-underline-offset: 3px;
    text-decoration-thickness: 2px;
  }
  .prose-manka :global(a:hover) { text-decoration-color: var(--color-brand-600); }
  .prose-manka :global(ul),
  .prose-manka :global(ol) { padding-left: 1.4em; }
  .prose-manka :global(ul) { list-style: none; padding-left: 0; }
  .prose-manka :global(ul > li) { position: relative; padding-left: 1.6em; }
  .prose-manka :global(ul > li::before) {
    content: '';
    position: absolute;
    left: 0.25em;
    top: 0.72em;
    width: 0.45em;
    height: 0.45em;
    border-radius: 9999px;
    background: var(--color-saffron-500);
  }
  .prose-manka :global(ol) { list-style: decimal; }
  .prose-manka :global(ol > li::marker) { color: var(--color-brand-600); font-weight: 700; }
  .prose-manka :global(li + li) { margin-top: 0.6em; }
  .prose-manka :global(blockquote) {
    border-left: 3px solid var(--color-brand-500);
    background: var(--color-brand-50);
    border-radius: 0 0.75rem 0.75rem 0;
    padding: 1em 1.25em;
    color: var(--color-ink-800);
  }
  .prose-manka :global(code) {
    background: var(--color-ink-100);
    border-radius: 0.375rem;
    padding: 0.15em 0.4em;
    font-size: 0.9em;
    color: var(--color-ink-900);
  }
  .prose-manka :global(hr) { border: 0; border-top: 1px solid var(--color-ink-100); margin: 2.5em 0; }
  .prose-manka :global(table) { width: 100%; border-collapse: collapse; font-size: 0.95em; }
  .prose-manka :global(th),
  .prose-manka :global(td) { border-bottom: 1px solid var(--color-ink-100); padding: 0.6em 0.75em; text-align: left; vertical-align: top; }
  .prose-manka :global(th) { color: var(--color-ink-900); font-weight: 700; background: var(--color-ink-50); }
</style>
