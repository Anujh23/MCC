---
// Mark: "M" whose two strokes meet at a saffron node. Same SVG as public/favicon.svg (keep in sync;
// scripts/og renders the PNGs from that file). `tone` = wordmark colour for light/dark backgrounds.
interface Props {
  tone?: 'dark' | 'light';
  mark?: boolean; // mark only, no wordmark
  size?: 'md' | 'lg'; // lg = big standalone mark (404)
  class?: string;
}
const { tone = 'dark', mark = false, size = 'md', class: className = '' } = Astro.props;
const box = { md: 'h-9 w-9', lg: 'h-16 w-16' }[size];
---

<span class={`inline-flex items-center gap-2.5 ${className}`}>
  <svg class={`${box} shrink-0`} viewBox="0 0 48 48" aria-hidden="true">
    <rect width="48" height="48" rx="12" class="fill-brand-600" />
    <path d="M13.5 33V15l10.5 10.5L34.5 15v18" fill="none" class="stroke-white" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round" />
    <circle cx="24" cy="25.5" r="4" class="fill-saffron-500 stroke-brand-600" stroke-width="1.5" />
  </svg>
  {!mark && <span class={`text-xl font-extrabold leading-none tracking-tight ${tone === 'dark' ? 'text-ink-900' : 'text-white'}`}>Manka</span>}
</span>
