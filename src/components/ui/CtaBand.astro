---
// Closing call-to-action band. Drop at the bottom of any page; as the last block it straddles the footer seam.
// `interest` pre-fills the contact form (industry slugs are mapped). The primary goes to the form
// unless you give it a path. With no `secondary`, an "Email us" button shows only once contact.email is real.
// Usage: <CtaBand interest={slug} secondary={{ label: cta.allServices, path: '/services/' }} />
//        <CtaBand primary={{ label: cta.demo }} interest="crm" />
import { ArrowRight, ArrowUpRight } from '@lucide/astro';
import { href, contact, contactHref, cta } from '../../data/site';

interface Props {
  title?: string;
  text?: string;
  primary?: { label: string; path?: string };
  secondary?: { label: string; path: string };
  interest?: string;
}
const {
  title = 'Bring one problem to a 30-minute call.',
  text = 'Thirty minutes with an engineer. Bring the problem; leave with a rough scope, timeline and cost.',
  primary,
  secondary,
  interest,
} = Astro.props;
const primaryLabel = primary?.label ?? cta.call;
const primaryHref = primary?.path ? href(primary.path) : contactHref(interest);
const second = secondary
  ? { label: secondary.label, url: href(secondary.path), external: /^(mailto:|tel:|https?:)/.test(secondary.path) }
  : contact.email
    ? { label: cta.email, url: `mailto:${contact.email}`, external: true }
    : null;
---

<section class="cta-band bg-white py-20 lg:py-24">
  <div class="container-page">
    <div data-cta-card class="reveal relative overflow-hidden rounded-3xl bg-ink-950 px-6 ring-1 ring-white/10 py-14 text-center sm:px-12 lg:py-20">
      <div class="bg-grid mask-fade-y pointer-events-none absolute inset-0"></div>
      <div class="animate-glow pointer-events-none absolute -top-32 left-1/2 h-80 w-[40rem] -translate-x-1/2 rounded-full bg-brand-600/40 blur-3xl"></div>
      <div class="relative mx-auto max-w-2xl">
        <h2 class="text-3xl leading-tight font-extrabold text-white sm:text-4xl">{title}</h2>
        <p class="mt-4 text-lg leading-relaxed text-ink-300">{text}</p>
        <div class="mt-9 grid gap-3 sm:flex sm:flex-wrap sm:justify-center">
          <a href={primaryHref} class="btn btn-primary group px-6 py-3 text-base">
            {primaryLabel}<ArrowRight size={18} class="transition group-hover:translate-x-0.5" aria-hidden="true" />
          </a>
          {second && (
            <a href={second.url} class="btn group bg-white/10 px-6 py-3 text-base text-white ring-1 ring-white/20 hover:bg-white/15">
              {second.label}
              {second.external
                ? <ArrowUpRight size={18} class="transition group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true" />
                : <ArrowRight size={18} class="transition group-hover:translate-x-0.5" aria-hidden="true" />}
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
</section>
