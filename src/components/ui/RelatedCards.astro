---
// The one related-links card grid ("Explore {Name} →"). Snap rail below sm.
// Usage: <RelatedCards items={relatedFrom(['crm'], ['crm-development'])} />
//        <RelatedCards groups={[{ label: 'Products', items: relatedFrom(c.products) }, { label: 'Services', items: relatedFrom([], c.services) }]} />
// Build items with relatedFrom() from src/data/site.ts, or pass your own (path is a site path, e.g. '/insights/x/').
import { ArrowRight } from '@lucide/astro';
import { href, cta, type RelatedItem } from '../../data/site';
import IconBadge from './IconBadge.astro';

interface Props {
  items?: RelatedItem[];
  groups?: { label: string; items: RelatedItem[] }[];
  class?: string;
}
const { items = [], groups, class: className = '' } = Astro.props;
const sets = groups ?? [{ label: '', items }];
const Title = groups ? 'h4' : 'h3';
const lgCols = (count: number) => (count >= 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3');
const kindLabel = { product: 'Product', service: 'Service' } as const;
---

<div class={`space-y-10 ${className}`}>
  {sets.filter((s) => s.items.length > 0).map((set) => (
    <div>
      {set.label && <h3 class="mb-4 text-sm font-semibold text-ink-600">{set.label}</h3>}
      <ul class={`-mx-4 flex snap-x snap-mandatory scroll-px-4 gap-4 overflow-x-auto px-4 pb-2 sm:mx-0 sm:grid sm:grid-cols-2 sm:overflow-visible sm:px-0 sm:pb-0 ${lgCols(set.items.length)}`}>
        {set.items.map((item, i) => (
          <li class="reveal w-[82%] shrink-0 snap-start sm:w-auto" style={`--d: ${i * 80}ms`}>
            <a href={href(item.path)} class="card-link group flex h-full flex-col">
              <div class="flex items-start justify-between gap-3">
                <IconBadge icon={item.icon} tone={item.kind === 'product' ? 'saffron' : 'brand'} />
                <span class="rounded-full bg-ink-50 px-2.5 py-1 text-[11px] font-semibold text-ink-600 ring-1 ring-ink-100">{kindLabel[item.kind]}</span>
              </div>
              <Title class="mt-5 text-lg font-bold">{item.title}</Title>
              <p class="mt-2 flex-1 text-[0.95rem] leading-relaxed text-ink-600">{item.blurb}</p>
              <span class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-brand-700">
                {cta.explore(item.name ?? item.title)}<ArrowRight size={16} class="transition group-hover:translate-x-0.5" aria-hidden="true" />
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>
