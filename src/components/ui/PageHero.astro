---
// Dark hero for inner pages. Slots: "actions" (buttons under intro), "aside" (visual on the right).
// The eyebrow only shows when there are no breadcrumbs (it would repeat the last crumb).
// `status` renders a small chip above the H1, e.g. status={productStatus}.
// H1 and intro are not .reveal: they're the LCP element and must paint without waiting for JS.
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  eyebrow?: string;
  title: string;
  /** At most 3 words. */
  highlight?: string;
  intro?: string;
  breadcrumbs?: { label: string; path?: string }[];
  status?: string;
}
const { eyebrow, title, highlight, intro, breadcrumbs = [], status } = Astro.props;
const hasAside = Astro.slots.has('aside');
const showEyebrow = eyebrow && breadcrumbs.length === 0;
const [before, after] = highlight && title.includes(highlight) ? title.split(highlight) : [title, undefined];
---

<section class="relative overflow-hidden bg-ink-950 text-white">
  <div class="bg-grid mask-fade-y pointer-events-none absolute inset-0"></div>
  <div class="animate-glow pointer-events-none absolute -top-48 -right-40 h-[38rem] w-[38rem] rounded-full bg-brand-600/35 blur-3xl"></div>
  <div class="animate-glow pointer-events-none absolute -bottom-56 -left-32 h-[30rem] w-[30rem] rounded-full bg-saffron-500/15 blur-3xl [animation-delay:-4s]"></div>

  <div class={`container-page relative grid gap-12 py-12 sm:py-20 lg:py-28 ${hasAside ? 'lg:grid-cols-[1.1fr_1fr] lg:items-center' : ''}`}>
    <div class="max-w-3xl">
      {breadcrumbs.length > 0 && <Breadcrumbs items={breadcrumbs} class="mb-4 -mt-2" />}
      {(showEyebrow || status) && (
        <div class="mb-5 flex flex-wrap gap-2">
          {showEyebrow && (
            <span class="eyebrow-pill"><span class="h-1.5 w-1.5 rounded-full bg-saffron-500" aria-hidden="true"></span>{eyebrow}</span>
          )}
          {status && (
            <p class="inline-flex items-center gap-2 rounded-full bg-brand-500/15 px-3 py-1 text-xs font-semibold text-brand-100 ring-1 ring-brand-400/30">
              <span class="h-1.5 w-1.5 rounded-full bg-brand-300" aria-hidden="true"></span>{status}
            </p>
          )}
        </div>
      )}
      <h1 class="text-4xl leading-[1.08] font-extrabold text-white sm:text-5xl lg:text-6xl">
        {before}{after !== undefined && <span class="text-gradient-saffron">{highlight}</span>}{after}
      </h1>
      {intro && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-300">{intro}</p>}
      {Astro.slots.has('actions') && (
        <div class="reveal mt-9 grid gap-3 sm:flex sm:flex-wrap [&>a]:w-full sm:[&>a]:w-auto" style="--d: 120ms"><slot name="actions" /></div>
      )}
    </div>
    {hasAside && <div class="reveal" style="--d: 200ms"><slot name="aside" /></div>}
  </div>
</section>
