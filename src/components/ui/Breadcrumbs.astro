---
// Breadcrumb trail. "Home" is added first; the last item (no path) is the current page.
// Usage: <Breadcrumbs items={[{ label: 'Services', path: '/services/' }, { label: 'CRM Development' }]} />
// Pass the same array to breadcrumbList() in src/data/schema.ts.
import { href } from '../../data/site';

interface Props {
  items: { label: string; path?: string }[];
  class?: string;
}
const { items, class: className = '' } = Astro.props;
const trail = [{ label: 'Home', path: '/' }, ...items];
---

<nav aria-label="Breadcrumb" class={className}>
  <ol class="flex flex-wrap items-center gap-x-2 text-sm">
    {trail.map((c, i) => {
      const last = i === trail.length - 1;
      return (
        <li class="flex items-center gap-x-2">
          {i > 0 && <span aria-hidden="true" class="text-ink-500">/</span>}
          {last || !c.path
            ? <span aria-current={last ? 'page' : undefined} class="inline-block py-2 text-ink-200">{c.label}</span>
            : <a href={href(c.path)} class="inline-block py-2 text-ink-400 transition hover:text-white">{c.label}</a>}
        </li>
      );
    })}
  </ol>
</nav>
