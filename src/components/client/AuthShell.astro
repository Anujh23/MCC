---
// Frame for the client pages (/clientlogin/*, /client/): dark band with the title, white card below.
// Same shape as the contact page. `wide` (dashboard): a wider column where the children bring their own cards.
interface Props {
  title: string;
  /** Hide the h1 until a script fills it in (removes `invisible` from [data-title]). */
  pending?: boolean;
  wide?: boolean;
}
const { title, pending = false, wide = false } = Astro.props;
---

<div class="flex min-h-[calc(100dvh-4rem)] flex-col">
  <section class="relative overflow-hidden bg-ink-950 text-white">
    <div class="bg-grid mask-fade-y pointer-events-none absolute inset-0"></div>
    <div class="pointer-events-none absolute -top-40 -right-32 h-96 w-96 rounded-full bg-brand-600/30 blur-3xl"></div>
    <div class="container-page relative pt-10 pb-20 sm:pt-14 sm:pb-24">
      <div class:list={wide ? 'mx-auto max-w-5xl' : 'text-center'}>
        <h1 data-title class:list={['text-3xl leading-tight font-extrabold text-white sm:text-4xl', pending && 'invisible']}>{title}</h1>
        <slot name="band" />
      </div>
    </div>
  </section>

  <section class="flex-1 bg-ink-50 pb-12 lg:pb-16">
    <div class="container-page">
      <div
        class:list={[
          'relative mx-auto -mt-12',
          wide ? 'max-w-5xl' : 'max-w-md rounded-3xl bg-white p-5 shadow-xl shadow-ink-900/[0.06] ring-1 ring-ink-100 sm:p-8',
        ]}
      >
        <slot />
      </div>
    </div>
  </section>
</div>
