---
// Frame for the login pages (/clientlogin/*): dark band with the title, a white card below.
// The logged-in pages use AppShell instead.
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<div class="flex min-h-[calc(100dvh-4rem)] flex-col">
  <section class="relative overflow-hidden bg-ink-950 text-white">
    <div class="bg-grid mask-fade-y pointer-events-none absolute inset-0"></div>
    <div class="pointer-events-none absolute -top-40 -right-32 h-96 w-96 rounded-full bg-brand-600/30 blur-3xl"></div>
    <div class="container-page relative pt-10 pb-20 text-center sm:pt-14 sm:pb-24">
      <h1 class="text-3xl leading-tight font-extrabold text-white sm:text-4xl">{title}</h1>
    </div>
  </section>

  <section class="flex-1 bg-ink-50 pb-12 lg:pb-16">
    <div class="container-page">
      <div class="relative mx-auto -mt-12 max-w-md rounded-xs border border-ink-200 bg-white p-5 shadow-lg shadow-ink-900/[0.04] sm:p-8">
        <slot />
      </div>
    </div>
  </section>
</div>
