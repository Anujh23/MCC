---
// Form body for the client pages: fields (default slot), the API error line, the submit button,
// then slot="after" for a single secondary link. Wire it up with handleForm() from src/scripts/client-api.ts.
import { LoaderCircle } from '@lucide/astro';
import { ui } from './ui';

interface Props {
  id: string;
  submit: string;
  [data: `data-${string}`]: string;
}
const { id, submit, ...data } = Astro.props;
---

<form {id} {...data} class="grid gap-5" novalidate>
  <slot />
  <p data-error role="alert" class={ui.error}></p>
  <button type="submit" class={`group ${ui.primary} min-h-11 w-full`}>
    <LoaderCircle size={17} class="hidden animate-spin group-disabled:block" aria-hidden="true" />
    {submit}
  </button>
  <slot name="after" />
</form>
