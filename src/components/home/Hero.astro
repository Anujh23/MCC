---
import { ArrowRight, MapPin, KeyRound, ClipboardList, LifeBuoy } from '@lucide/astro';
import { href, contactHref, cta, products } from '../../data/site';
import MockBsa from './MockBsa.astro';
import MockPayslip from './MockPayslip.astro';
import MockCrm from './MockCrm.astro';

const trust = [
  { icon: MapPin, title: 'Built in India', text: 'Support in IST hours' },
  { icon: KeyRound, title: 'You own the code', text: 'For custom builds' },
  { icon: ClipboardList, title: 'Written scope', text: 'Quoted in ₹, GST separate' },
  { icon: LifeBuoy, title: 'Support after go-live', text: 'Bug fixes, then AMC' },
];
---

<section class="relative overflow-hidden bg-ink-950 text-white">
  <div class="bg-grid mask-fade-y pointer-events-none absolute inset-0"></div>
  <div class="animate-glow pointer-events-none absolute -top-56 right-[-12rem] h-[44rem] w-[44rem] rounded-full bg-brand-600/35 blur-3xl"></div>
  <div class="animate-glow pointer-events-none absolute -bottom-64 -left-40 h-[32rem] w-[32rem] rounded-full bg-saffron-500/15 blur-3xl [animation-delay:-4s]"></div>

  <div class="container-page relative grid items-center gap-14 pt-10 pb-12 sm:pt-20 sm:pb-14 lg:grid-cols-[1.05fr_1fr] lg:gap-10 lg:pt-24 lg:pb-20">
    <!-- Copy -->
    <div>
      <span class="eyebrow-pill">
        <span class="h-1.5 w-1.5 rounded-full bg-saffron-500" aria-hidden="true"></span>Software &amp; lending tools · Built in India
      </span>
      <h1 class="mt-5 text-[2.6rem] leading-[1.04] font-extrabold tracking-[-0.03em] text-white sm:mt-6 sm:text-6xl lg:text-[4.25rem]">
        We build the software your business <span class="text-gradient-saffron">runs on.</span>
      </h1>
      <p class="mt-5 max-w-xl text-base leading-relaxed text-ink-300 sm:mt-6 sm:text-lg">
        Lending tools like bank statement analysis and payslip checks, plus the CRMs, HR systems and websites around them. One team from the first call to go-live, and after.
      </p>
      <div class="reveal mt-8 grid gap-3 sm:mt-9 sm:flex sm:flex-wrap [&>a]:w-full sm:[&>a]:w-auto" style="--d: 120ms">
        <a href={contactHref()} class="btn btn-primary group px-6 py-3 text-base">
          {cta.call}<ArrowRight size={18} class="transition group-hover:translate-x-0.5" aria-hidden="true" />
        </a>
        <a href={href('/products/')} class="btn bg-white/10 px-6 py-3 text-base text-white ring-1 ring-white/20 hover:bg-white/15">Explore products</a>
      </div>
      <p class="reveal mt-4 text-sm text-ink-400" style="--d: 160ms">Free 30-minute call with an engineer. No sales script.</p>

      <!-- Trust strip, mobile: straight under the CTAs (the collage is hidden below sm) -->
      <ul class="mt-6 grid grid-cols-2 gap-x-4 gap-y-3 border-t border-white/10 pt-5 sm:hidden">
        {trust.map((t) => (
          <li class="flex items-start gap-2.5">
            <span class="mt-0.5 text-saffron-400" aria-hidden="true"><t.icon size={16} stroke-width={1.9} /></span>
            <span class="min-w-0 text-[13px] leading-snug">
              <span class="block font-semibold text-white">{t.title}</span>
              <span class="block text-ink-400">{t.text}</span>
            </span>
          </li>
        ))}
      </ul>

      <div class="reveal mt-6 border-t border-white/10 pt-5 sm:mt-10 sm:pt-6" style="--d: 200ms">
        <p class="text-xs font-semibold tracking-wider text-ink-400 uppercase">Our products</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {products.map((p) => (
            <li>
              <a href={href(`/products/${p.slug}/`)} class="inline-flex min-h-11 items-center gap-1.5 rounded-full bg-white/[0.05] px-3.5 text-[13px] font-medium text-ink-200 ring-1 ring-white/10 transition hover:bg-white/10 hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-300">
                <p.icon size={14} stroke-width={2} class="text-saffron-400" aria-hidden="true" />{p.short ?? p.title}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Product UI composition (sm and up) -->
    <div class="reveal relative mx-auto hidden w-full max-w-[34rem] sm:block xl:mx-0 xl:max-w-none" style="--d: 200ms">
      <div class="pointer-events-none absolute inset-x-6 top-10 bottom-10 rounded-full bg-brand-500/25 blur-3xl"></div>

      <div class="relative xl:h-[37rem]">
        <!-- BSA: main window -->
        <div class="relative z-10 xl:absolute xl:top-28 xl:left-0 xl:w-[24rem]">
          <MockBsa />
        </div>

        <!-- CRM: top right (desktop only) -->
        <div class="absolute -top-4 -right-8 z-20 hidden w-48 xl:block">
          <MockCrm mini />
        </div>

        <!-- Payslip: bottom right -->
        <div class="relative z-30 -mt-16 -mr-4 ml-auto w-[80%] max-w-[17rem] xl:absolute xl:-right-8 xl:-bottom-10 xl:mt-0 xl:mr-0 xl:w-[15.5rem]">
          <MockPayslip />
        </div>
      </div>
    </div>
  </div>

  <!-- Trust strip (sm and up) -->
  <div class="relative hidden border-t border-white/10 bg-white/[0.02] sm:block">
    <ul class="container-page grid grid-cols-2 lg:grid-cols-4">
      {trust.map((t, i) => (
        <li class={`reveal flex items-center gap-3 py-6 ${i % 2 ? 'border-l border-white/10 pl-6' : 'pr-2'} ${i > 1 ? 'border-t border-white/10 lg:border-t-0' : ''} ${i === 2 ? 'lg:border-l lg:pl-6' : ''}`} style={`--d: ${i * 80}ms`}>
          <span class="grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-white/[0.06] text-saffron-400 ring-1 ring-white/10" aria-hidden="true">
            <t.icon size={17} stroke-width={1.9} />
          </span>
          <span class="min-w-0">
            <span class="block text-sm font-semibold text-white">{t.title}</span>
            <span class="block text-xs text-ink-400">{t.text}</span>
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>
