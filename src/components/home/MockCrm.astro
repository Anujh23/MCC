---
// CRM pipeline mockup. `full` = kanban board, otherwise compact funnel card. Sample data only.
import { SquareKanban, Clock } from '@lucide/astro';
interface Props { class?: string; full?: boolean; mini?: boolean }
import SampleBadge from '../ui/SampleBadge.astro';
const { class: className = '', full = false, mini = false } = Astro.props;

const funnel = [
  { s: 'New leads', n: 24, w: 100 },
  { s: 'Contacted', n: 16, w: 68 },
  { s: 'Docs collected', n: 9, w: 42 },
  { s: 'Sanctioned', n: 5, w: 24 },
];

const board = [
  { s: 'New', n: 24, cards: [{ i: 'RM', name: 'R. Mehta', amt: '₹3.5 L', tag: 'Website' }, { i: 'PK', name: 'P. Kaur', amt: '₹1.2 L', tag: 'Walk-in' }] },
  { s: 'Contacted', n: 16, cards: [{ i: 'AS', name: 'A. Shaikh', amt: '₹8.0 L', tag: 'Call at 4:30' }, { i: 'VN', name: 'V. Nair', amt: '₹2.4 L', tag: 'Referral' }] },
  { s: 'Docs', n: 9, cards: [{ i: 'SG', name: 'S. Gupta', amt: '₹5.0 L', tag: 'KYC pending' }] },
  { s: 'Sanctioned', n: 5, cards: [{ i: 'DR', name: 'D. Rao', amt: '₹12 L', tag: 'Disburse Fri' }] },
];
---

{full ? (
  <div class={`overflow-hidden rounded-2xl bg-white text-left shadow-2xl shadow-ink-950/30 ring-1 ring-ink-900/5 ${className}`} aria-hidden="true">
    <div class="flex items-center gap-2 border-b border-ink-100 px-4 py-3">
      <span class="grid h-7 w-7 place-items-center rounded-lg bg-brand-50 text-brand-600 ring-1 ring-brand-100"><SquareKanban size={14} stroke-width={2} /></span>
      <p class="text-xs font-semibold text-ink-900">Loan pipeline</p>
      <SampleBadge class="ml-auto" />
    </div>
    <div class="grid grid-cols-2 gap-2 bg-ink-50/70 p-3">
      {board.map((col) => (
        <div class="min-w-0 rounded-xl bg-ink-100/60 p-2">
          <div class="flex items-center justify-between px-1 pb-2">
            <span class="text-[10px] font-bold tracking-wide whitespace-nowrap text-ink-600 uppercase">{col.s}</span>
            <span class="rounded-full bg-white px-1.5 text-[10px] font-semibold text-ink-500 tabular-nums">{col.n}</span>
          </div>
          <div class="space-y-1.5">
            {col.cards.map((c) => (
              <div class="rounded-lg bg-white p-2 shadow-sm ring-1 ring-ink-900/5">
                <div class="flex items-center gap-1.5">
                  <span class="grid h-5 w-5 shrink-0 place-items-center rounded-full bg-brand-600 text-[8px] font-bold text-white">{c.i}</span>
                  <span class="text-[11px] font-semibold whitespace-nowrap text-ink-900">{c.name}</span>
                </div>
                <div class="mt-1.5 flex flex-wrap items-center justify-between gap-1">
                  <span class="text-[11px] font-bold whitespace-nowrap text-ink-700 tabular-nums">{c.amt}</span>
                  <span class="rounded bg-ink-50 px-1 text-[10px] whitespace-nowrap text-ink-600">{c.tag}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
) : (
  <div class={`overflow-hidden rounded-2xl bg-white text-left shadow-2xl shadow-ink-950/30 ring-1 ring-ink-900/5 ${className}`} aria-hidden="true">
    <div class="flex items-center gap-2 px-4 pt-3.5">
      <span class="grid h-7 w-7 place-items-center rounded-lg bg-brand-50 text-brand-600 ring-1 ring-brand-100"><SquareKanban size={14} stroke-width={2} /></span>
      <div class="min-w-0">
        <p class="text-xs font-semibold text-ink-900">Pipeline · this week</p>
        <SampleBadge class="mt-1" />
      </div>
    </div>
    <div class="space-y-2 px-4 pt-3">
      {funnel.map((f, i) => (
        <div>
          <div class="flex justify-between text-[10px]"><span class="text-ink-500">{f.s}</span><span class="font-bold text-ink-900 tabular-nums">{f.n}</span></div>
          <div class="mt-0.5 h-1.5 rounded-full bg-ink-100">
            <div class={`h-full rounded-full ${i === 3 ? 'bg-emerald-500' : 'bg-brand-500'}`} style={`width: ${f.w}%`}></div>
          </div>
        </div>
      ))}
    </div>
    {mini ? <div class="h-3.5"></div> : <div class="m-3 mt-3.5 flex items-center gap-2 rounded-xl bg-ink-50 p-2.5 ring-1 ring-ink-100">
      <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-brand-600 text-[10px] font-bold text-white">RM</span>
      <div class="min-w-0">
        <p class="text-[11px] font-semibold text-ink-900">Follow up: R. Mehta</p>
        <p class="flex items-center gap-1 text-[10px] text-ink-500"><Clock size={10} />Today, 4:30 pm</p>
      </div>
    </div>}
  </div>
)}
