---
// Payslip Checker result card, drawn in HTML. Sample data only.
import { FileCheck, CircleCheck } from '@lucide/astro';
interface Props { class?: string; full?: boolean }
import SampleBadge from '../ui/SampleBadge.astro';
const { class: className = '', full = false } = Astro.props;

const checks = [
  'Gross − deductions = net pay',
  'Net pay matches bank credit',
  'Employer name & PAN consistent',
  'No edits found in PDF layers',
];
const shown = full ? checks : checks.slice(0, 3);
---

<div class={`overflow-hidden rounded-2xl bg-white text-left shadow-2xl shadow-ink-950/30 ring-1 ring-ink-900/5 ${className}`} aria-hidden="true">
  <div class="flex items-center gap-2.5 border-b border-ink-100 px-4 py-3">
    <span class="grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-brand-50 text-brand-600 ring-1 ring-brand-100">
      <FileCheck size={16} stroke-width={2} />
    </span>
    <div class="min-w-0">
      <p class="text-xs font-semibold text-ink-900">Payslip Checker</p>
      <p class="text-[10px] text-ink-500">Sep 2026 · PDF</p>
    </div>
    <span class="ml-auto inline-flex shrink-0 items-center gap-1 rounded-full bg-emerald-50 px-2 py-0.5 text-[10px] font-bold text-emerald-700 ring-1 ring-emerald-200">
      <CircleCheck size={11} stroke-width={2.5} />Verified
    </span>
  </div>

  <div class="px-4 pt-3 pb-4">
    <div class="flex items-start justify-between gap-3">
      <div>
        <p class="text-[10px] font-medium tracking-wide text-ink-500 uppercase">Net pay</p>
        <p class="text-xl font-extrabold text-ink-900 tabular-nums">₹68,450</p>
        <p class="text-[10px] text-ink-500">Credited 01 Oct 2026</p>
      </div>
      <SampleBadge />
    </div>

    {full && (
      <div class="mt-3 grid grid-cols-3 gap-2 text-[10px]">
        <div class="rounded-lg bg-ink-50 p-2"><p class="text-ink-500">Gross</p><p class="font-bold text-ink-900 tabular-nums">₹82,000</p></div>
        <div class="rounded-lg bg-ink-50 p-2"><p class="text-ink-500">PF + PT</p><p class="font-bold text-ink-900 tabular-nums">₹6,050</p></div>
        <div class="rounded-lg bg-ink-50 p-2"><p class="text-ink-500">TDS</p><p class="font-bold text-ink-900 tabular-nums">₹7,500</p></div>
      </div>
    )}

    <ul class="mt-3 space-y-1.5">
      {shown.map((c) => (
        <li class="flex items-center gap-2 text-[11px] text-ink-600">
          <span class="text-emerald-600"><CircleCheck size={13} stroke-width={2.25} /></span>{c}
        </li>
      ))}
    </ul>

    <div class="mt-3.5">
      <div class="flex justify-between text-[10px] font-medium">
        <span class="text-ink-500">Authenticity score</span><span class="font-bold text-emerald-700 tabular-nums">96 / 100</span>
      </div>
      <div class="mt-1 h-1.5 overflow-hidden rounded-full bg-ink-100">
        <div class="h-full w-[96%] rounded-full bg-gradient-to-r from-emerald-500 to-emerald-400"></div>
      </div>
    </div>
  </div>
</div>
