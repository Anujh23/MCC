---
// Manka HRMS mockup: attendance grid + payroll run. Sample data only.
import { IdCard } from '@lucide/astro';
interface Props { class?: string }
import SampleBadge from '../ui/SampleBadge.astro';
const { class: className = '' } = Astro.props;

// p = present, l = leave, a = absent, w = weekly off
const people = [
  { i: 'NK', name: 'Neha K.', days: 'ppppwppplpppwp' },
  { i: 'AJ', name: 'Arjun J.', days: 'pppawppppppwpp' },
  { i: 'FS', name: 'Fatima S.', days: 'ppllwpppppppwp' },
  { i: 'RB', name: 'Rohit B.', days: 'pppppwpppappwp' },
];
const tone: Record<string, string> = {
  p: 'bg-emerald-400/80',
  l: 'bg-brand-300',
  a: 'bg-rose-400',
  w: 'bg-ink-100',
};
---

<div class={`overflow-hidden rounded-2xl bg-white text-left shadow-2xl shadow-ink-950/30 ring-1 ring-ink-900/5 ${className}`} aria-hidden="true">
  <div class="flex items-center gap-2 border-b border-ink-100 px-4 py-3">
    <span class="grid h-7 w-7 place-items-center rounded-lg bg-brand-50 text-brand-600 ring-1 ring-brand-100"><IdCard size={14} stroke-width={2} /></span>
    <p class="text-xs font-semibold text-ink-900">Manka HRMS · October 2026</p>
    <SampleBadge class="ml-auto" />
  </div>

  <div class="p-4">
    <div class="grid grid-cols-3 gap-2">
      <div class="rounded-xl bg-ink-50 p-2.5"><p class="text-[10px] text-ink-500">Headcount</p><p class="text-base font-extrabold text-ink-900 tabular-nums">142</p></div>
      <div class="rounded-xl bg-emerald-50 p-2.5"><p class="text-[10px] text-emerald-700/80">Present today</p><p class="text-base font-extrabold text-emerald-700 tabular-nums">131</p></div>
      <div class="rounded-xl bg-brand-50 p-2.5"><p class="text-[10px] text-brand-700/80">On leave</p><p class="text-base font-extrabold text-brand-700 tabular-nums">7</p></div>
    </div>

    <div class="mt-4">
      <div class="flex items-center justify-between">
        <p class="text-[11px] font-semibold text-ink-700">Attendance · last 14 days</p>
        <div class="hidden items-center gap-2 text-[10px] text-ink-500 sm:flex">
          <span class="flex items-center gap-1"><span class="h-2 w-2 rounded-sm bg-emerald-400/80"></span>Present</span>
          <span class="flex items-center gap-1"><span class="h-2 w-2 rounded-sm bg-brand-300"></span>Leave</span>
          <span class="flex items-center gap-1"><span class="h-2 w-2 rounded-sm bg-rose-400"></span>Absent</span>
        </div>
      </div>
      <div class="mt-2 space-y-1.5">
        {people.map((p) => (
          <div class="flex items-center gap-2">
            <span class="grid h-5 w-5 shrink-0 place-items-center rounded-full bg-ink-800 text-[8px] font-bold text-white">{p.i}</span>
            <span class="w-14 shrink-0 text-[10px] whitespace-nowrap text-ink-600">{p.name}</span>
            <div class="grid flex-1 grid-cols-[repeat(14,minmax(0,1fr))] gap-[3px]">
              {p.days.split('').map((d) => <span class={`h-3 rounded-[3px] ${tone[d]}`}></span>)}
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-4 flex items-center justify-between gap-3 rounded-xl bg-ink-900 p-3 text-white">
      <div class="min-w-0">
        <p class="text-[10px] text-ink-300">Payroll run · Oct 2026</p>
        <p class="text-sm font-bold tabular-nums">₹48.6 L <span class="text-[10px] font-medium text-ink-400">· PF, ESI, PT, TDS computed</span></p>
      </div>
      <span class="shrink-0 rounded-full bg-brand-600 px-2.5 py-1 text-[10px] font-semibold">Approve</span>
    </div>
  </div>
</div>
