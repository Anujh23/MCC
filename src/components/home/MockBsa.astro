---
// BSA (Bank Statement Analyser) UI mockup, drawn in HTML. Sample data only.
interface Props { class?: string }
import SampleBadge from '../ui/SampleBadge.astro';
const { class: className = '' } = Astro.props;

const months = [
  { m: 'Apr', cr: 62, dr: 48 },
  { m: 'May', cr: 74, dr: 55 },
  { m: 'Jun', cr: 58, dr: 61 },
  { m: 'Jul', cr: 88, dr: 64 },
  { m: 'Aug', cr: 80, dr: 59 },
  { m: 'Sep', cr: 96, dr: 70 },
];
---

<div class={`overflow-hidden rounded-2xl bg-ink-900/95 text-left shadow-2xl shadow-black/50 ring-1 ring-white/10 ${className}`} aria-hidden="true">
  <div class="flex items-center gap-1.5 border-b border-white/10 px-4 py-2.5">
    <span class="h-2 w-2 rounded-full bg-white/15 max-sm:hidden"></span>
    <span class="h-2 w-2 rounded-full bg-white/15 max-sm:hidden"></span>
    <span class="h-2 w-2 rounded-full bg-white/15 max-sm:hidden"></span>
    <span class="min-w-0 text-[11px] leading-tight font-medium text-ink-300 sm:ml-2">BSA · Statement analysis</span>
    <SampleBadge tone="dark" class="ml-auto" />
  </div>

  <div class="p-4 sm:p-5">
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0">
        <p class="text-sm font-semibold text-white">Sample Traders Pvt Ltd</p>
        <p class="mt-0.5 text-[11px] text-ink-400">Current a/c ••4821 · Apr–Sep 2026</p>
      </div>
      <span class="inline-flex shrink-0 items-center gap-1 rounded-full bg-emerald-400/10 px-2 py-0.5 text-[10px] font-semibold text-emerald-300 ring-1 ring-emerald-400/20">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span>1,284 txns parsed
      </span>
    </div>

    <div class="mt-4 grid grid-cols-3 gap-2">
      <div class="rounded-xl bg-white/[0.04] p-2.5 ring-1 ring-white/10">
        <p class="text-[10px] text-ink-400">Avg bank balance</p>
        <p class="mt-1 text-sm font-bold text-white tabular-nums sm:text-base">₹4.82 L</p>
        <p class="text-[10px] font-medium text-emerald-300">▲ 6.1% QoQ</p>
      </div>
      <div class="rounded-xl bg-white/[0.04] p-2.5 ring-1 ring-white/10">
        <p class="text-[10px] text-ink-400">Monthly credits</p>
        <p class="mt-1 text-sm font-bold text-white tabular-nums sm:text-base">₹11.6 L</p>
        <p class="text-[10px] text-ink-400">avg, 6 months</p>
      </div>
      <div class="rounded-xl bg-rose-500/10 p-2.5 ring-1 ring-rose-400/20">
        <p class="text-[10px] text-rose-200/80">Bounces</p>
        <p class="mt-1 text-sm font-bold text-rose-300 tabular-nums sm:text-base">2</p>
        <p class="text-[10px] text-rose-200/70">inward, Jun &amp; Jul</p>
      </div>
    </div>

    <div class="mt-4 rounded-xl bg-white/[0.03] p-3 ring-1 ring-white/10">
      <div class="flex items-center justify-between">
        <p class="text-[11px] font-semibold text-ink-200">Cash flow</p>
        <div class="flex items-center gap-3 text-[10px] text-ink-400">
          <span class="flex items-center gap-1"><span class="h-2 w-2 rounded-sm bg-brand-400"></span>Credits</span>
          <span class="flex items-center gap-1"><span class="h-2 w-2 rounded-sm bg-white/25"></span>Debits</span>
        </div>
      </div>
      <div class="mt-3 flex h-24 items-end gap-2 border-b border-white/10 sm:h-28">
        {months.map((x, i) => (
          <div class="flex h-full flex-1 items-end justify-center gap-0.5">
            <span class="animate-bar w-full max-w-3 rounded-t-[3px] bg-gradient-to-t from-brand-600 to-brand-400" style={`--h: ${x.cr}%; animation-delay: ${i * 90}ms`}></span>
            <span class="animate-bar w-full max-w-3 rounded-t-[3px] bg-white/20" style={`--h: ${x.dr}%; animation-delay: ${i * 90 + 45}ms`}></span>
          </div>
        ))}
      </div>
      <div class="mt-1.5 flex gap-2">
        {months.map((x) => <span class="flex-1 text-center text-[10px] text-ink-500">{x.m}</span>)}
      </div>
    </div>

    <div class="mt-3 flex flex-wrap gap-1.5 text-[10px] font-medium">
      <span class="rounded-md bg-white/[0.06] px-2 py-1 text-ink-200 ring-1 ring-white/10">EMI outflow ₹38,500/mo</span>
      <span class="rounded-md bg-white/[0.06] px-2 py-1 text-ink-200 ring-1 ring-white/10">Cash deposits 4%</span>
      <span class="rounded-md bg-amber-400/10 px-2 py-1 text-amber-300 ring-1 ring-amber-400/25">1 circular txn flagged</span>
    </div>
  </div>
</div>
