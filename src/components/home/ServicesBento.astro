---
import { ArrowRight } from '@lucide/astro';
import Section from '../ui/Section.astro';
import IconBadge from '../ui/IconBadge.astro';
import SampleBadge from '../ui/SampleBadge.astro';
import { services, href } from '../../data/site';

const bySlug = Object.fromEntries(services.map((s) => [s.slug, s]));
const featured = bySlug['data-analytics'];
const rest = ['crm-development', 'website-development', 'hr-solutions', 'custom-software'].map((s) => bySlug[s]);
// grid spans for the four smaller tiles (lg: 6 columns)
const spans = ['lg:col-span-2', 'lg:col-span-2', 'lg:col-span-3', 'lg:col-span-3'];

const mis = [38, 46, 41, 55, 52, 63, 70, 66, 78, 84];
const pts = mis.map((v, i) => `${(i / (mis.length - 1)) * 300},${100 - v}`).join(' ');
---

<Section
  title="Five services, one team that knows lending."
  highlight="knows lending."
  class="max-sm:py-14"
>
  <!-- Below sm: one row per service -->
  <ul class="reveal -mt-4 divide-y divide-ink-100 border-y border-ink-100 sm:hidden">
    {[featured, ...rest].map((s) => (
      <li>
        <a href={href(`/services/${s.slug}/`)} class="group flex items-center gap-3.5 py-3 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500">
          <IconBadge icon={s.icon} />
          <span class="min-w-0 flex-1 font-bold text-ink-900">{s.title}</span>
          <ArrowRight size={18} class="shrink-0 text-ink-500 transition group-hover:translate-x-0.5 group-hover:text-brand-700" aria-hidden="true" />
        </a>
      </li>
    ))}
  </ul>

  <div class="hidden gap-4 sm:grid sm:grid-cols-2 lg:grid-cols-6">
    <!-- Featured tile -->
    <a
      href={href(`/services/${featured.slug}/`)}
      class="reveal group relative overflow-hidden rounded-3xl bg-ink-950 p-6 text-white ring-1 ring-ink-900 transition duration-300 ease-out-expo hover:-translate-y-1 hover:shadow-2xl hover:shadow-brand-900/30 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500 sm:col-span-2 sm:p-8 lg:col-span-4 lg:row-span-2"
    >
      <div class="bg-grid mask-fade-y pointer-events-none absolute inset-0 opacity-70"></div>
      <div class="animate-glow pointer-events-none absolute -top-24 -right-24 h-72 w-72 rounded-full bg-brand-600/40 blur-3xl"></div>
      <div class="relative flex h-full flex-col gap-8 lg:flex-row lg:items-stretch">
        <div class="flex flex-col lg:w-[44%]">
          <IconBadge icon={featured.icon} tone="dark" size="lg" />
          <h3 class="mt-6 text-2xl font-extrabold text-white sm:text-3xl">{featured.title}</h3>
          <p class="mt-3 leading-relaxed text-ink-300">{featured.blurb}</p>
          <span class="mt-auto pt-8" aria-hidden="true">
            <span class="grid h-10 w-10 place-items-center rounded-full text-ink-300 ring-1 ring-white/20 transition group-hover:bg-brand-600 group-hover:text-white group-hover:ring-brand-600"><ArrowRight size={18} /></span>
          </span>
        </div>

        <!-- Mini MIS dashboard -->
        <div class="flex-1 rounded-2xl bg-white/[0.04] p-4 ring-1 ring-white/10 backdrop-blur" aria-hidden="true">
          <div class="flex items-center justify-between">
            <p class="text-xs font-semibold text-ink-200">Monthly MIS · disbursals</p>
            <SampleBadge tone="dark" />
          </div>
          <div class="mt-4 grid grid-cols-2 gap-2">
            <div class="rounded-xl bg-white/[0.04] p-3 ring-1 ring-white/10">
              <p class="text-[10px] text-ink-400">Disbursed (MTD)</p>
              <p class="mt-1 text-lg font-extrabold tabular-nums">₹2.14 Cr</p>
            </div>
            <div class="rounded-xl bg-white/[0.04] p-3 ring-1 ring-white/10">
              <p class="text-[10px] text-ink-400">Collection efficiency</p>
              <p class="mt-1 text-lg font-extrabold tabular-nums">97.2%</p>
            </div>
          </div>
          <div class="mt-4 rounded-xl bg-white/[0.03] p-3 ring-1 ring-white/10">
            <svg viewBox="0 0 300 100" class="h-28 w-full overflow-visible" preserveAspectRatio="none">
              <defs>
                <linearGradient id="mis-fill" x1="0" x2="0" y1="0" y2="1">
                  <stop offset="0" stop-color="var(--color-brand-400)" stop-opacity="0.45" />
                  <stop offset="1" stop-color="var(--color-brand-400)" stop-opacity="0" />
                </linearGradient>
              </defs>
              {[25, 50, 75].map((y) => <line x1="0" x2="300" y1={y} y2={y} stroke="rgb(255 255 255 / 0.07)" />)}
              <polygon points={`0,100 ${pts} 300,100`} fill="url(#mis-fill)" />
              <polyline points={pts} fill="none" stroke="var(--color-brand-300)" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" vector-effect="non-scaling-stroke" />
            </svg>
            <div class="mt-2 flex justify-between text-[10px] text-ink-500">
              <span>Jan</span><span>Mar</span><span>May</span><span>Jul</span><span>Oct</span>
            </div>
          </div>
        </div>
      </div>
    </a>

    {rest.map((s, i) => (
      <a href={href(`/services/${s.slug}/`)} class={`reveal card-link group flex flex-col ${spans[i]}`} style={`--d: ${(i + 1) * 80}ms`}>
        <div class="flex items-start justify-between">
          <IconBadge icon={s.icon} />
          <span class="grid h-8 w-8 place-items-center rounded-full text-ink-500 ring-1 ring-ink-200 transition group-hover:bg-brand-600 group-hover:text-white group-hover:ring-brand-600" aria-hidden="true">
            <ArrowRight size={16} />
          </span>
        </div>
        <h3 class="mt-5 text-lg font-bold">{s.title}</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink-600">{s.blurb}</p>
      </a>
    ))}
  </div>
</Section>
