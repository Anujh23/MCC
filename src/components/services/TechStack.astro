---
// Grouped tech pills. Muted cards from sm; plain labelled rows below sm.
interface Props { groups: { group: string; items: string[] }[] }
const { groups } = Astro.props;
const lgCols = groups.length === 3 ? 'lg:grid-cols-3' : 'lg:grid-cols-4';
---

<div class={`grid gap-6 sm:grid-cols-2 sm:gap-4 ${lgCols}`}>
  {groups.map((g, i) => (
    <div class="reveal sm:rounded-2xl sm:bg-ink-50 sm:p-5 sm:ring-1 sm:ring-ink-100" style={`--d: ${i * 80}ms`}>
      <h3 class="text-xs font-semibold tracking-wide text-ink-600 uppercase">{g.group}</h3>
      <ul class="mt-3 flex flex-wrap gap-2 sm:mt-4">
        {g.items.map((t) => (
          <li class="rounded-full bg-white px-3 py-1.5 text-sm font-medium text-ink-700 ring-1 ring-ink-200">{t}</li>
        ))}
      </ul>
    </div>
  ))}
</div>
