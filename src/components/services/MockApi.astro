---
// Hero visual for Custom Software & APIs: request / response code card (sample request).
import { Terminal } from '@lucide/astro';
import SampleBadge from '../ui/SampleBadge.astro';
const k = 'text-brand-300';
const s = 'text-saffron-400';
const n = 'text-emerald-400';
---

<div class="relative mx-auto w-full max-w-xl" aria-hidden="true">
  <div class="overflow-hidden rounded-2xl bg-ink-900/95 shadow-2xl shadow-black/50 ring-1 ring-white/10 backdrop-blur">
    <div class="flex items-center justify-between gap-3 border-b border-white/10 px-4 py-3">
      <div class="flex min-w-0 items-center gap-2 text-xs text-ink-300">
        <Terminal size={14} class="shrink-0 text-saffron-400" />
        <span class="truncate">statements.http</span>
      </div>
      <SampleBadge tone="dark" />
    </div>

    <div class="px-4 pt-4 font-mono text-[11px] leading-relaxed sm:text-xs">
      <p class="flex flex-wrap items-center gap-2">
        <span class="rounded bg-brand-600 px-1.5 py-0.5 text-[10px] font-bold text-white">POST</span>
        <span class="break-all text-white">/v1/statements/analyse</span>
      </p>
      <pre class="mt-2 break-words whitespace-pre-wrap text-ink-400">Authorization: Bearer sk_test_••••
Content-Type: multipart/form-data

<span class={k}>file</span>=statement_apr-sep.pdf
<span class={k}>policy</span>=pl_salaried_v3</pre>
    </div>

    <div class="mt-4 border-t border-white/10 bg-black/20 px-4 pt-3 pb-4 font-mono text-[11px] leading-relaxed sm:text-xs">
      <p class="flex items-center gap-2 text-[10px] font-semibold tracking-wide text-ink-400 uppercase">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-400"></span> 200 OK · application/json
      </p>
      <pre class="mt-2 break-words whitespace-pre-wrap text-ink-300">{'{'}
  <span class={k}>"months"</span>: <span class={n}>6</span>,
  <span class={k}>"abb"</span>: <span class={n}>38200</span>,
  <span class={k}>"salary_credits"</span>: <span class={n}>6</span>,
  <span class={k}>"emi_obligations"</span>: <span class={n}>12450</span>,
  <span class={k}>"bounces"</span>: {'{'} <span class={k}>"nach"</span>: <span class={n}>1</span>, <span class={k}>"cheque"</span>: <span class={n}>0</span> {'}'},
  <span class={k}>"tamper_flags"</span>: [],
  <span class={k}>"decision"</span>: <span class={s}>"refer"</span>
{'}'}</pre>
    </div>
  </div>
</div>
