---
// Hero visual for Data & Analytics: KPI tiles + monthly disbursal bars + branch table (sample data).
import { TrendingUp, TrendingDown } from '@lucide/astro';
import SampleBadge from '../ui/SampleBadge.astro';

const kpis = [
  { label: 'Disbursed MTD', value: '₹2.4 Cr', delta: '+8%', up: true },
  { label: 'Collection eff.', value: '96.2%', delta: '+0.6 pt', up: true },
  { label: '30+ DPD', value: '3.1%', delta: '−0.4 pt', up: false },
];
const months = ['Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct'];
const bars = [46, 52, 49, 61, 58, 70, 82];
const branches = [
  { name: 'Indore', pct: 92 },
  { name: 'Nagpur', pct: 78 },
  { name: 'Surat', pct: 64 },
];
---

<div class="relative mx-auto w-full max-w-xl" aria-hidden="true">
  <div class="rounded-2xl bg-ink-900/90 p-4 shadow-2xl shadow-black/50 ring-1 ring-white/10 backdrop-blur sm:p-5">
    <div class="flex items-center justify-between gap-3">
      <div class="min-w-0">
        <p class="text-sm font-semibold text-white">Leadership dashboard</p>
        <SampleBadge tone="dark" class="mt-1" />
      </div>
      <div class="flex shrink-0 gap-1 rounded-full bg-white/[0.06] p-0.5 text-[10px] font-semibold">
        <span class="rounded-full bg-white/10 px-2 py-0.5 text-white">FY 26–27</span>
        <span class="hidden px-2 py-0.5 text-ink-400 sm:inline">All branches</span>
      </div>
    </div>

    <div class="mt-4 grid grid-cols-3 gap-2 sm:gap-3">
      {kpis.map((k) => (
        <div class="min-w-0 rounded-xl bg-white/[0.05] p-2.5 ring-1 ring-white/[0.06] sm:p-3">
          <p class="text-[10px] whitespace-nowrap text-ink-400 sm:text-[11px]">{k.label}</p>
          <p class="mt-1 text-base font-extrabold text-white tabular-nums sm:text-xl">{k.value}</p>
          <p class="mt-1 flex items-center gap-1 text-[10px] font-semibold text-emerald-400">
            {k.up ? <TrendingUp size={11} /> : <TrendingDown size={11} />}{k.delta}
          </p>
        </div>
      ))}
    </div>

    <div class="mt-3 grid gap-3 sm:grid-cols-[1.6fr_1fr]">
      <div class="rounded-xl bg-white/[0.05] p-3 ring-1 ring-white/[0.06]">
        <div class="flex items-center justify-between">
          <p class="text-[11px] font-semibold text-ink-200">Disbursals by month</p>
          <span class="flex items-center gap-1 text-[10px] text-ink-400"><span class="h-1.5 w-1.5 rounded-full bg-saffron-400"></span>This month</span>
        </div>
        <div class="relative mt-3 flex h-28 items-end gap-1.5 sm:gap-2">
          <div class="pointer-events-none absolute inset-0 flex flex-col justify-between">
            <span class="border-t border-dashed border-white/[0.07]"></span>
            <span class="border-t border-dashed border-white/[0.07]"></span>
            <span class="border-t border-dashed border-white/[0.07]"></span>
          </div>
          {bars.map((h, i) => (
            <span
              class={`animate-bar relative flex-1 rounded-t-md ${i === bars.length - 1 ? 'bg-gradient-to-t from-saffron-600 to-saffron-400' : 'bg-gradient-to-t from-brand-700 to-brand-400'}`}
              style={`--h: ${h}%; animation-delay: ${200 + i * 90}ms`}
            ></span>
          ))}
        </div>
        <div class="mt-1.5 flex gap-1.5 text-center text-[10px] text-ink-400 sm:gap-2">
          {months.map((m) => <span class="flex-1">{m}</span>)}
        </div>
      </div>

      <div class="rounded-xl bg-white/[0.05] p-3 ring-1 ring-white/[0.06]">
        <p class="text-[11px] font-semibold text-ink-200">Target achieved</p>
        <ul class="mt-3 space-y-3">
          {branches.map((b) => (
            <li>
              <div class="flex justify-between text-[10px]"><span class="text-ink-300">{b.name}</span><span class="font-semibold text-white tabular-nums">{b.pct}%</span></div>
              <div class="mt-1 h-1.5 overflow-hidden rounded-full bg-white/10"><div class="h-full rounded-full bg-brand-400" style={`width: ${b.pct}%`}></div></div>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</div>
