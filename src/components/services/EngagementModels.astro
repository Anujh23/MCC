---
// Three ways to work with us. No prices, no per-card buttons (the page's closing band is the CTA).
// Below sm the cards sit in a snap rail instead of a tall stack.
import { ClipboardList, Users, LifeBuoy, Check } from '@lucide/astro';
import IconBadge from '../ui/IconBadge.astro';

const models = [
  {
    icon: ClipboardList,
    name: 'Fixed-scope project',
    points: ['One fixed price in ₹', 'Demos at every milestone', 'Handover with docs'],
  },
  {
    icon: Users,
    name: 'Dedicated team',
    points: ['Engineers who know your system', 'Monthly billing', 'Your backlog, your priorities'],
    featured: true,
  },
  {
    icon: LifeBuoy,
    name: 'Support',
    points: ['Bug fixes and security updates', 'Small changes', 'Uptime and backup checks'],
  },
];
---

<ul class="-mx-4 flex snap-x snap-mandatory scroll-px-4 gap-4 overflow-x-auto px-4 pb-2 sm:mx-0 sm:grid sm:overflow-visible sm:px-0 sm:pb-0 lg:grid-cols-3">
  {models.map((m, i) => (
    <li
      class={`reveal flex w-[85%] shrink-0 snap-start flex-col rounded-2xl p-6 ring-1 sm:w-auto sm:p-7 ${m.featured ? 'bg-ink-950 text-ink-300 ring-ink-800' : 'bg-white ring-ink-100'}`}
      style={`--d: ${i * 100}ms`}
    >
      <IconBadge icon={m.icon} tone={m.featured ? 'dark' : 'brand'} />
      <h3 class={`mt-5 text-xl font-bold ${m.featured ? 'text-white' : ''}`}>{m.name}</h3>
      <ul class="mt-6 flex-1 space-y-3">
        {m.points.map((p) => (
          <li class="flex gap-3 text-[0.95rem]">
            <Check size={18} class={`mt-0.5 shrink-0 ${m.featured ? 'text-saffron-400' : 'text-brand-600'}`} aria-hidden="true" />
            <span class={m.featured ? 'text-ink-200' : 'text-ink-600'}>{p}</span>
          </li>
        ))}
      </ul>
    </li>
  ))}
</ul>
