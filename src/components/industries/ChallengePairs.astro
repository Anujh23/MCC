---
// "Common challenges" -> "How we help": one row card per pair (side by side on lg).
import { ArrowRight } from '@lucide/astro';

interface Props { pairs: { challenge: string; help: string }[] }
const { pairs } = Astro.props;
---

<div>
  <div class="mb-3 hidden grid-cols-[1fr_auto_1.2fr] gap-6 px-6 lg:grid" aria-hidden="true">
    <p class="text-xs font-semibold tracking-wide text-ink-600 uppercase">Common challenges</p>
    <span class="w-5"></span>
    <p class="text-xs font-semibold tracking-wide text-brand-700 uppercase">How we help</p>
  </div>
  <ol class="space-y-3">
    {pairs.map((p, i) => (
      <li class="reveal grid gap-2 rounded-2xl bg-white p-5 ring-1 ring-ink-100 sm:p-6 lg:grid-cols-[1fr_auto_1.2fr] lg:items-center lg:gap-6" style={`--d: ${i * 60}ms`}>
        <div class="flex gap-3 sm:gap-4">
          <span class="w-6 shrink-0 pt-0.5 text-sm font-bold text-ink-500 tabular-nums" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <p class="leading-snug font-semibold text-ink-900 sm:text-lg"><span class="sr-only">Challenge: </span>{p.challenge}</p>
        </div>
        <ArrowRight size={20} class="hidden shrink-0 text-brand-600 lg:block" aria-hidden="true" />
        <p class="pl-9 leading-relaxed text-ink-600 sm:pl-10 lg:pl-0"><span class="sr-only">How we help: </span>{p.help}</p>
      </li>
    ))}
  </ol>
</div>
