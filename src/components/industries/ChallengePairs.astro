---
// Challenge -> how we help: one row card per pair (side by side on lg).
import { ArrowRight } from '@lucide/astro';

interface Props { pairs: { challenge: string; help: string }[] }
const { pairs } = Astro.props;
---

<ul class="space-y-3">
  {pairs.map((p, i) => (
    <li class="reveal grid gap-2 rounded-2xl bg-white p-5 ring-1 ring-ink-100 sm:p-6 lg:grid-cols-[1fr_auto_1.2fr] lg:items-center lg:gap-6" style={`--d: ${i * 60}ms`}>
      <p class="leading-snug font-semibold text-ink-900 sm:text-lg"><span class="sr-only">Challenge: </span>{p.challenge}</p>
      <ArrowRight size={20} class="hidden shrink-0 text-brand-600 lg:block" aria-hidden="true" />
      <p class="leading-relaxed text-ink-600"><span class="sr-only">How we help: </span>{p.help}</p>
    </li>
  ))}
</ul>
