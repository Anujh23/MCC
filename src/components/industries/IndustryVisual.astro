---
// Small hero card for an industry page (sample data, reads as demo UI).
import type { IndustryContent } from '../../data/industries-content';
import SampleBadge from '../ui/SampleBadge.astro';

interface Props { card: IndustryContent['heroCard']; icon: any }
const { card, icon: Icon } = Astro.props;
const pill = {
  ok: 'bg-emerald-400/10 text-emerald-300 ring-emerald-400/20',
  warn: 'bg-amber-400/10 text-amber-300 ring-amber-400/25',
  info: 'bg-brand-500/15 text-brand-200 ring-brand-400/25',
};
const dot = { ok: 'bg-emerald-400', warn: 'bg-amber-400', info: 'bg-brand-400' };
---

<div class="relative mx-auto w-full max-w-md pb-6" aria-hidden="true">
  <div class="absolute -inset-x-4 top-10 -bottom-2 rounded-3xl bg-white/[0.03] ring-1 ring-white/[0.06]"></div>
  <div class="relative rounded-3xl bg-ink-900/85 p-5 shadow-2xl shadow-black/50 ring-1 ring-white/10 backdrop-blur">
    <div class="flex items-start gap-3">
      <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-white/10 text-saffron-400 ring-1 ring-white/15"><Icon size={19} stroke-width={1.75} /></span>
      <div class="min-w-0 flex-1">
        <p class="font-semibold text-white">{card.title}</p>
        <p class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-[11px] text-ink-400">{card.subtitle}<SampleBadge tone="dark" /></p>
      </div>
    </div>
    <ul class="mt-5 space-y-2">
      {card.rows.map((r) => (
        <li class="flex items-center justify-between gap-3 rounded-xl bg-white/[0.04] px-3 py-2.5 ring-1 ring-white/[0.06]">
          <span class="flex min-w-0 items-center gap-2 text-xs leading-snug text-ink-300">
            <span class={`h-1.5 w-1.5 shrink-0 rounded-full ${dot[r.status]}`}></span>
            <span>{r.label}</span>
          </span>
          <span class={`shrink-0 rounded-full px-2 py-0.5 text-[11px] font-semibold whitespace-nowrap ring-1 tabular-nums ${pill[r.status]}`}>{r.value}</span>
        </li>
      ))}
    </ul>
    <div class="mt-4 flex items-center justify-between gap-3 rounded-xl bg-gradient-to-r from-brand-600 to-brand-700 px-3.5 py-3">
      <span class="text-[11px] font-semibold tracking-wide whitespace-nowrap text-brand-100 uppercase">{card.footer.label}</span>
      <span class="text-right text-sm font-bold text-white">{card.footer.value}</span>
    </div>
  </div>
</div>
