---
// Narrow dark icon sidebar used inside mockups. Shows from the @md container size up.
interface Props {
  icons: any[];
  active?: number;
}
const { icons, active = 0 } = Astro.props;
---

<aside class="hidden w-12 shrink-0 flex-col items-center gap-2 bg-ink-900 py-3 @md:flex" aria-hidden="true">
  <span class="mb-2 grid h-7 w-7 place-items-center rounded-lg bg-brand-600 text-[11px] font-extrabold text-white">M</span>
  {icons.map((Icon, i) => (
    <span class={`grid h-8 w-8 place-items-center rounded-lg ${i === active ? 'bg-white/10 text-white' : 'text-ink-400'}`}>
      <Icon size={15} stroke-width={1.9} />
    </span>
  ))}
  <span class="mt-auto grid h-7 w-7 place-items-center rounded-full bg-saffron-500 text-[10px] font-bold text-ink-950">AK</span>
</aside>
