---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { CalendarDays, Clock, ChevronDown } from '@lucide/astro';
import Base from '../../layouts/Base.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import RelatedCards from '../../components/ui/RelatedCards.astro';
import Prose from '../../components/company/Prose.astro';
import PostCard from '../../components/company/PostCard.astro';
import { relatedFrom } from '../../data/site';
import { articleLd, breadcrumbList } from '../../data/schema';

export async function getStaticPaths() {
  const posts = await getCollection('insights', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props { post: CollectionEntry<'insights'> }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, date, tags, product, related } = post.data;
const path = `/insights/${post.id}/`;
const crumbs = [{ label: 'Insights', path: '/insights/' }, { label: title }];

const words = (post.body ?? '').split(/\s+/).filter(Boolean).length;
const minutes = post.data.readingTime ?? Math.max(1, Math.round(words / 200));
const dateLabel = date.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
const toc = headings.filter((h) => h.depth === 2);

// Product and service paths become cards; anything else is ignored.
const slugOf = (p: string, base: string) => p.match(new RegExp(`^/${base}/([^/]+)/?$`))?.[1];
const cards = relatedFrom(
  related.map((r) => slugOf(r.path, 'products')).filter((s): s is string => Boolean(s)),
  related.map((r) => slugOf(r.path, 'services')).filter((s): s is string => Boolean(s)),
);

const others = (await getCollection('insights', ({ data, id }) => !data.draft && id !== post.id))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 2);
---

<Base
  title={title}
  description={description}
  type="article"
  published={date}
  schema={[articleLd({ title, description, path, date, tags }), breadcrumbList(crumbs, path)]}
>
  <article>
    <header class="relative overflow-hidden bg-ink-950 text-white">
      <div class="bg-grid mask-fade-y pointer-events-none absolute inset-0"></div>
      <div class="animate-glow pointer-events-none absolute -top-48 -right-40 h-[34rem] w-[34rem] rounded-full bg-brand-600/35 blur-3xl"></div>
      <div class="animate-glow pointer-events-none absolute -bottom-56 -left-32 h-[26rem] w-[26rem] rounded-full bg-saffron-500/10 blur-3xl [animation-delay:-4s]"></div>

      <div class="container-page relative py-12 sm:py-16 lg:py-24">
        {/* The current crumb repeats the H1 right below it, so it's hidden on phones. */}
        <Breadcrumbs items={crumbs} class="-mt-2 max-sm:[&_li:last-child]:hidden" />

        <div class="max-w-4xl">
          <ul class="mt-6 flex flex-wrap gap-2" aria-label="Tags">
            {tags.map((t) => <li class="rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-ink-100 ring-1 ring-white/15">{t}</li>)}
          </ul>
          <h1 class="mt-5 text-3xl leading-[1.12] font-extrabold text-white sm:text-5xl lg:text-[3.4rem]">{title}</h1>
          <p class="mt-6 max-w-3xl text-lg leading-relaxed text-ink-300">{description}</p>
          <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm text-ink-400">
            <span class="inline-flex items-center gap-2">
              <span class="grid h-8 w-8 place-items-center rounded-full bg-brand-600 text-xs font-bold text-white" aria-hidden="true">M</span>
              <span class="text-ink-200">Our team</span>
            </span>
            <span class="inline-flex items-center gap-1.5"><CalendarDays size={15} aria-hidden="true" /><time datetime={date.toISOString()}>{dateLabel}</time></span>
            <span class="inline-flex items-center gap-1.5"><Clock size={15} aria-hidden="true" />{minutes} min read</span>
          </div>
        </div>
      </div>
    </header>

    <div class="bg-white py-12 lg:py-20">
      <div class="container-page grid gap-12 lg:grid-cols-[minmax(0,1fr)_17rem] lg:gap-16">
        <div class="mx-auto w-full max-w-[68ch] min-w-0 lg:mx-0">
          {toc.length > 0 && (
            <details class="group mb-10 rounded-2xl bg-ink-50 ring-1 ring-ink-100 lg:hidden">
              <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 rounded-2xl px-5 py-3 text-sm font-semibold text-ink-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500 [&::-webkit-details-marker]:hidden">
                On this page
                <ChevronDown size={16} class="text-ink-500 transition group-open:rotate-180" aria-hidden="true" />
              </summary>
              <ol class="space-y-0.5 px-5 pb-4">
                {toc.map((h) => (
                  <li><a href={`#${h.slug}`} class="block py-1.5 text-sm leading-snug text-ink-600 hover:text-brand-700">{h.text}</a></li>
                ))}
              </ol>
            </details>
          )}

          <Prose>
            <Content />
          </Prose>
        </div>

        {toc.length > 0 && (
          <aside class="hidden lg:block" aria-label="On this page">
            <div class="sticky top-28">
              <p class="text-xs font-semibold tracking-[0.14em] text-ink-500 uppercase">On this page</p>
              <ol class="mt-4 space-y-1 border-l border-ink-100">
                {toc.map((h) => (
                  <li>
                    <a href={`#${h.slug}`} class="-ml-px block border-l-2 border-transparent py-1.5 pl-4 text-sm leading-snug text-ink-600 transition hover:border-brand-500 hover:text-ink-900">{h.text}</a>
                  </li>
                ))}
              </ol>
            </div>
          </aside>
        )}
      </div>
    </div>
  </article>

  {cards.length > 0 && (
    <section class="border-t border-ink-100 bg-white py-14 lg:py-20" aria-labelledby="related-heading">
      <div class="container-page">
        <h2 id="related-heading" class="reveal text-2xl font-extrabold sm:text-3xl">Related to this article</h2>
        <RelatedCards items={cards} class="mt-8" />
      </div>
    </section>
  )}

  {others.length > 0 && (
    <section class="bg-ink-50 py-16 lg:py-20">
      <div class="container-page">
        <h2 class="reveal text-2xl font-extrabold sm:text-3xl">Keep reading</h2>
        <div class="mt-8 grid gap-6 md:grid-cols-2">
          {others.map((p, i) => <PostCard post={p} delay={i * 100} />)}
        </div>
      </div>
    </section>
  )}

  <CtaBand
    title="Want this built into your workflow?"
    text="We turn checklists like this one into software your team uses on every file."
    interest={product}
  />
</Base>
