---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/ui/PageHero.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import PostCard from '../../components/company/PostCard.astro';
import { collectionLd, breadcrumbList } from '../../data/schema';

const posts = (await getCollection('insights', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const featured = posts.find((p) => p.data.featured) ?? posts[0];
const rest = posts.filter((p) => p !== featured);
const crumbs = [{ label: 'Insights' }];
const description =
  'Practical notes on lending technology, underwriting checks, document verification and business software from the engineers at Manka.';

---

<Base
  title="Insights"
  description={description}
  schema={[collectionLd({ name: 'Insights', description, path: '/insights/' }), breadcrumbList(crumbs, '/insights/')]}
>
  <PageHero
    title="Notes from the work, written for operators."
    highlight="written for operators."
    breadcrumbs={crumbs}
  >
  </PageHero>

  <section class="relative bg-white py-16 lg:py-24">
    <div class="container-page">
      {featured && <PostCard post={featured} variant="featured" />}

      {rest.length > 0 && (
        <>
          <h2 class="reveal mt-16 text-3xl font-extrabold sm:text-4xl">More articles</h2>
          <div class={`mt-10 grid gap-6 md:grid-cols-2 ${rest.length >= 3 ? 'lg:grid-cols-3' : ''}`}>
            {rest.map((post, i) => <PostCard post={post} delay={i * 100} />)}
          </div>
        </>
      )}
    </div>
  </section>

  <CtaBand title="Working on something similar?" />
</Base>
