---
import { House, Layers, Boxes, PhoneCall, ArrowRight } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import { href, contactPath, cta } from '../data/site';

const links = [
  { icon: House, label: 'Home', path: '/' },
  { icon: Layers, label: 'Services', path: '/services/' },
  { icon: Boxes, label: 'Products', path: '/products/' },
  { icon: PhoneCall, label: cta.call, path: contactPath() },
];
---

<Base title="Page not found" description="The page you were looking for doesn’t exist or has moved." noindex>
  <section class="relative isolate flex min-h-[calc(100dvh-4rem)] items-center overflow-hidden bg-ink-950 text-white">
    <div class="bg-grid mask-fade-y pointer-events-none absolute inset-0 -z-10"></div>
    <div class="animate-glow pointer-events-none absolute -top-40 left-1/2 -z-10 h-[34rem] w-[34rem] -translate-x-1/2 rounded-full bg-brand-600/35 blur-3xl"></div>
    <div class="animate-glow pointer-events-none absolute -bottom-48 -left-24 -z-10 h-[24rem] w-[24rem] rounded-full bg-saffron-500/15 blur-3xl [animation-delay:-4s]"></div>

    <div class="container-page py-20 text-center lg:py-28">
      <p class="text-[6rem] leading-none font-extrabold tracking-tighter sm:text-[9rem]" aria-hidden="true">
        <span class="text-gradient-saffron">404</span>
      </p>
      <h1 class="mt-4 text-3xl font-extrabold text-white sm:text-4xl">This page took a wrong turn.</h1>
      <ul class="mx-auto mt-12 grid max-w-4xl gap-3 text-left sm:grid-cols-2 lg:grid-cols-4">
        {links.map((l) => (
          <li>
            <a href={href(l.path)} class="card-dark-link group flex h-full items-center gap-3 p-4">
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-white/10 text-saffron-400 ring-1 ring-white/15"><l.icon size={19} aria-hidden="true" /></span>
              <span class="flex-1 font-semibold text-white">{l.label}</span>
              <ArrowRight size={15} class="shrink-0 text-ink-400 transition group-hover:translate-x-0.5 group-hover:text-white" aria-hidden="true" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
