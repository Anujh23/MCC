---
import { House, Layers, Boxes, PhoneCall, ArrowRight } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { href, contactPath, cta } from '../data/site';

const links = [
  { icon: House, label: 'Home', text: 'Start from the top.', path: '/' },
  { icon: Layers, label: 'Services', text: 'Websites, CRMs, HR systems, data and custom software.', path: '/services/' },
  { icon: Boxes, label: 'Products', text: 'Manka CRM, BSA, Payslip Checker, Maps API and Manka HRMS.', path: '/products/' },
  { icon: PhoneCall, label: cta.call, text: 'Tell us what you were looking for.', path: contactPath() },
];
---

<Base title="Page not found" description="The page you were looking for doesn’t exist or has moved." noindex>
  <section class="relative isolate flex min-h-[calc(100dvh-4rem)] items-center overflow-hidden bg-ink-950 text-white">
    <div class="bg-grid mask-fade-y pointer-events-none absolute inset-0 -z-10"></div>
    <div class="animate-glow pointer-events-none absolute -top-40 left-1/2 -z-10 h-[34rem] w-[34rem] -translate-x-1/2 rounded-full bg-brand-600/35 blur-3xl"></div>
    <div class="animate-glow pointer-events-none absolute -bottom-48 -left-24 -z-10 h-[24rem] w-[24rem] rounded-full bg-saffron-500/15 blur-3xl [animation-delay:-4s]"></div>

    <div class="container-page py-20 text-center lg:py-28">
      <Logo mark size="lg" class="drop-shadow-[0_10px_30px_rgba(36,72,240,0.45)]" />

      <p class="mt-10 text-[6rem] leading-none font-extrabold tracking-tighter sm:text-[9rem]" aria-hidden="true">
        <span class="text-gradient-saffron">404</span>
      </p>
      <h1 class="mt-4 text-3xl font-extrabold text-white sm:text-4xl">This page took a wrong turn.</h1>
      <p class="mx-auto mt-4 max-w-xl text-lg leading-relaxed text-ink-300">
        The link may be old, or the page may have moved. Here are a few places that do exist.
      </p>

      <ul class="mx-auto mt-12 grid max-w-4xl gap-3 text-left sm:grid-cols-2 lg:grid-cols-4">
        {links.map((l) => (
          <li>
            <a href={href(l.path)} class="card-dark-link group flex h-full flex-col p-5">
              <span class="grid h-10 w-10 place-items-center rounded-xl bg-white/10 text-saffron-400 ring-1 ring-white/15"><l.icon size={19} aria-hidden="true" /></span>
              <span class="mt-4 flex items-center gap-1.5 font-semibold text-white">{l.label}<ArrowRight size={15} class="text-ink-400 transition group-hover:translate-x-0.5 group-hover:text-white" aria-hidden="true" /></span>
              <span class="mt-1 text-sm text-ink-400">{l.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
