---
import { ArrowRight, Headset, FileText, MonitorPlay, FolderGit2 } from '@lucide/astro';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Section from '../../components/ui/Section.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import IconBadge from '../../components/ui/IconBadge.astro';
import Steps from '../../components/ui/Steps.astro';
import ServiceMap from '../../components/services/ServiceMap.astro';
import ServicesBento from '../../components/services/ServicesBento.astro';
import EngagementModels from '../../components/services/EngagementModels.astro';
import { contactHref, cta, howWeWork } from '../../data/site';
import { collectionLd, breadcrumbList } from '../../data/schema';

const title = 'IT Services: Websites, CRM, HR & Custom Software';
const description =
  'Website, CRM, HR and payroll, data and analytics, and custom software development for Indian SMEs and lenders. One team from scoping to support.';
const crumbs = [{ label: 'Services' }];
const path = '/services/';

const promises = [
  { icon: Headset, title: 'An engineer on the first call', text: 'The person scoping your project understands how it will be built, so estimates are grounded.' },
  { icon: FileText, title: 'Scope and quote in writing', text: 'What’s in, what’s out, the timeline and the number, before any work starts.' },
  { icon: MonitorPlay, title: 'Working demos, not status reports', text: 'You see real software on a staging link at every milestone and can change course early.' },
  { icon: FolderGit2, title: 'Code and docs handed over', text: 'For custom builds, the repository, the hosting accounts and the data are in your name, with docs your next developer can follow.' },
];
---

<Base
  title={title}
  description={description}
  schema={[collectionLd({ name: 'Services', description, path }), breadcrumbList(crumbs, path)]}
>
  <PageHero
    title="Websites to loan workflows, built by one accountable team"
    highlight="one accountable team"
    intro="Websites, CRMs, HR and payroll, dashboards and custom integrations, built by one team that also builds lending products like bank statement analysis and payslip checks. Pick one service or connect them all."
    breadcrumbs={crumbs}
  >
    <Fragment slot="actions">
      <a href={contactHref()} class="btn btn-primary group px-6 py-3 text-base">
        {cta.call}<ArrowRight size={18} class="transition group-hover:translate-x-0.5" aria-hidden="true" />
      </a>
      <a href="#all-services" class="btn bg-white/10 px-6 py-3 text-base text-white ring-1 ring-white/20 hover:bg-white/15">Browse services</a>
    </Fragment>
    <Fragment slot="aside"><ServiceMap /></Fragment>
  </PageHero>

  <Section
    id="all-services"
    eyebrow="What we do"
    title="Five services, each with depth behind it"
    highlight="depth behind it"
    intro="Each service page covers what you get, how the project runs, the tools we use and the questions to ask first."
  >
    <ServicesBento />
  </Section>

  <Section
    tone="dark"
    eyebrow="How we work"
    title="From first call to support, the same five steps"
    intro="Every project gets its own dated plan once the scope is agreed."
  >
    <div class="bg-grid mask-fade-y pointer-events-none absolute inset-0 opacity-60"></div>
    <Steps tone="dark" steps={howWeWork} class="relative" />
  </Section>

  <Section eyebrow="What you can expect" title="How every engagement is run">
    <ul class="grid gap-6 sm:grid-cols-2 sm:gap-4 lg:grid-cols-4">
      {promises.map((p, i) => (
        <li class="reveal flex gap-4 sm:block sm:rounded-2xl sm:bg-white sm:p-6 sm:ring-1 sm:ring-ink-100" style={`--d: ${i * 80}ms`}>
          <IconBadge icon={p.icon} />
          <div class="min-w-0">
            <h3 class="text-lg font-bold sm:mt-5">{p.title}</h3>
            <p class="mt-1.5 text-[0.95rem] leading-relaxed text-ink-600 sm:mt-2">{p.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </Section>

  <Section
    tone="muted"
    eyebrow="Engagement models"
    title="Three ways to work with us"
    intro="Pick the model that fits the work. Every engagement gets a written quote after a scoping call."
  >
    <EngagementModels />
  </Section>

  <CtaBand secondary={{ label: cta.allIndustries, path: '/industries/' }} />
</Base>
