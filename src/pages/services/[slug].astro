---
import { ArrowRight } from '@lucide/astro';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Section from '../../components/ui/Section.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import Steps from '../../components/ui/Steps.astro';
import Faq from '../../components/ui/Faq.astro';
import RelatedCards from '../../components/ui/RelatedCards.astro';
import ServiceVisual from '../../components/services/ServiceVisual.astro';
import DeliverablesGrid from '../../components/services/DeliverablesGrid.astro';
import ProblemsGrid from '../../components/services/ProblemsGrid.astro';
import { services, contactHref, cta, relatedFrom } from '../../data/site';
import { serviceLd, breadcrumbList } from '../../data/schema';
import { servicesContent } from '../../data/services-content';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
}

const { service } = Astro.props;
const c = servicesContent[service.slug];
const crumbs = [{ label: 'Services', path: '/services/' }, { label: service.title }];
const path = `/services/${service.slug}/`;
---

<Base
  title={c.metaTitle}
  description={c.metaDescription}
  schema={[serviceLd({ name: service.title, description: c.metaDescription, path }), breadcrumbList(crumbs, path)]}
>
  <PageHero title={c.headline} highlight={c.highlight} intro={c.intro} breadcrumbs={crumbs}>
    <Fragment slot="actions">
      <a href={contactHref(service.slug)} class="btn btn-primary group px-6 py-3 text-base">
        {cta.call}<ArrowRight size={18} class="transition group-hover:translate-x-0.5" aria-hidden="true" />
      </a>
    </Fragment>
    <Fragment slot="aside"><ServiceVisual visual={c.visual} /></Fragment>
  </PageHero>

  <Section
    class="max-sm:py-16"
    title={`Everything a good ${c.noun} project should include`}
    highlight="should include"
  >
    <DeliverablesGrid items={c.deliverables} />
  </Section>

  <Section class="max-sm:py-16" tone="muted" title={c.problemsTitle}>
    <ProblemsGrid items={c.problems} />
  </Section>

  <Section class="max-sm:py-16" tone="dark" title="A plan with dates, not a black box">
    <div class="bg-grid mask-fade-y pointer-events-none absolute inset-0 -z-0 opacity-60"></div>
    <Steps tone="dark" steps={c.steps} class="relative" />
  </Section>

  <Section class="max-sm:py-16" title="Pairs well with">
    <RelatedCards items={relatedFrom(c.products, c.relatedServices)} />
  </Section>

  <Section tone="muted" class="max-sm:py-16">
    <Faq title="Questions" items={c.faqs} />
  </Section>

  <CtaBand title={`Planning your ${c.noun} project?`} interest={service.slug} />
</Base>
