---
// No open roles right now. When hiring starts, list the roles here.
import Base from '../layouts/Base.astro';
import PageHero from '../components/ui/PageHero.astro';
import { breadcrumbList } from '../data/schema';

const crumbs = [{ label: 'Careers' }];
---

<Base
  title="Careers"
  description="There are no open roles right now. When we are hiring, the openings will be listed on this page."
  schema={breadcrumbList(crumbs, '/careers/')}
>
  <PageHero
    title="No open roles right now."
    intro="We aren’t hiring at the moment. When we are, the openings will be listed here."
    breadcrumbs={crumbs}
  />
</Base>
