---
import {
  CodeXml, Database, PenTool, ClipboardList, Handshake, ArrowRight,
  MessagesSquare, Rocket, GraduationCap, Laptop, FileText, PhoneCall, Hammer, CircleCheck,
} from '@lucide/astro';
import Base from '../layouts/Base.astro';
import PageHero from '../components/ui/PageHero.astro';
import Section from '../components/ui/Section.astro';
import CtaBand from '../components/ui/CtaBand.astro';
import IconBadge from '../components/ui/IconBadge.astro';
import Steps from '../components/ui/Steps.astro';
import { contactHref, contactPath, cta } from '../data/site';
import { breadcrumbList } from '../data/schema';

const crumbs = [{ label: 'Careers' }];


// Applications go through the contact form (Careers).
const apply = contactHref('careers');

const reasons = [
  { icon: Rocket, title: 'Your work ships', text: 'Finished products and custom builds that go live, not demo folders.' },
  { icon: MessagesSquare, title: 'You meet the users', text: 'You hear the problem first-hand, not in a ticket.' },
  { icon: Hammer, title: 'Broad, practical work', text: 'CRMs, HR systems, data pipelines and document checks.' },
  { icon: GraduationCap, title: 'Learn the domain', text: 'We explain the business, not just the spec.' },
];

const steps = [
  { icon: FileText, title: cta.introduce, text: 'Use the contact form and choose Careers.' },
  { icon: PhoneCall, title: 'Intro call', text: '30 minutes on your experience and what you want next.' },
  { icon: Laptop, title: 'Practical round', text: 'A short task close to the real job. No trick puzzles.' },
  { icon: CircleCheck, title: 'Decision', text: 'A clear yes or no, for everyone.' },
];

const roles = [
  { icon: CodeXml, title: 'Full-stack developer', text: 'Web apps and APIs, end to end.', skills: ['JavaScript / TypeScript', 'SQL', 'REST APIs'] },
  { icon: Database, title: 'Python / data engineer', text: 'Pipelines, document parsing and dashboards.', skills: ['Python', 'SQL', 'Data modelling'] },
  { icon: PenTool, title: 'UI/UX designer', text: 'Screens people use for hours a day.', skills: ['Figma', 'Design systems', 'User research'] },
  { icon: ClipboardList, title: 'Business analyst', text: 'Map the process and write clear requirements.', skills: ['Process mapping', 'Documentation', 'Excel / SQL'] },
  { icon: Handshake, title: 'Sales / business development', text: 'Find businesses we can help, and be straight about fit.', skills: ['B2B sales', 'Consultative selling', 'Lending / SaaS'] },
];

---

<Base
  title="Careers"
  description="Work at Manka Commerce & Consultancy: build CRMs, HR systems, data tools and lending software, and talk to the people who use them."
  schema={breadcrumbList(crumbs, '/careers/')}
>
  <PageHero
    title="Build lending and business software, end to end."
    highlight="end to end."
    intro="We build CRMs, HR systems, data tools and lending software. If you like shipping useful things, we’d like to hear from you."
    breadcrumbs={crumbs}
  >
    <Fragment slot="actions">
      <a href={apply} class="btn btn-primary px-6 py-3 text-base">{cta.introduce}<ArrowRight size={18} aria-hidden="true" /></a>
      <a href="#roles" class="btn bg-white/10 px-6 py-3 text-base text-white ring-1 ring-white/20 hover:bg-white/15">See the roles</a>
    </Fragment>
    <div slot="aside" class="relative mx-auto w-full max-w-md">
      <div class="card-dark p-6 sm:p-7">
        <div class="flex items-center justify-between gap-4">
          <p class="text-xs font-semibold tracking-[0.14em] text-ink-400 uppercase">Hiring status</p>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-white/10 px-2.5 py-1 text-xs font-medium text-ink-200 ring-1 ring-white/15">
            <span class="h-1.5 w-1.5 rounded-full bg-saffron-500" aria-hidden="true"></span>Open to CVs
          </span>
        </div>
        <p class="mt-5 text-2xl font-bold text-white">No fixed openings right now.</p>
        <p class="mt-2 text-sm leading-relaxed text-ink-300">We read every application.</p>
        <div class="mt-6 space-y-2.5">
          {roles.slice(0, 3).map((r) => (
            <div class="flex items-center gap-3 rounded-xl bg-white/[0.04] px-4 py-3 ring-1 ring-white/10">
              <r.icon size={17} class="shrink-0 text-brand-300" aria-hidden="true" />
              <span class="text-sm font-medium text-ink-100">{r.title}</span>
            </div>
          ))}
          <p class="pt-1 text-xs text-ink-400">+ {roles.length - 3} more roles below</p>
        </div>
      </div>
    </div>
  </PageHero>

  <!-- Why work here -->
  <Section tone="light" eyebrow="Why work here" title="Less ceremony. More shipping." highlight="More shipping.">
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {reasons.map((r, i) => (
        <div class={`reveal card ${i === 0 ? 'lg:col-span-2 lg:row-span-1' : ''}`} style={`--d: ${i * 80}ms`}>
          <IconBadge icon={r.icon} tone={i % 2 ? 'saffron' : 'brand'} />
          <h3 class="mt-5 text-lg">{r.title}</h3>
          <p class="mt-2 text-[0.95rem] leading-relaxed text-ink-600">{r.text}</p>
        </div>
      ))}
    </div>
  </Section>

  <!-- How we hire -->
  <Section tone="muted" eyebrow="How we hire" title="Four steps, and a clear answer.">
    <Steps steps={steps} />
  </Section>

  <!-- Roles -->
  <Section tone="light" id="roles" eyebrow="Roles" title="Roles we expect to hire for.">
    <ul class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {roles.map((r, i) => (
        <li class="reveal card group flex flex-col" style={`--d: ${i * 80}ms`}>
          <div class="flex items-start justify-between gap-4">
            <IconBadge icon={r.icon} />
            <span class="rounded-full bg-ink-50 px-2.5 py-1 text-xs font-medium text-ink-600 ring-1 ring-ink-100">Open to CVs</span>
          </div>
          <h3 class="mt-5 text-xl">{r.title}</h3>
          <p class="mt-2 flex-1 text-[0.95rem] leading-relaxed text-ink-600">{r.text}</p>
          <ul class="mt-5 flex flex-wrap gap-2" aria-label="Useful skills">
            {r.skills.map((s) => <li class="rounded-md bg-brand-50 px-2 py-0.5 text-xs font-medium text-brand-700">{s}</li>)}
          </ul>
        </li>
      ))}
    </ul>
  </Section>

  <CtaBand
    title="Think you’d fit? Introduce yourself."
    text="A link to your CV and a few lines about something you’ve built is all we need."
    primary={{ label: cta.introduce, path: contactPath('careers') }}
  />
</Base>
