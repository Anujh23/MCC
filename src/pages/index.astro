---
import Base from '../layouts/Base.astro';
import Section from '../components/ui/Section.astro';
import Steps from '../components/ui/Steps.astro';
import Faq from '../components/ui/Faq.astro';
import CtaBand from '../components/ui/CtaBand.astro';
import Hero from '../components/home/Hero.astro';
import ServicesBento from '../components/home/ServicesBento.astro';
import ProductsTabs from '../components/home/ProductsTabs.astro';
import Industries from '../components/home/Industries.astro';
import WhyManka from '../components/home/WhyManka.astro';
import TechStack from '../components/home/TechStack.astro';
import { howWeWork } from '../data/site';

const description =
  'Manka builds CRMs, HR systems, websites and lending tools like bank statement analysis and payslip checks for Indian businesses. Book a free call.';

const faqs = [
  {
    q: 'How much does a project cost?',
    a: 'It depends on scope. After a free call we send a written quote with one fixed price in ₹, so you know the number before we start.',
  },
  {
    q: 'How long will it take?',
    a: 'A company website takes a few weeks. A CRM, HR system or lending workflow takes a few months. You see working software at every milestone.',
  },
  {
    q: 'Can you work with our existing software?',
    a: 'Usually, yes. We connect to Tally, an old CRM, a loan management system or your Excel sheets, and move the data across when you’re ready.',
  },
  {
    q: 'What happens after go-live?',
    a: 'The same team stays on to fix bugs and make changes, or hands over to your own team.',
  },
];
---

<Base description={description}>
  <Hero />
  <ServicesBento />
  <ProductsTabs />
  <Industries />
  <Section
    tone="muted"
    eyebrow="How we work"
    title="Five steps. No surprises in between."
    intro="You know the cost before we start and see the work at every stage."
    class="max-sm:py-14"
  >
    <Steps steps={howWeWork} />
  </Section>
  <WhyManka />
  <TechStack />
  <Section tone="muted" class="max-sm:py-14">
    <Faq
      title="Questions to ask before you hire anyone."
      items={faqs}
    />
  </Section>
  <CtaBand />
</Base>
