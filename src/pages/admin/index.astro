---
// Admin: manage client accounts (create, edit, password, wallet, disable/enable). API: /admin/* (admins only).
// "Delete" is Disable on purpose: login and API keys stop, history stays for accounts/GST, and it can be undone.
import { Plus } from '@lucide/astro';
import AppShell from '../../components/client/AppShell.astro';
import AuthForm from '../../components/client/AuthForm.astro';
import Field from '../../components/client/Field.astro';
import { ui } from '../../components/client/ui';
import { href } from '../../data/site';

const cancel = `${ui.link} justify-self-center text-ink-600`;
const h2 = 'text-lg font-bold text-ink-900';
const choice = 'flex min-h-11 cursor-pointer items-center justify-center rounded-xs border border-ink-300 text-sm font-semibold text-ink-700 has-focus-visible:outline-2 has-focus-visible:outline-brand-500';
---

<AppShell title="Clients" description="Manage client accounts." admin>
  <button slot="actions" type="button" data-open="new" class={ui.primary}><Plus size={16} aria-hidden="true" />New client</button>

  <section id="admin" data-login={href('/clientlogin/')} data-home={href('/client/')} class={`${ui.card} aria-busy:invisible`} aria-busy="true" aria-label="Clients">
    <p data-list-error role="alert" class={`${ui.error} m-4 sm:m-5`}></p>
    <ul data-rows class="divide-y divide-ink-100"></ul>
  </section>

  <template data-row>
    <li class="flex flex-wrap items-center gap-x-4 gap-y-2 px-4 py-4 sm:px-5">
      <div data-ident class="min-w-0 flex-1 basis-56">
        <p class="flex flex-wrap items-center gap-2">
          <span data-name class="font-semibold text-ink-900"></span>
          <span data-admin hidden class="rounded-xs bg-brand-50 px-1.5 py-0.5 text-xs font-semibold text-brand-700">Admin</span>
          <span data-disabled hidden class="rounded-xs bg-rose-50 px-1.5 py-0.5 text-xs font-semibold text-rose-700">Disabled</span>
        </p>
        <p data-email class="text-sm break-all text-ink-500"></p>
      </div>
      <p data-balance class="text-left font-semibold text-ink-900 tabular-nums sm:w-28 sm:text-right"></p>
      <div class="-mx-2 flex w-[calc(100%+1rem)] flex-wrap gap-x-3 gap-y-1 sm:w-auto">
        <button type="button" data-act="edit" class={`${ui.link} text-brand-700`}>Edit</button>
        <button type="button" data-act="password" class={`${ui.link} text-brand-700`}>Password</button>
        <button type="button" data-act="wallet" class={`${ui.link} text-brand-700`}>Wallet</button>
        <button type="button" data-act="toggle" class={`${ui.link} text-rose-700`}></button>
      </div>
    </li>
  </template>

  <dialog data-dialog="new" aria-labelledby="new-title" class={ui.dialog}>
    <div class="p-6">
      <h2 id="new-title" class={`mb-5 ${h2}`}>New client</h2>
      <AuthForm id="new-form" submit="Create client">
        <Field name="new-name" label="Name" autocomplete="off" />
        <Field name="new-email" label="Email" type="email" autocomplete="off" />
        <Field name="new-password" label="Password" type="password" autocomplete="new-password" minlength={10} />
        <button slot="after" type="button" data-close class={cancel}>Cancel</button>
      </AuthForm>
    </div>
  </dialog>

  <dialog data-dialog="edit" aria-labelledby="edit-title" class={ui.dialog}>
    <div class="p-6">
      <h2 id="edit-title" class={`mb-5 ${h2}`}>Edit client</h2>
      <AuthForm id="edit-form" submit="Save">
        <Field name="edit-name" label="Name" autocomplete="off" />
        <Field name="edit-email" label="Email" type="email" autocomplete="off" />
        <button slot="after" type="button" data-close class={cancel}>Cancel</button>
      </AuthForm>
    </div>
  </dialog>

  <dialog data-dialog="password" aria-labelledby="password-title" class={ui.dialog}>
    <div class="p-6">
      <h2 id="password-title" class={h2}>New password</h2>
      <p data-who class="mb-5 text-sm break-all text-ink-500"></p>
      <AuthForm id="password-form" submit="Set password">
        <Field name="pw-password" label="Password" type="password" autocomplete="new-password" minlength={10} />
        <button slot="after" type="button" data-close class={cancel}>Cancel</button>
      </AuthForm>
    </div>
  </dialog>

  <dialog data-dialog="wallet" aria-labelledby="wallet-title" class={ui.dialog}>
    <div class="p-6">
      <h2 id="wallet-title" class={h2}>Wallet</h2>
      <p data-who class="mb-5 text-sm break-all text-ink-500"></p>
      <AuthForm id="wallet-form" submit="Save">
        <fieldset class="grid grid-cols-2 gap-2">
          <legend class="sr-only">Add or deduct</legend>
          <label class={`${choice} has-checked:border-brand-300 has-checked:bg-brand-50 has-checked:text-brand-700`}>
            <input type="radio" name="action" value="credit" checked class="sr-only" />Add
          </label>
          <label class={`${choice} has-checked:border-rose-300 has-checked:bg-rose-50 has-checked:text-rose-700`}>
            <input type="radio" name="action" value="debit" class="sr-only" />Deduct
          </label>
        </fieldset>
        <Field name="w-rupees" label="Amount (₹)" type="number" autocomplete="off" min={0.01} step={0.01} />
        <Field name="w-note" label="Payment reference" autocomplete="off" />
        <button slot="after" type="button" data-close class={cancel}>Cancel</button>
      </AuthForm>
    </div>
  </dialog>
</AppShell>

<script>
  import { api, handleForm } from '../../scripts/client-api';

  type Row = { id: number; name: string; email: string; is_active: boolean; is_admin: boolean; balance_paise: number };

  const $ = <T extends Element = HTMLElement>(sel: string, root: ParentNode = document) => root.querySelector<T>(sel)!;
  const box = $('#admin');
  const listError = $('[data-list-error]');
  const rupees = (paise: number) => new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(paise / 100);
  let current: Row | null = null;

  async function load() {
    const r = await api('/admin/clients');
    if (r.status === 401) return location.replace(box.dataset.login!);
    if (r.status === 403) return location.replace(box.dataset.home!);
    box.removeAttribute('aria-busy');
    if (!r.ok) return (listError.textContent = 'Could not load clients. Refresh the page.');
    listError.textContent = '';
    const rows: Row[] = r.data;
    $('[data-rows]').replaceChildren(...rows.map(render));
  }

  function render(c: Row) {
    const li = ($<HTMLTemplateElement>('[data-row]').content.firstElementChild as HTMLElement).cloneNode(true) as HTMLElement;
    $('[data-name]', li).textContent = c.name;
    $('[data-email]', li).textContent = c.email;
    $('[data-balance]', li).textContent = rupees(c.balance_paise);
    $('[data-admin]', li).hidden = !c.is_admin;
    $('[data-disabled]', li).hidden = c.is_active;
    if (!c.is_active) $('[data-ident]', li).classList.add('opacity-60');
    const toggle = $('[data-act="toggle"]', li);
    toggle.textContent = c.is_active ? 'Disable' : 'Enable';
    toggle.classList.toggle('text-rose-700', c.is_active);
    toggle.classList.toggle('text-emerald-700', !c.is_active);
    li.querySelectorAll<HTMLButtonElement>('[data-act]').forEach((b) => b.addEventListener('click', () => act(b.dataset.act!, c)));
    return li;
  }

  // --- dialogs
  const dialogOf = (name: string) => $<HTMLDialogElement>(`[data-dialog="${name}"]`);
  function open(name: string, c: Row | null) {
    current = c;
    const d = dialogOf(name);
    const form = $<HTMLFormElement>('form', d);
    form.reset();
    $('[data-error]', form).textContent = '';
    d.querySelectorAll('[data-who]').forEach((el) => (el.textContent = c ? `${c.name} · ${c.email}` : ''));
    if (name === 'edit' && c) {
      $<HTMLInputElement>('#f-edit-name').value = c.name;
      $<HTMLInputElement>('#f-edit-email').value = c.email;
    }
    d.showModal();
  }
  document.querySelectorAll<HTMLDialogElement>('dialog[data-dialog]').forEach((d) => {
    d.addEventListener('click', (e) => e.target === d && d.close());
    $('[data-close]', d).addEventListener('click', () => d.close());
  });
  $('[data-open="new"]').addEventListener('click', () => open('new', null));

  async function act(action: string, c: Row) {
    if (action !== 'toggle') return open(action, c);
    const verb = c.is_active ? 'disable' : 'enable';
    if (c.is_active && !confirm(`Disable ${c.name}? They can't log in and their API keys stop working. History is kept.`)) return;
    const r = await api(`/admin/clients/${c.id}/${verb}`, {});
    if (!r.ok) listError.textContent = typeof r.data?.detail === 'string' ? r.data.detail : `Could not ${verb} the client.`;
    await load();
  }

  const done = (name: string) => async () => {
    dialogOf(name).close();
    await load();
  };

  handleForm($<HTMLFormElement>('#new-form'), (v) => api('/admin/clients', { name: v['new-name'], email: v['new-email'], password: v['new-password'] }), done('new'));
  handleForm($<HTMLFormElement>('#edit-form'), (v) => api(`/admin/clients/${current!.id}`, { name: v['edit-name'], email: v['edit-email'] }), done('edit'));
  handleForm($<HTMLFormElement>('#password-form'), (v) => api(`/admin/clients/${current!.id}/password`, { password: v['pw-password'] }), done('password'));
  handleForm(
    $<HTMLFormElement>('#wallet-form'),
    (v) => api(`/admin/clients/${current!.id}/wallet`, { action: v.action, rupees: v['w-rupees'], note: v['w-note'] }),
    done('wallet'),
  );

  load();
</script>
