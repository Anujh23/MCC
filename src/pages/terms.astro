---
// Draft: needs review by a legal professional before launch (the page says so).
import LegalPage from '../components/company/LegalPage.astro';
import { site, contact, href, contactHref } from '../data/site';

const sections = [
  { id: 'acceptance', title: 'Accepting these terms' },
  { id: 'use', title: 'Using this website' },
  { id: 'information', title: 'Information on this site' },
  { id: 'enquiries', title: 'Enquiries and projects' },
  { id: 'ip', title: 'Intellectual property' },
  { id: 'liability', title: 'Disclaimer and liability' },
  { id: 'privacy', title: 'Privacy' },
  { id: 'law', title: 'Governing law' },
  { id: 'changes', title: 'Changes to these terms' },
  { id: 'contact', title: 'Contact' },
];
---

<LegalPage
  title="Terms of use"
  description={`The terms that apply when you use the ${site.name} website.`}
  updated="2 November 2026"
  sections={sections}
>
  <section id="acceptance">
    <h2>1. Accepting these terms</h2>
    <p>This website is run by us (“we”, “us”). By using it, you agree to these terms.</p>
  </section>

  <section id="use">
    <h2>2. Using this website</h2>
    <p>Use the site lawfully. Don’t try to break into it, interfere with it, send spam through our forms or scrape it in bulk.</p>
  </section>

  <section id="information">
    <h2>3. Information on this site</h2>
    <p>
      Content here, including our Insights articles, is general information. It isn’t legal, financial, tax or regulatory advice. Lenders should confirm requirements with their own advisers.
    </p>
  </section>

  <section id="enquiries">
    <h2>4. Enquiries and projects</h2>
    <p>
      An enquiry doesn’t create a contract. Any estimate is indicative until both sides sign a written agreement, which then governs scope, fees, timelines and ownership. Product features may change as the products develop.
    </p>
  </section>

  <section id="ip">
    <h2>5. Intellectual property</h2>
    <p>Our name, logo, design and text belong to us. You may link to pages and quote short extracts with credit.</p>
  </section>

  <section id="liability">
    <h2>6. Disclaimer and liability</h2>
    <p>
      The site is provided “as is”. To the extent the law allows, we aren’t liable for indirect or consequential loss from using it or relying on its content.
    </p>
  </section>

  <section id="privacy">
    <h2>7. Privacy</h2>
    <p>See our <a href={href('/privacy/')}>privacy policy</a>.</p>
  </section>

  <section id="law">
    <h2>8. Governing law</h2>
    <p>These terms are governed by the laws of India. Please contact us first so we can try to resolve any concern informally.</p>
  </section>

  <section id="changes">
    <h2>9. Changes to these terms</h2>
    <p>We may update these terms. The date at the top shows the latest version.</p>
  </section>

  <section id="contact">
    <h2>10. Contact</h2>
    <p>
      Questions? Use the <a href={contactHref('other')}>contact form</a>{contact.phone ? <> or call <a href={contact.phoneHref}>{contact.phone}</a></> : null}.
    </p>
  </section>
</LegalPage>
