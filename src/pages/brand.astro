---
// Internal brand sheet: logo, colours, type. Not linked in nav, hidden from search engines.
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import SampleBadge from '../components/ui/SampleBadge.astro';
import { href, cta, products, productStatus } from '../data/site';

const palettes = [
  { name: 'Ink', note: 'Text, borders, dark sections', key: 'ink', shades: ['50', '100', '200', '300', '400', '500', '600', '700', '800', '900', '950'] },
  { name: 'Brand Blue', note: 'Buttons, links, primary actions', key: 'brand', shades: ['50', '100', '200', '300', '400', '500', '600', '700', '800', '900'] },
  { name: 'Saffron', note: 'Accent only. 700 is the only saffron allowed as text on light backgrounds', key: 'saffron', shades: ['50', '100', '200', '400', '500', '600', '700'] },
];

// Labels come from `cta` in src/data/site.ts.
const ctas = [
  { label: cta.call, to: 'contactHref(slug?)', where: 'Header, home, about, insights, 404, services, industries' },
  { label: cta.demo, to: 'contactHref(productSlug)', where: 'Products index, product hero and band, home product tabs' },
  { label: cta.api, to: '#api', where: 'Secondary hero CTA on BSA, Payslip Checker, Maps API' },
  { label: cta.how, to: '#how', where: 'Secondary hero CTA on Manka CRM, Manka HRMS' },
  { label: cta.apiDocs, to: 'contactHref(productSlug)', where: 'Under the API sample' },
  { label: cta.model, to: 'contactHref(serviceSlug)', where: 'Engagement model cards' },
  { label: cta.ask, to: 'contactHref(slug?)', where: 'Inline links in FAQ panels' },
  { label: cta.explore('{Name}'), to: 'Detail page', where: 'Related and product cards' },
  { label: `${cta.allServices} / products / industries`, to: 'Index page', where: 'CtaBand secondaries' },
  { label: cta.email, to: 'mailto:', where: 'Only once contact.email is real' },
  { label: `${cta.cv} / ${cta.introduce}`, to: "mailto: or contactHref('careers')", where: 'Careers only' },
];
const retired = ['Get a quote', 'View API docs', 'Book a demo', 'Talk to us', 'Learn more'];
const names: Record<string, string> = {
  crm: 'Bare “CRM” for the product',
  'bank-statement-analyser': '“Manka BSA”, “Analyzer”',
  'payslip-checker': '“Payslip”, “Manka Payslip”, “Payslip Verifier”',
  'maps-api': '“Manka Maps”',
  hrms: 'Bare “HRMS” for the product',
};
const th = 'border-b border-ink-100 bg-ink-50 px-4 py-2.5 text-left font-semibold text-ink-900';
const td = 'border-b border-ink-100 px-4 py-2.5 align-top text-ink-600';
---

<Base title="Brand Guidelines" noindex>
  <section class="container-page py-16">
    <span class="eyebrow">Brand</span>
    <h1 class="mt-4 text-4xl font-extrabold">Manka brand guidelines</h1>
    <p class="mt-3 max-w-2xl text-ink-500">Logo, colours and type. The mark is an “M” whose two peaks meet at a saffron node: the consultant who connects business and technology.</p>

    <h2 class="mt-14 text-xl">Logo</h2>
    <div class="mt-5 grid gap-4 md:grid-cols-3">
      <div class="flex h-40 items-center justify-center rounded-2xl ring-1 ring-ink-100"><Logo /></div>
      <div class="flex h-40 items-center justify-center rounded-2xl bg-ink-950"><Logo tone="light" /></div>
      <div class="flex h-40 items-center justify-center gap-6 rounded-2xl bg-ink-50">
        <Logo mark />
        <a href={href('/favicon.svg')} download="manka-mark.svg" class="btn btn-ghost">Download mark (SVG)</a>
      </div>
    </div>
    <ul class="mt-4 list-disc space-y-1 pl-5 text-sm text-ink-500">
      <li>Keep clear space around the logo equal to the height of the saffron dot ×2.</li>
      <li>Minimum size: 24px mark height on screen.</li>
      <li>Don’t recolour the tile, rotate it, or put it on busy photos.</li>
    </ul>

    <h2 class="mt-14 text-xl">Colours</h2>
    {palettes.map((p) => (
      <div class="mt-6">
        <p class="font-semibold text-ink-900">{p.name} <span class="ml-2 text-sm font-normal text-ink-500">{p.note}</span></p>
        <div class="mt-3 grid grid-cols-4 gap-2 sm:grid-cols-6 lg:grid-cols-11">
          {p.shades.map((s) => (
            <div>
              <div class="h-14 rounded-lg ring-1 ring-ink-900/5" style={`background: var(--color-${p.key}-${s})`}></div>
              <p class="mt-1 text-xs text-ink-500">{s}</p>
            </div>
          ))}
        </div>
      </div>
    ))}
    <p class="mt-4 text-sm text-ink-500">Core hex: Ink 900 <code>#0B1530</code> · Brand 600 <code>#2448F0</code> · Saffron 500 <code>#FF8A1F</code></p>

    <h2 class="mt-14 text-xl">Typography: Plus Jakarta Sans</h2>
    <div class="mt-5 space-y-4 rounded-2xl p-6 ring-1 ring-ink-100">
      <p class="text-5xl font-extrabold text-ink-900">Display 800</p>
      <p class="text-3xl font-bold text-ink-900">Heading 700</p>
      <p class="text-lg font-semibold text-ink-900">Subheading 600</p>
      <p class="max-w-2xl text-base text-ink-700">Body 400: We build CRMs, HR systems and lending tools for growing businesses, and we stay around after go-live.</p>
    </div>

    <h2 class="mt-14 text-xl">Buttons and labels</h2>
    <div class="mt-5 flex flex-wrap items-center gap-3">
      <button type="button" class="btn btn-primary">{cta.call}</button>
      <button type="button" class="btn btn-ghost">{cta.allServices}</button>
      <span class="eyebrow">Eyebrow label</span>
      <span class="rounded-xl bg-ink-950 p-3"><span class="eyebrow-pill"><span class="h-1.5 w-1.5 rounded-full bg-saffron-500" aria-hidden="true"></span>Eyebrow pill (dark only)</span></span>
    </div>

    <h2 class="mt-14 text-xl">Status and sample data</h2>
    <p class="mt-2 max-w-2xl text-sm text-ink-500">Products are built and ready to deploy, with no clients yet. The chip says so; never imply production use or a track record. Every mockup that shows a number carries the sample badge.</p>
    <div class="mt-5 flex flex-wrap items-center gap-4">
      <span class="rounded-xl bg-ink-950 p-3">
        <span class="inline-flex items-center gap-2 rounded-full bg-brand-500/15 px-3 py-1 text-xs font-semibold text-brand-100 ring-1 ring-brand-400/30">
          <span class="h-1.5 w-1.5 rounded-full bg-brand-300" aria-hidden="true"></span>{productStatus}
        </span>
      </span>
      <SampleBadge />
      <span class="rounded-xl bg-ink-950 p-3"><SampleBadge tone="dark" /></span>
    </div>
    <p class="mt-4 text-sm text-ink-500">Status colours: emerald = pass, amber = warning, rose = fail, brand = info. Saffron is never a status colour.</p>

    <h2 class="mt-14 text-xl">CTA glossary</h2>
    <div class="mt-5 overflow-x-auto rounded-2xl ring-1 ring-ink-100">
      <table class="w-full min-w-[36rem] text-sm">
        <thead><tr><th scope="col" class={th}>Label</th><th scope="col" class={th}>Goes to</th><th scope="col" class={th}>Used on</th></tr></thead>
        <tbody>
          {ctas.map((c) => (
            <tr><td class={`${td} font-semibold text-ink-900`}>{c.label}</td><td class={td}><code>{c.to}</code></td><td class={td}>{c.where}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-sm text-ink-500">Retired: {retired.map((r) => `“${r}”`).join(', ')}.</p>

    <h2 class="mt-14 text-xl">Product names</h2>
    <div class="mt-5 overflow-x-auto rounded-2xl ring-1 ring-ink-100">
      <table class="w-full min-w-[30rem] text-sm">
        <thead><tr><th scope="col" class={th}>Always</th><th scope="col" class={th}>In running copy</th><th scope="col" class={th}>Never</th></tr></thead>
        <tbody>
          {products.map((p) => (
            <tr><td class={`${td} font-semibold text-ink-900`}>{p.title}</td><td class={td}>{p.short ?? p.title}</td><td class={td}>{names[p.slug]}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-sm text-ink-500">BSA is “BSA (Bank Statement Analyser)” on first mention, then “BSA”.</p>
  </section>
</Base>
