---
import {
  MessagesSquare, KeyRound, LifeBuoy, ClipboardCheck, ShieldCheck,
  Compass, Wrench, MessageSquareText, ArrowRight, UserRoundPlus, NotebookPen,
} from '@lucide/astro';
import Base from '../layouts/Base.astro';
import PageHero from '../components/ui/PageHero.astro';
import Section from '../components/ui/Section.astro';
import CtaBand from '../components/ui/CtaBand.astro';
import IconBadge from '../components/ui/IconBadge.astro';
import Placeholder from '../components/company/Placeholder.astro';
import { services, products, href, contactHref, cta, flags } from '../data/site';
import { breadcrumbList } from '../data/schema';

const crumbs = [{ label: 'About' }];
const description =
  'Manka Commerce & Consultancy is an Indian IT services and products company building CRMs, HR systems, websites, data tools and lending software.';

const values = [
  { icon: MessageSquareText, title: 'Plain speaking', text: 'We tell you what it will cost and how long it will take, even when the answer is “don’t build this”.' },
  { icon: Compass, title: 'Learn the business first', text: 'The workflow decides the screens, not the other way round.' },
  { icon: Wrench, title: 'Care for the boring parts', text: 'Readable code, tests, backups and sensible permissions.' },
  { icon: ShieldCheck, title: 'Respect for data', text: 'Least-privilege access, and no copies where they aren’t needed.' },
];

const principles = [
  { icon: MessagesSquare, title: 'Engineers talk to you directly', text: 'The person scoping your project is the person building it.' },
  { icon: ClipboardCheck, title: 'A written quote', text: 'Scope, timeline and price before work starts. Changes are quoted first.' },
  { icon: KeyRound, title: 'You own the code', text: 'On custom builds, the code and docs are handed over in full.' },
  { icon: LifeBuoy, title: 'Support after launch', text: 'The same team stays on to fix and improve it.' },
];
---

<Base title="About us" description={description} schema={breadcrumbList(crumbs, '/about/')}>
  <PageHero
    title="Engineers you talk to directly. Code you own."
    highlight="Code you own."
    intro="We’re an Indian IT services and products company. We build CRMs, HR systems, websites, data tools and lending software, and stay on after launch."
    breadcrumbs={crumbs}
  >
    <Fragment slot="actions">
      <a href={contactHref()} class="btn btn-primary px-6 py-3 text-base">{cta.call}<ArrowRight size={18} aria-hidden="true" /></a>
      <a href="#how-we-work" class="btn bg-white/10 px-6 py-3 text-base text-white ring-1 ring-white/20 hover:bg-white/15">How we work</a>
    </Fragment>
  </PageHero>

  <!-- Our story -->
  <Section tone="light">
    <div class={flags.founderStory ? 'grid gap-12 lg:grid-cols-[1.15fr_1fr] lg:gap-16' : 'max-w-3xl'}>
      <div class="reveal">
        <h2 class="text-3xl leading-tight font-extrabold sm:text-4xl lg:text-[2.75rem]">
          Software should fit the business, <span class="text-gradient-brand">not the other way round.</span>
        </h2>
        <div class="mt-8 space-y-5 text-lg leading-relaxed text-ink-600">
          <p>Many growing businesses run on a patchwork: a CRM half the team uses, payroll in spreadsheets, approvals on WhatsApp.</p>
          <p>We build the software that closes that gap, connect it to what you already use, and focus most on lending, with our own products like BSA (Bank Statement Analyser) and Payslip Checker.</p>
        </div>
      </div>

      {flags.founderStory && (
        <div class="reveal flex" style="--d: 120ms">
          {/* TODO: replace with the real founder story (who started Manka, why, what they did before). First person, factual. */}
          <Placeholder
            icon={NotebookPen}
            title="Founder story coming soon"
            text="Owner to add: who started the company, why, and the problem that started it. A photo and a short first-person note work best."
            class="w-full bg-ink-50/60 lg:min-h-[22rem]"
          />
        </div>
      )}
    </div>
  </Section>

  <Section tone="muted" title="Four things we won’t trade away.">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {values.map((v, i) => (
        <div class="reveal card flex gap-4 sm:block" style={`--d: ${i * 80}ms`}>
          <IconBadge icon={v.icon} />
          <div>
            <h3 class="text-lg sm:mt-5">{v.title}</h3>
            <p class="mt-2 text-[0.95rem] leading-relaxed text-ink-600">{v.text}</p>
          </div>
        </div>
      ))}
    </div>
  </Section>

  <!-- How we work: promises, not a sequence, so a plain list -->
  <Section tone="light" id="how-we-work">
    <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20">
      <div class="reveal lg:sticky lg:top-28 lg:self-start">
        <h2 class="text-3xl leading-tight font-extrabold sm:text-4xl lg:text-[2.75rem]">Four promises, written into every project.</h2>
      </div>
      <ul class="space-y-4">
        {principles.map((p, i) => (
          <li class="reveal flex gap-5 rounded-2xl bg-white p-6 ring-1 ring-ink-100 sm:p-7" style={`--d: ${i * 80}ms`}>
            <IconBadge icon={p.icon} />
            <div>
              <h3 class="text-lg sm:text-xl">{p.title}</h3>
              <p class="mt-2 leading-relaxed text-ink-600">{p.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <!-- What we do -->
  <Section tone="dark" title="Services for what’s unique. Products for what isn’t.">
    <div class="grid gap-6 lg:grid-cols-2">
      {[
        { label: 'Services', base: '/services', items: services },
        { label: 'Products', base: '/products', items: products },
      ].map((group, gi) => (
        <div class="reveal rounded-3xl bg-white/[0.03] p-6 ring-1 ring-white/10 sm:p-8" style={`--d: ${gi * 120}ms`}>
          <h3 class="text-xl text-white">{group.label}</h3>
          <ul class="mt-4 divide-y divide-white/10">
            {group.items.map((item) => (
              <li>
                <a href={href(`${group.base}/${item.slug}/`)} class="group flex items-center gap-4 py-4">
                  <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-white/[0.06] text-brand-300 ring-1 ring-white/10 transition group-hover:bg-brand-600 group-hover:text-white">
                    <item.icon size={19} stroke-width={1.75} />
                  </span>
                  <span class="min-w-0 flex-1 font-semibold text-white">{item.title}</span>
                  <ArrowRight size={18} class="shrink-0 text-ink-400 transition group-hover:translate-x-0.5 group-hover:text-white" aria-hidden="true" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </Section>

  {flags.team && (
    <Section tone="muted" title="The people you’ll work with.">
      {/* TODO: real people only (name, role, photo, one line on their work). No stock photos or invented names. */}
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {[0, 1, 2, 3].map((i) => (
          <div class="reveal" style={`--d: ${i * 80}ms`}>
            <Placeholder icon={UserRoundPlus} title="Add team member" text="Name, role and a line on what they work on." class="h-full min-h-56" />
          </div>
        ))}
      </div>
    </Section>
  )}

  <CtaBand />
</Base>
