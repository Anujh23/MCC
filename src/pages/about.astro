---
import {
  MessagesSquare, KeyRound, LifeBuoy, ClipboardCheck, FileText, ShieldCheck,
  Sprout, Compass, Wrench, MessageSquareText, ArrowRight, UserRoundPlus, NotebookPen,
} from '@lucide/astro';
import Base from '../layouts/Base.astro';
import PageHero from '../components/ui/PageHero.astro';
import Section from '../components/ui/Section.astro';
import CtaBand from '../components/ui/CtaBand.astro';
import IconBadge from '../components/ui/IconBadge.astro';
import Placeholder from '../components/company/Placeholder.astro';
import { services, products, href, contactHref, cta, flags } from '../data/site';
import { breadcrumbList } from '../data/schema';

const crumbs = [{ label: 'About' }];
const description =
  'Manka Commerce & Consultancy is an Indian IT services and products company building CRMs, HR systems, websites, data tools and lending software.';

const promises = [
  { icon: MessagesSquare, k: 'You talk to', v: 'the engineer building it' },
  { icon: KeyRound, k: 'You own', v: 'the code and IP on custom builds' },
  { icon: LifeBuoy, k: 'You keep', v: 'us around after go-live' },
];

const values = [
  {
    icon: MessageSquareText,
    title: 'Plain speaking',
    text: 'We tell you what something will cost and how long it will take, including when the honest answer is “you don’t need to build this”. No jargon to hide behind.',
  },
  { icon: Compass, title: 'Learn the business first', text: 'We sit with the people who will use the software before we design it. The workflow decides the screens, not the other way round.' },
  { icon: Wrench, title: 'Care for the boring parts', text: 'Readable code, tested flows, backups, sensible permissions. The parts nobody demos are the parts that keep you running.' },
  { icon: ShieldCheck, title: 'Respect for data', text: 'Customer and financial data is handled as if it were ours: least-privilege access, no copies where they aren’t needed.' },
  { icon: Sprout, title: 'Built to last', text: 'We pick proven, well-supported tools so the system is still maintainable in five years, by us or by anyone else.' },
];

const principles = [
  { icon: MessagesSquare, title: 'Engineers talk to you directly', text: 'The person scoping your project is the person building it. Questions get answered by someone who knows the code, not relayed through an account manager.' },
  { icon: ClipboardCheck, title: 'Fixed scope, written down', text: 'Before work starts you get a written scope: what is in, what is out, the timeline and the price. Changes are quoted and agreed in writing before they’re done.' },
  { icon: KeyRound, title: 'You own the code and IP', text: 'For custom builds, the source code and infrastructure accounts are in your name, with no licence fee on software you paid us to build. Products are licensed. Your data is always yours.' },
  { icon: FileText, title: 'Documented handover', text: 'On custom builds: setup guides, architecture notes and admin manuals, so your own team, or another vendor, can pick it up without us.' },
  { icon: LifeBuoy, title: 'Support after launch', text: 'Bug-fix support after launch is part of every project scope, with the length agreed up front. After that, an AMC is available.' },
];

const link = 'font-semibold text-brand-700 underline decoration-brand-200 underline-offset-4 hover:decoration-brand-600';
---

<Base title="About us" description={description} schema={breadcrumbList(crumbs, '/about/')}>
  <PageHero
    title="Engineers you talk to directly. Code you own."
    highlight="Code you own."
    intro="Manka Commerce & Consultancy is an Indian IT services and products company. We build CRMs, HR systems, websites, data tools and lending software, and we stay on after launch to keep them running."
    breadcrumbs={crumbs}
  >
    <Fragment slot="actions">
      <a href={contactHref()} class="btn btn-primary px-6 py-3 text-base">{cta.call}<ArrowRight size={18} aria-hidden="true" /></a>
      <a href="#how-we-work" class="btn bg-white/10 px-6 py-3 text-base text-white ring-1 ring-white/20 hover:bg-white/15">How we work</a>
    </Fragment>
    <div slot="aside" class="relative mx-auto w-full max-w-md">
      <div class="pointer-events-none absolute -inset-6 rounded-[2rem] bg-gradient-to-br from-brand-600/30 to-transparent blur-2xl"></div>
      <ul class="relative space-y-3">
        {promises.map((p, i) => (
          <li class={`card-dark flex items-center gap-4 p-5 ${i === 1 ? 'sm:ml-10' : ''} ${i === 2 ? 'sm:ml-4' : ''}`}>
            <IconBadge icon={p.icon} tone="dark" />
            <span>
              <span class="block text-xs font-semibold tracking-[0.14em] text-ink-400 uppercase">{p.k}</span>
              <span class="mt-0.5 block text-lg font-semibold text-white">{p.v}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </PageHero>

  <!-- Our story -->
  <Section tone="light">
    <div class={flags.founderStory ? 'grid gap-12 lg:grid-cols-[1.15fr_1fr] lg:gap-16' : 'max-w-3xl'}>
      <div class="reveal">
        <p class="eyebrow">Our story</p>
        <h2 class="mt-3 text-3xl leading-tight font-extrabold sm:text-4xl lg:text-[2.75rem]">
          Software should fit the business, <span class="text-gradient-brand">not the other way round.</span>
        </h2>
        <div class="mt-8 space-y-5 text-lg leading-relaxed text-ink-600">
          <p>
            A lot of growing businesses in India run on a patchwork. A CRM half the team uses. Payroll in spreadsheets. Approvals on WhatsApp. Reports that take a day to put together every Monday. Off-the-shelf tools cover some of it, and people work around the rest.
          </p>
          <p>
            Manka exists to close that gap. We build the CRM, HR, data and custom software a business needs, connect it to the tools already in place, and hand it over in a state your team can live with.
          </p>
          <p>
            We focus on lending, where every loan file goes through the same slow checks and small savings add up across a portfolio. That is why we build our own products, like <a href={href('/products/bank-statement-analyser/')} class={link}>BSA (Bank Statement Analyser)</a> and <a href={href('/products/payslip-checker/')} class={link}>Payslip Checker</a>, alongside custom builds.
          </p>
        </div>
      </div>

      {flags.founderStory && (
        <div class="reveal flex" style="--d: 120ms">
          {/* TODO: replace with the real founder story (who started Manka, why, what they did before). First person, factual. */}
          <Placeholder
            icon={NotebookPen}
            title="Founder story coming soon"
            text="Owner to add: who started Manka, why, and the problem that started it. A photo and a short first-person note work best."
            class="w-full bg-ink-50/60 lg:min-h-[22rem]"
          />
        </div>
      )}
    </div>
  </Section>

  <!-- Mission -->
  <section class="relative overflow-hidden bg-ink-950 py-20 text-white lg:py-28">
    <div class="bg-grid mask-fade-y pointer-events-none absolute inset-0"></div>
    <div class="animate-glow pointer-events-none absolute top-1/2 left-1/2 h-[30rem] w-[50rem] max-w-full -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand-600/25 blur-3xl"></div>
    <div class="container-page relative">
      <div class="reveal mx-auto max-w-4xl text-center">
        <span class="eyebrow-pill"><span class="h-1.5 w-1.5 rounded-full bg-saffron-500" aria-hidden="true"></span>Our mission</span>
        <p class="mt-8 text-2xl leading-snug font-bold text-white sm:text-4xl lg:text-[2.75rem] lg:leading-[1.2]">
          Give growing Indian businesses software that fits how they work,{' '}
          <span class="text-gradient-saffron">built by engineers they can talk to,</span>{' '}
          and owned by them outright.
        </p>
      </div>
      <div class="mx-auto mt-14 grid max-w-5xl gap-4 sm:grid-cols-3">
        {[
          { t: 'Fits the work', d: 'Designed around your real process, including the exceptions.' },
          { t: 'Easy to reach', d: 'A direct line to the people who build and maintain it.' },
          { t: 'Yours to keep', d: 'On custom builds, code, data and documentation are handed over in full.' },
        ].map((x, i) => (
          <div class="reveal card-dark text-center sm:text-left" style={`--d: ${i * 100}ms`}>
            <p class="font-semibold text-white">{x.t}</p>
            <p class="mt-1.5 text-sm leading-relaxed text-ink-300">{x.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Values (bento) -->
  <Section tone="muted" eyebrow="What we value" title="Five things we won’t trade away.">
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
      {values.map((v, i) => (
        i === 0 ? (
          <div class="reveal relative overflow-hidden rounded-2xl bg-brand-700 p-8 text-white md:col-span-2 lg:p-10" style={`--d: ${i * 80}ms`}>
            <div class="bg-grid pointer-events-none absolute inset-0 opacity-60"></div>
            <div class="pointer-events-none absolute -right-16 -bottom-20 h-64 w-64 rounded-full bg-saffron-500/25 blur-3xl"></div>
            <div class="relative">
              <IconBadge icon={v.icon} tone="dark" size="lg" />
              <h3 class="mt-6 text-2xl text-white sm:text-3xl">{v.title}</h3>
              <p class="mt-3 max-w-xl text-lg leading-relaxed text-brand-100">{v.text}</p>
            </div>
          </div>
        ) : (
          <div class="reveal card" style={`--d: ${i * 80}ms`}>
            <IconBadge icon={v.icon} tone={i % 2 ? 'brand' : 'saffron'} />
            <h3 class="mt-5 text-lg">{v.title}</h3>
            <p class="mt-2 text-[0.95rem] leading-relaxed text-ink-600">{v.text}</p>
          </div>
        )
      ))}
    </div>
  </Section>

  <!-- How we work: promises, not a sequence, so a plain list -->
  <Section tone="light" id="how-we-work">
    <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-20">
      <div class="reveal lg:sticky lg:top-28 lg:self-start">
        <p class="eyebrow">How we work</p>
        <h2 class="mt-3 text-3xl leading-tight font-extrabold sm:text-4xl lg:text-[2.75rem]">Five promises, written into every project.</h2>
        <p class="mt-5 text-lg leading-relaxed text-ink-600">
          These aren’t slogans. They go into the proposal and the contract, so you can hold us to them.
        </p>
        <a href={contactHref()} class="btn btn-primary mt-8">{cta.call}<ArrowRight size={16} aria-hidden="true" /></a>
      </div>
      <ul class="space-y-4">
        {principles.map((p, i) => (
          <li class="reveal flex gap-5 rounded-2xl bg-white p-6 ring-1 ring-ink-100 sm:p-7" style={`--d: ${i * 80}ms`}>
            <IconBadge icon={p.icon} />
            <div>
              <h3 class="text-lg sm:text-xl">{p.title}</h3>
              <p class="mt-2 leading-relaxed text-ink-600">{p.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </Section>

  <!-- What we do -->
  <Section tone="dark" eyebrow="What we do" title="Services for what’s unique. Products for what isn’t.">
    <div class="grid gap-6 lg:grid-cols-2">
      {[
        { label: 'Services', base: '/services', items: services, note: 'Built to your spec. You own the code.' },
        { label: 'Products', base: '/products', items: products, note: 'Ready to deploy, configurable to your process.' },
      ].map((group, gi) => (
        <div class="reveal rounded-3xl bg-white/[0.03] p-6 ring-1 ring-white/10 sm:p-8" style={`--d: ${gi * 120}ms`}>
          <div class="flex items-baseline justify-between gap-4">
            <h3 class="text-xl text-white">{group.label}</h3>
            <a href={href(`${group.base}/`)} class="inline-flex items-center gap-1 py-2 text-sm font-semibold text-brand-300 hover:text-white">See all {group.label.toLowerCase()}<ArrowRight size={14} aria-hidden="true" /></a>
          </div>
          <p class="mt-1 text-sm text-ink-400">{group.note}</p>
          <ul class="mt-6 divide-y divide-white/10">
            {group.items.map((item) => (
              <li>
                <a href={href(`${group.base}/${item.slug}/`)} class="group flex items-center gap-4 py-4">
                  <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-white/[0.06] text-brand-300 ring-1 ring-white/10 transition group-hover:bg-brand-600 group-hover:text-white">
                    <item.icon size={19} stroke-width={1.75} />
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block font-semibold text-white">{item.title}</span>
                    <span class="mt-0.5 block text-sm text-ink-400">{item.blurb}</span>
                  </span>
                  <ArrowRight size={18} class="shrink-0 text-ink-400 transition group-hover:translate-x-0.5 group-hover:text-white" aria-hidden="true" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </Section>

  {flags.team && (
    <Section tone="muted" eyebrow="The team" title="The people you’ll work with." intro="Profiles of the engineers and analysts behind Manka are on their way.">
      {/* TODO: real people only (name, role, photo, one line on their work). No stock photos or invented names. */}
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {[0, 1, 2, 3].map((i) => (
          <div class="reveal" style={`--d: ${i * 80}ms`}>
            <Placeholder icon={UserRoundPlus} title="Add team member" text="Name, role and a line on what they work on." class="h-full min-h-56" />
          </div>
        ))}
      </div>
    </Section>
  )}

  <CtaBand secondary={{ label: cta.allServices, path: '/services/' }} />
</Base>
