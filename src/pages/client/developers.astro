---
// API key: one per client. Generate shows the full key once; Regenerate replaces it (the old one stops working).
// The key comes from GET /account, POST /account/keys makes a new one. Websites (POST /account/websites) are the
// sites allowed to use the key from a browser (Maps JavaScript API); calls from other sites get 403.
import { Copy } from '@lucide/astro';
import AppShell from '../../components/client/AppShell.astro';
import { ui } from '../../components/client/ui';
import { API } from '../../scripts/client-api';
---

<AppShell title="API key" description="Your API key.">
  <section id="key" class={`${ui.card} aria-busy:invisible`} aria-busy="true" aria-label="API key">
    <p data-key-error role="alert" class={`${ui.error} m-4 sm:m-5`}></p>

    <div class="flex items-center gap-4 px-4 py-4 sm:px-5">
      <p data-meta class="flex min-w-0 flex-1 flex-wrap gap-x-3 text-sm text-ink-500">
        <code data-prefix class="font-mono text-ink-900"></code><span data-used class="whitespace-nowrap"></span>
      </p>
      <button type="button" data-generate class={ui.primary} data-primary={ui.primary} data-secondary={ui.secondary}>Generate</button>
    </div>

    <div data-newkey hidden class="mx-4 mb-4 rounded-xs border border-emerald-200 bg-emerald-50 p-4 sm:mx-5">
      <p class="text-sm font-semibold text-emerald-900">Copy this key now. It won’t be shown again.</p>
      <div class="mt-2 flex items-start gap-2">
        <code data-newkey-value class="min-w-0 flex-1 rounded-xs border border-emerald-200 bg-white px-3 py-2 font-mono text-sm break-all text-ink-900"></code>
        <button type="button" data-copy class={ui.secondary}><Copy size={16} aria-hidden="true" /><span data-copy-label>Copy</span></button>
      </div>
    </div>

    <div class="border-t border-ink-200 p-4 sm:p-5">
      <pre class="overflow-x-auto rounded-xs bg-ink-950 p-4 text-xs leading-relaxed text-ink-100"><code>curl {API}/v1/ping \
  -H "Authorization: Bearer YOUR_KEY"</code></pre>
    </div>
  </section>

  <section class={`${ui.card} mt-4`} aria-labelledby="web-title">
    <div class={ui.cardHead}><h2 id="web-title" class={ui.h2}>Websites</h2></div>
    <form id="websites-form" class="grid gap-3 p-4 sm:p-5" novalidate>
      <label for="f-websites" class="text-sm font-semibold text-ink-900">Websites that can use your key in a browser</label>
      <textarea id="f-websites" name="websites" rows="3" spellcheck="false" placeholder="https://yourcompany.com" class="block w-full rounded-xs border border-ink-300 bg-white px-3 py-2.5 font-mono text-sm text-ink-900 placeholder:text-ink-400 focus:border-brand-600 focus:ring-2 focus:ring-brand-500/25 focus:outline-hidden"></textarea>
      <p data-error role="alert" class={ui.error}></p>
      <div class="flex items-center gap-3">
        <button type="submit" class={ui.primary}>Save</button>
        <span data-saved hidden class="text-sm font-medium text-emerald-700">Saved</span>
      </div>
    </form>
  </section>
</AppShell>

<script>
  import { api, handleForm, type Result } from '../../scripts/client-api';

  type Key = { id: number; prefix: string; created_at: string; last_used_at: string | null };

  const $ = <T extends Element = HTMLElement>(sel: string, root: ParentNode = document) => root.querySelector<T>(sel)!;
  const box = $('#key');
  const error = $('[data-key-error]');
  const generate = $<HTMLButtonElement>('[data-generate]');
  const when = (iso: string) =>
    new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'short', year: 'numeric', hour: 'numeric', minute: '2-digit' }).format(new Date(iso));
  let key: Key | null = null;

  function fail(r: Result, fallback: string) {
    if (r.status === 401) return; // AppShell sends the visitor to the login page
    box.removeAttribute('aria-busy');
    error.textContent = typeof r.data?.detail === 'string' ? r.data.detail : fallback;
  }

  async function load() {
    const r = await api('/account');
    if (!r.ok) return fail(r, 'Could not load your key. Refresh the page.');
    key = r.data.key;
    $('[data-prefix]').textContent = key ? `${key.prefix}…` : 'No key yet';
    $('[data-used]').textContent = key ? (key.last_used_at ? `Used ${when(key.last_used_at)}` : 'Not used yet') : '';
    generate.textContent = key ? 'Regenerate' : 'Generate';
    generate.className = key ? generate.dataset.secondary! : generate.dataset.primary!; // Regenerate is the quieter action
    $<HTMLTextAreaElement>('#f-websites').value = (r.data.websites ?? []).join('\n');
    box.removeAttribute('aria-busy');
  }

  generate.addEventListener('click', async () => {
    if (key && !confirm('Regenerate your API key? The current one stops working.')) return;
    generate.disabled = true;
    error.textContent = '';
    const r = await api('/account/keys', {});
    generate.disabled = false;
    if (!r.ok) return fail(r, 'Could not create the key. Try again.');
    $('[data-newkey-value]').textContent = r.data.key;
    $('[data-copy-label]').textContent = 'Copy';
    $('[data-newkey]').hidden = false;
    await load();
  });

  $('[data-copy]').addEventListener('click', async () => {
    const code = $('[data-newkey-value]');
    try {
      await navigator.clipboard.writeText(code.textContent ?? '');
      $('[data-copy-label]').textContent = 'Copied';
    } catch {
      getSelection()?.selectAllChildren(code); // clipboard blocked: key is selected, Ctrl+C works
    }
  });

  // Websites: one per line
  const saved = $('[data-saved]');
  const websites = $<HTMLTextAreaElement>('#f-websites');
  websites.addEventListener('input', () => (saved.hidden = true));
  handleForm($<HTMLFormElement>('#websites-form'), () => api('/account/websites', { websites: websites.value.split(/[\s,]+/) }), (r) => {
    websites.value = r.data.join('\n');
    saved.hidden = false;
  });

  load();
</script>
