---
// One page per API (/client/api/{name}/): Try it (POST /account/try/{name}, paid from the balance)
// and the API's endpoint + curl. Pages come from src/data/api-content.ts; planned APIs get an empty page.
// Maps API: Try asks for the browser's location, makes a link (charged) and shares the fix through it, then shows the
// place name (display only), latitude, longitude and map image; its Requests card lists the requests (GET /account/locations)
// with a link to each map image.
// BSA: Try uploads the statement PDF (multipart) and shows a compact summary with a download of the full JSON report;
// a Supported banks card lists the banks (client app only).
// Payslip Checker: same upload flow; the Report card shows the credit desk's full report (verdict, checks, payslip, PDF
// details) and a JSON download of the same data.
import AppShell from '../../../components/client/AppShell.astro';
import AuthForm from '../../../components/client/AuthForm.astro';
import Field from '../../../components/client/Field.astro';
import { ui } from '../../../components/client/ui';
import { apiPlanned, apiProducts, bsaBanks, curl, type ApiProduct } from '../../../data/api-content';
import { href } from '../../../data/site';

export function getStaticPaths() {
  return [
    ...apiProducts.map((p) => ({ params: { name: p.name }, props: { title: p.title, p } })),
    ...apiPlanned.map((p) => ({ params: { name: p.name }, props: { title: p.title, p: null } })),
  ];
}
const { title, p } = Astro.props as { title: string; p: ApiProduct | null };
---

<AppShell title={title}>
  {p ? (
    <div id="api" data-name={p.name} data-location={p.tryLocation ? '' : undefined} class="grid grid-cols-1 gap-4 aria-busy:invisible lg:grid-cols-2" aria-busy="true">
      <section class={ui.card} aria-labelledby="try-title">
        <div class={ui.cardHead}><h2 id="try-title" class={ui.h2}>Try it</h2></div>
        <div class="p-4 sm:p-5">
          <AuthForm id="try" submit={p.verb}>
            {p.upload && (
              <>
                <div>
                  <label for="f-file" class="text-sm font-semibold text-ink-900">{p.fields[0].label}</label>
                  <input id="f-file" name="file" type="file" accept=".pdf,application/pdf" required class="mt-2 block w-full rounded-xs border border-ink-300 bg-white text-sm text-ink-900 file:mr-3 file:min-h-11 file:cursor-pointer file:border-0 file:border-r file:border-ink-300 file:bg-ink-50 file:px-4 file:text-sm file:font-semibold file:text-ink-900 hover:file:bg-ink-100 focus:border-brand-600 focus:ring-2 focus:ring-brand-500/25 focus:outline-hidden" />
                </div>
                <div>
                  <label for="f-password" class="text-sm font-semibold text-ink-900">PDF password</label>
                  <input id="f-password" name="password" type="password" autocomplete="off" maxlength="256" class="mt-2 block w-full rounded-xs border border-ink-300 bg-white px-3 py-2.5 text-base text-ink-900 transition focus:border-brand-600 focus:ring-2 focus:ring-brand-500/25 focus:outline-hidden" />
                </div>
              </>
            )}
            {!p.tryLocation && !p.upload && p.fields.map((f) => (
              <Field name={f.name} label={f.label} type={f.type === 'number' ? 'number' : 'text'} autocomplete="off" placeholder={`e.g. ${f.example}`} />
            ))}
            <p data-cost class="rounded-xs border border-amber-200 bg-amber-50 p-3 text-sm font-medium text-amber-900 empty:hidden"></p>
          </AuthForm>
          <dl data-result hidden class="mt-5 grid grid-cols-[auto_minmax(0,1fr)] gap-x-4 gap-y-2 border-t border-ink-100 pt-4 text-sm"></dl>
        </div>
      </section>

      <section class={ui.card} aria-labelledby="api-title">
        <div class={ui.cardHead}>
          <h2 id="api-title" class={ui.h2}>API</h2>
          <a href={href(`/docs/#${p.name}`)} class={`${ui.link} -mr-2 text-brand-700`}>Docs</a>
        </div>
        <div class="space-y-4 p-4 sm:p-5">
          <p class="text-sm text-ink-600">{p.summary}</p>
          <p class="flex flex-wrap items-center gap-2 font-mono text-sm text-ink-900">
            <span class="rounded-xs bg-brand-50 px-1.5 py-0.5 text-xs font-bold text-brand-700">{p.method}</span>{p.path}
          </p>
          <pre class="rounded-xs bg-ink-950 p-4 text-xs leading-relaxed break-all whitespace-pre-wrap text-ink-100"><code>{curl(p)}</code></pre>
          {p.script && <pre class="rounded-xs bg-ink-950 p-4 text-xs leading-relaxed break-all whitespace-pre-wrap text-ink-100"><code>{p.script}</code></pre>}
        </div>
      </section>

      {p.upload && (
        <section data-report hidden class={`${ui.card} scroll-mt-20 lg:col-span-2`} aria-labelledby="report-title">
          <div class={ui.cardHead}><h2 id="report-title" class={ui.h2}>Report</h2></div>
          <div data-report-body class="grid grid-cols-1 gap-6 p-4 text-sm sm:p-5 lg:grid-cols-2 lg:gap-x-10"></div>
        </section>
      )}

      {p.name === 'bsa' && (
        <section class={`${ui.card} lg:col-span-2`} aria-labelledby="banks-title">
          <div class={ui.cardHead}><h2 id="banks-title" class={ui.h2}>Supported banks</h2></div>
          <ul class="columns-2 gap-x-6 p-4 text-sm text-ink-700 sm:p-5 md:columns-3 xl:columns-4">
            {bsaBanks.map((b) => <li class="break-inside-avoid py-1">{b}</li>)}
            <li class="break-inside-avoid py-1 text-ink-500">+ more</li>
          </ul>
        </section>
      )}

      {p.name === 'maps' && (
        <section class={`${ui.card} lg:col-span-2`} aria-labelledby="req-title">
          <div class={ui.cardHead}><h2 id="req-title" class={ui.h2}>Requests</h2></div>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead class="bg-ink-50"><tr><th class={ui.th}>Reference</th><th class={ui.th}>Status</th><th class={ui.th}>Location</th><th class={ui.th}>When</th></tr></thead>
              <tbody data-requests></tbody>
            </table>
          </div>
          <p data-requests-empty class="border-t border-ink-100 px-4 py-6 text-sm text-ink-500 sm:px-5">No requests yet.</p>
        </section>
      )}
    </div>
  ) : (
    <section class={`${ui.card} px-5 py-8 text-sm text-ink-500`}>Coming soon.</section>
  )}
</AppShell>

<script>
  import { API, api, handleForm, type Result } from '../../../scripts/client-api';
  import { ui } from '../../../components/client/ui';
  import { geoError, getFix, placeName } from '../../../scripts/geo';

  const $ = <T extends Element = HTMLElement>(sel: string, root: ParentNode = document) => root.querySelector<T>(sel)!;
  const box = document.querySelector<HTMLElement>('#api'); // null on a planned API's page
  const rupees = (paise: number) => new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(paise / 100);
  // Response field → label: "holder_type" → "Holder type", "data_as_of" → "Data as of", "micr" → "MICR".
  const ACRONYMS = new Set(['pan', 'gstin', 'ifsc', 'micr', 'upi', 'neft', 'rtgs', 'imps', 'url']);
  const LABELS: Record<string, string> = { accuracy_m: 'Accuracy (m)', lat: 'Latitude', lng: 'Longitude', image: 'Map' };

  // Maps API Try: this browser's location → a link (charged like the API) → the fix shared through it → what came back,
  // with the place name looked up for display only.
  async function tryLocation(name: string): Promise<Result> {
    let fix: GeolocationPosition;
    try {
      fix = await getFix();
    } catch (e) {
      return { ok: false, status: 400, data: { detail: geoError(e) } };
    }
    const link = await api(`/account/try/${name}`, { reference: 'Dashboard' });
    if (!link.ok) return link;
    const lat = +fix.coords.latitude.toFixed(7);
    const lng = +fix.coords.longitude.toFixed(7);
    const accuracy_m = +fix.coords.accuracy.toFixed(1);
    const shared = await api(`/locate/${new URL(link.data.url).searchParams.get('t')}`, { lat, lng, accuracy_m });
    if (!shared.ok) return shared;
    const image = `${API}/v1/maps/image/${link.data.request}.png?credit=1`; // our own page: credit on the image
    return { ok: true, status: 200, data: { place: await placeName(lat, lng), lat, lng, accuracy_m, image, request: link.data.request } };
  }
  const label = (k: string) => {
    if (LABELS[k]) return LABELS[k];
    const s = k.split('_').map((w) => (ACRONYMS.has(w) ? w.toUpperCase() : w)).join(' ');
    return s.charAt(0).toUpperCase() + s.slice(1);
  };
  const when = (iso: string) =>
    new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' }).format(new Date(iso));

  // A value with a Copy button (the Maps API link the client sends on).
  function copyable(text: string) {
    const wrap = document.createElement('div');
    wrap.className = 'flex items-start gap-2';
    const code = document.createElement('code');
    code.className = 'min-w-0 flex-1 rounded-xs bg-ink-50 p-2 font-mono text-xs font-normal break-all text-ink-900';
    code.textContent = text;
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = ui.secondary;
    btn.textContent = 'Copy';
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = 'Copied';
      } catch {
        getSelection()?.selectAllChildren(code); // clipboard blocked: the link is selected, Ctrl+C works
      }
    });
    wrap.append(code, btn);
    return wrap;
  }

  type Loc = { request: string; reference: string; status: string; url: string | null; lat: number | null; lng: number | null; accuracy_m: number | null; located_at: string | null; expires_at: string; image: string | null };
  const STATUS: Record<string, string> = { pending: 'Waiting', done: 'Shared', expired: 'Expired' };

  // Maps API: the client's link requests, newest first.
  async function loadRequests() {
    const body = document.querySelector('[data-requests]');
    if (!body) return;
    const r = await api('/account/locations');
    if (!r.ok) return;
    const rows: Loc[] = r.data;
    body.replaceChildren(
      ...rows.map((x) => {
        const tr = document.createElement('tr');
        const cells: [string, string, string?][] = [ // text, classes, link
          [x.reference, ''],
          [STATUS[x.status] ?? x.status, ''],
          x.lat === null ? ['—', 'text-ink-400'] : [`${x.lat}, ${x.lng} (±${Math.round(x.accuracy_m ?? 0)} m)`, 'font-mono text-xs whitespace-nowrap', x.image ? `${x.image}?credit=1` : undefined],
          x.located_at ? [when(x.located_at), 'tabular-nums'] : [`Expires ${when(x.expires_at)}`, 'tabular-nums text-ink-500'],
        ];
        cells.forEach(([text, extra, link]) => {
          const td = document.createElement('td');
          td.className = `border-t border-ink-100 px-4 py-3 align-top sm:px-5 ${extra}`;
          td.textContent = text;
          if (link) {
            const a = document.createElement('a');
            Object.assign(a, { href: link, target: '_blank', rel: 'noopener', textContent: text, className: 'text-brand-700 underline underline-offset-4' });
            td.replaceChildren(a);
          }
          tr.append(td);
        });
        return tr;
      }),
    );
    $('[data-requests-empty]').hidden = rows.length > 0;
  }

  const inr = (n: number) => new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', maximumFractionDigits: 0 }).format(n);
  const VERDICT: Record<string, string> = {
    ORIGINAL: 'border-emerald-200 bg-emerald-50 text-emerald-900',
    SUSPICIOUS: 'border-amber-200 bg-amber-50 text-amber-900',
    GENUINE: 'border-emerald-200 bg-emerald-50 text-emerald-900',
    NEEDS_REVIEW: 'border-amber-200 bg-amber-50 text-amber-900',
    PROBABLY_FAKE: 'border-rose-200 bg-rose-50 text-rose-900',
    FAKE: 'border-rose-200 bg-rose-50 text-rose-900',
  };
  const QUALITY: Record<string, string> = { READY: 'text-emerald-700', REVIEW: 'text-amber-700', NOT_USABLE: 'text-rose-700' };
  const SEVERITY: Record<string, string> = { high: 'text-rose-700', medium: 'text-amber-700', low: 'text-ink-500' };
  const el = (tag: string, cls = '', text = '') => Object.assign(document.createElement(tag), { className: cls, textContent: text });
  const day = (d?: string) => (d ? new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }).format(new Date(d)) : '');

  // BSA report card: [verdict, downloads, data-quality note (only when not READY), risk flags] | [key figures].
  // Only the verdict is shown: why it was flagged (and UPI Mobiles) is in the Excel and JSON, never on screen - no
  // detection logic for users (owner, 2026-11-26).
  // The verdict box both reports share: the coloured verdict word is the one dominant element.
  function verdictBox(verdict: string, ...lines: string[]): HTMLElement {
    const box = el('div', `border p-4 ${VERDICT[verdict] ?? 'border-ink-200 bg-ink-50 text-ink-900'}`);
    box.append(el('p', 'text-xs font-semibold', 'Verdict'), el('p', 'text-2xl font-bold tracking-tight', verdict.replace(/_/g, ' ') || '—'));
    lines.filter(Boolean).forEach((t, i) => box.append(el('p', i ? 'mt-3 text-sm leading-relaxed' : 'mt-1 text-sm font-semibold', t)));
    return box;
  }

  function renderReport(d: any): HTMLElement[] {
    const verdict: string = d.authenticity?.verdict ?? '';
    const left = el('div', 'min-w-0 space-y-4');
    left.append(verdictBox(verdict), downloads(d));
    const q = d.data_quality ?? {};
    if (q.message && q.level !== 'READY') left.append(el('p', 'text-ink-600', q.message));
    // the "Document is fake / suspicious" flag repeats the verdict box
    const flags: { severity: string; message: string }[] = (d.risk_flags ?? []).filter(
      (f: any) => verdict === 'ORIGINAL' || !/^Document is/i.test(f.message ?? ''),
    );
    if (flags.length) {
      const ul = el('ul', 'space-y-1.5 text-ink-700');
      flags.forEach((f) => {
        const li = el('li', 'break-words');
        const sev = f.severity ? f.severity.charAt(0).toUpperCase() + f.severity.slice(1) : '';
        if (sev) li.append(el('span', `font-semibold ${SEVERITY[f.severity] ?? 'text-ink-500'}`, sev), ' ');
        li.append(f.message);
        ul.append(li);
      });
      left.append(el('h3', 'font-semibold text-ink-900', 'Risk flags'), ul);
    }

    const m = d.meta ?? {};
    const s = d.summary ?? {};
    const rows: [string, string, string?][] = [
      ['Data quality', q.level ? q.level.replace(/_/g, ' ') : '—', QUALITY[q.level]],
      ['Bank', m.bank_name ?? '—'],
      ['Account holder', m.account_holder ?? '—'],
      ['Account', m.account_number ?? '—'],
      ['Period', m.period_from && m.period_to ? `${day(m.period_from)} to ${day(m.period_to)}` : '—'],
      ['Transactions', m.txn_count == null ? '—' : String(m.txn_count)],
      ['Monthly income', s.monthly_income == null ? 'No salary detected' : inr(s.monthly_income)],
      ['Existing EMI', s.existing_emi == null ? '—' : inr(s.existing_emi)],
      ['Bounces', s.bounce_count == null ? '—' : String(s.bounce_count)],
      ['Average balance (ABB)', s.abb == null ? '—' : inr(s.abb)],
    ];
    const dl = el('dl', 'grid min-w-0 grid-cols-[auto_minmax(0,1fr)] content-start gap-x-4 gap-y-2');
    rows.forEach(([k, v, cls]) => dl.append(el('dt', 'text-ink-500', k), el('dd', `font-semibold break-words text-ink-900 ${cls ?? ''}`, v)));
    return [left, dl];
  }

  // Payslip Checker report card, the same report as the owner's credit desk:
  // [verdict box (risk, confidence, summary), JSON download, red flags, how to clear an unlocked file, looks fine] | [checks]
  // then full width: payslip (employer, employee, UAN, PF number, one table row per month) and PDF details.
  const STATUS_MARK: Record<string, [string, string, string]> = { // glyph, colour, screen-reader word
    pass: ['✓', 'text-emerald-700', 'Passed'],
    warn: ['!', 'text-amber-700', 'Warning'],
    fail: ['✕', 'text-rose-700', 'Failed'],
    review: ['?', 'text-amber-700', 'Needs review'],
  };
  const cap = (s: string) => s.charAt(0) + s.slice(1).toLowerCase().replace(/_/g, ' ');

  function marked(status: string, text: string, cls = ''): HTMLElement {
    const [glyph, colour, word] = STATUS_MARK[status] ?? STATUS_MARK.warn;
    const p = el('span', `flex gap-2 ${cls}`);
    p.append(el('span', `grid h-5 w-4 shrink-0 place-items-center font-bold ${colour}`, glyph), el('span', 'sr-only', `${word}: `), el('span', 'min-w-0', text));
    p.firstElementChild!.setAttribute('aria-hidden', 'true');
    return p;
  }

  function section(title: string, ...body: Node[]): HTMLElement {
    const s = el('section', 'min-w-0 space-y-3');
    s.append(el('h3', 'font-semibold text-ink-900', title), ...body);
    return s;
  }

  function pairs(rows: [string, string | Node][], wide = false): HTMLElement {
    const dl = el('dl', `grid min-w-0 grid-cols-[9rem_minmax(0,1fr)] content-start gap-x-4 gap-y-2 ${wide ? 'lg:grid-cols-[9rem_minmax(0,1fr)_9rem_minmax(0,1fr)] lg:gap-x-6' : ''}`);
    rows.forEach(([k, v]) => {
      const dd = el('dd', `break-words ${v ? 'font-semibold text-ink-900' : 'text-ink-400'}`);
      dd.append(v || '—');
      dl.append(el('dt', 'text-ink-500', k), dd);
    });
    return dl;
  }

  function renderPayslip(d: any): HTMLElement[] {
    const verdict: string = d.verdict ?? '';
    const money = (v: unknown) => (typeof v === 'number' && v ? inr(v) : '—');
    const slips: any[] = Array.isArray(d.payslips) ? d.payslips : [];
    const ids = d.ids ?? {};
    const m = d.metadata ?? {};

    const left = el('div', 'min-w-0 space-y-6');
    const head = [d.risk && `${cap(d.risk)} risk`, d.confidence && `${cap(d.confidence)} confidence`].filter(Boolean).join(' · ');
    left.append(verdictBox(verdict, head, d.summary), downloads(d, false));
    const list = (items: string[], status: string) => {
      const ul = el('ul', 'space-y-1.5 text-ink-700');
      items.forEach((t) => {
        const li = el('li');
        li.append(marked(status, t));
        ul.append(li);
      });
      return ul;
    };
    if (d.red_flags?.length) left.append(section('Red flags', list(d.red_flags, 'fail')));
    if (d.unlocked) {
      const ol = el('ol', 'list-decimal space-y-1 pl-5 text-ink-700');
      ol.append(
        el('li', '', 'Ask for the original password-protected PDF and check it with its password.'),
        el('li', '', `Match the net pay${slips[0]?.net_pay ? ` (${inr(slips[0].net_pay)})` : ''} with the salary credit in the bank statement.`),
        el('li', '', 'Verify the UAN on EPFO.'),
      );
      left.append(section('To clear it', ol));
    }
    if (d.looks_fine?.length) left.append(section('Looks fine', list(d.looks_fine, 'pass')));

    // phones: label above its detail; from sm: label | detail
    const checks = el('dl', 'grid min-w-0 grid-cols-1 sm:grid-cols-[10rem_minmax(0,1fr)] sm:gap-x-4 sm:gap-y-2.5');
    (d.checks ?? []).forEach((c: any) => {
      const dt = el('dt', 'font-semibold text-ink-900');
      dt.append(marked(c.status, c.label));
      checks.append(dt, el('dd', 'break-words pb-3 pl-6 text-ink-700 sm:pb-0 sm:pl-0', c.detail));
    });
    const right = section('Checks', checks);

    // Payslip: who and which IDs, then one row per month
    const uan = ids.uan ? `${ids.uan} · ${ids.uan_valid ? '12 digits' : `${ids.uan.length} digits, not valid`}` : 'Not on payslip';
    const p = slips[0] ?? {};
    const who: [string, string][] = slips.length
      ? [['Employer', p.employer_name], ['Employee', p.employee_name], ['Employee ID', p.employee_id], ['Designation', p.designation]]
      : [];
    const payslip = section(slips.length > 1 ? `Payslips (${slips.length} months)` : 'Payslip', pairs([...who, ['UAN', uan], ['PF number', ids.pf_number || 'Not on payslip']], true));
    if (slips.length) {
      const cols = ['Month', 'Days paid', 'Gross', 'Basic + DA', 'HRA', 'PF', 'TDS', 'Net pay', 'In words'];
      const table = el('table', 'w-full text-sm whitespace-nowrap');
      const tr = el('tr');
      const align = (i: number) => (i ? 'text-right' : 'text-left');
      const stick = (i: number) => (i ? '' : 'sticky left-0 border-r border-r-ink-200'); // Month stays put while the rest scrolls
      cols.forEach((c, i) => tr.append(el('th', `${ui.th.replace('text-left', align(i))} bg-ink-50 ${stick(i)}`, c)));
      const thead = el('thead');
      thead.append(tr);
      const tbody = el('tbody', 'text-ink-900');
      slips.forEach((s) => {
        const share = s.wage_share ? ` (${Math.round(s.wage_share * 100)}%)` : '';
        const days = s.paid_days ? `${s.paid_days}${s.total_days ? ` / ${s.total_days}` : ''}${s.lop_days ? ` (${s.lop_days} LOP)` : ''}` : 'Not printed';
        const wordsOff = s.net_pay_in_words_value && Math.abs(s.net_pay_in_words_value - s.net_pay) > 1;
        const cells: [string, string?][] = [
          [s.pay_month || '—', 'font-semibold'],
          [days, s.paid_days ? '' : 'font-semibold text-rose-700'],
          [money(s.gross)],
          [money((s.basic || 0) + (s.da || 0)) + share],
          [money(s.hra)],
          [money(s.pf)],
          [money(s.tds)],
          [money(s.net_pay), 'font-semibold'],
          [money(s.net_pay_in_words_value), wordsOff ? 'font-semibold text-rose-700' : ''],
        ];
        const row = el('tr');
        cells.forEach(([t, cls], i) => row.append(el('td', `${ui.td} ${align(i)} tabular-nums ${i ? '' : `${stick(i)} bg-white`} ${cls ?? ''}`, t)));
        tbody.append(row);
      });
      table.append(thead, tbody);
      const scroll = el('div', '-mx-4 overflow-x-auto border-y border-ink-200 focus-visible:outline-2 focus-visible:outline-brand-500 sm:mx-0 sm:border-x');
      Object.assign(scroll, { tabIndex: 0, role: 'region' });
      scroll.setAttribute('aria-label', 'Months');
      scroll.append(table);
      payslip.append(scroll);
    }

    const pdf = section('PDF details', pairs([
      ['Producer', m.producer], ['Creator', m.creator], ...(m.xmp_tools?.length ? [['Tool history', m.xmp_tools.join(', ')] as [string, string]] : []),
      ['Author', m.author], ['Title', m.title], ['Created', m.created], ['Modified', m.modified],
      ['Pages', m.pages == null ? '' : String(m.pages)], ['PDF version', m.pdf_version],
      ['Password protected', m.encrypted ? 'Yes' : 'No'], ['Times saved', m.saves == null ? '' : String(m.saves)],
      ['Fonts', (m.fonts ?? []).join(', ')], ['File size', m.size_kb == null ? '' : `${m.size_kb} KB`],
    ], true));
    [payslip, pdf].forEach((s) => s.classList.add('border-t', 'border-ink-100', 'pt-6', 'lg:col-span-2'));
    return [left, right, payslip, pdf];
  }

  // Excel (primary) = BSA's workbook, built by the API from this report (POST /account/bsa/excel, free); JSON = the report.
  function downloads(d: any, excelToo = true): HTMLElement {
    const save = (blob: Blob, ext: string) => {
      const a = Object.assign(document.createElement('a'), { href: URL.createObjectURL(blob), download: `${box?.dataset.name}-report-${d.id ?? 'report'}.${ext}` });
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    };
    const button = (label: string, cls: string, onClick: (b: HTMLButtonElement) => void) => {
      const b = el('button', cls, label) as HTMLButtonElement;
      b.type = 'button';
      b.addEventListener('click', () => onClick(b));
      return b;
    };
    const excel = button('Download Excel', ui.primary, async (b) => {
      b.disabled = true;
      try {
        const r = await fetch(`${API}/account/bsa/excel`, {
          method: 'POST', credentials: 'include', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(d),
        });
        if (!r.ok) throw new Error();
        save(await r.blob(), 'xlsx');
        b.textContent = 'Download Excel';
      } catch {
        b.textContent = 'Excel failed. Try again';
      } finally {
        b.disabled = false;
      }
    });
    const json = button('Download JSON', ui.secondary, () => save(new Blob([JSON.stringify(d, null, 2)], { type: 'application/json' }), 'json'));
    const row = el('div', excelToo ? 'grid grid-cols-2 gap-3' : 'grid grid-cols-1 gap-3');
    if (excelToo) row.append(excel);
    row.append(json);
    return row;
  }

  if (box) {
    const name = box.dataset.name!;
    const result = $('[data-result]');
    const report = document.querySelector<HTMLElement>('[data-report]');
    const costNote = $('[data-cost]');

    // Where the next call is paid from, from the latest balances.
    const refresh = async () => {
      const r = await api('/account');
      if (r.status === 401) return; // AppShell sends the visitor to the login page
      box.removeAttribute('aria-busy');
      if (!r.ok) return;
      const price = r.data.prices?.[name];
      costNote.textContent =
        price === undefined ? '' : `${rupees(price)} will be deducted from your balance.`;
    };

    const form = $<HTMLFormElement>('#try');
    const submit = (values: Record<string, string>) =>
      box.hasAttribute('data-location') ? tryLocation(name) : api(`/account/try/${name}`, report ? new FormData(form) : values);
    handleForm(form, submit, async (r) => {
      if (report) {
        report.querySelector('[data-report-body]')!.replaceChildren(...(name === 'payslip' ? renderPayslip(r.data) : renderReport(r.data)));
        report.hidden = false;
        report.scrollIntoView({ block: 'start' });
        await refresh();
        return;
      }
      const { id: _id, ...fields } = r.data;
      result.replaceChildren(
        ...Object.entries(fields).filter(([, v]) => v !== null).flatMap(([k, v]) => {
          const dt = document.createElement('dt');
          dt.className = 'text-ink-500';
          dt.textContent = label(k);
          const dd = document.createElement('dd');
          dd.className = 'font-semibold break-words text-ink-900';
          dd.textContent = typeof v === 'boolean' ? (v ? 'Yes' : 'No') : typeof v === 'object' ? JSON.stringify(v) : String(v);
          if (k === 'url') dd.replaceChildren(copyable(String(v))); // Maps API: the link to send
          if (k === 'image') {
            const img = Object.assign(document.createElement('img'), { src: String(v), alt: 'Map', className: 'w-full rounded-xs border border-ink-200' });
            dd.replaceChildren(img);
          }
          return [dt, dd];
        }),
      );
      result.hidden = false;
      result.scrollIntoView({ block: 'nearest' });
      await Promise.all([refresh(), loadRequests()]);
    });

    refresh();
    loadRequests();
  }
</script>
