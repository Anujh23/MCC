---
// Home: balance + recharge, transactions. Data from GET /account (session cookie).
// Each API has its own page (/client/api/{name}/), keys are on /client/developers/.
// Recharge is manual for now: the client sends the amount on WhatsApp/email, we credit it from Admin.
import { Plus } from '@lucide/astro';
import AppShell from '../../components/client/AppShell.astro';
import Field from '../../components/client/Field.astro';
import { ui } from '../../components/client/ui';
import { contact } from '../../data/site';
---

<AppShell title="Home">
  <div id="home" class="grid grid-cols-1 gap-4 aria-busy:invisible" aria-busy="true">
    <p data-load-error role="alert" class={ui.error}></p>

    <section class={`${ui.card} flex items-end justify-between gap-4 p-5`} aria-labelledby="balance-title">
      <div>
        <h2 id="balance-title" class="text-sm font-medium text-ink-500">Balance</h2>
        <p data-balance class="mt-1 text-3xl font-bold tracking-tight text-ink-900 tabular-nums">₹0.00</p>
      </div>
      <button type="button" data-recharge class={ui.primary}><Plus size={16} aria-hidden="true" />Recharge</button>
    </section>

    <section class={ui.card} aria-labelledby="tx-title">
      <div class={ui.cardHead}><h2 id="tx-title" class={ui.h2}>Transactions</h2></div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-ink-50"><tr><th class={ui.th}>Date</th><th class={ui.th}>Description</th><th class={`${ui.th} text-right`}>Amount</th></tr></thead>
          <tbody data-entries></tbody>
        </table>
      </div>
      <p data-entries-empty class="border-t border-ink-100 px-4 py-6 text-sm text-ink-500 sm:px-5">No transactions yet.</p>
    </section>
  </div>

  <template data-entry-row>
    <tr>
      <td class={`${ui.td} whitespace-nowrap`}><span data-date class="text-ink-900"></span><span data-time class="block text-xs text-ink-500"></span></td>
      <td class={ui.td}><span data-what class="font-medium text-ink-900"></span><span data-note class="block text-xs break-words text-ink-500"></span></td>
      <td data-amount class={`${ui.td} text-right font-semibold whitespace-nowrap tabular-nums`}></td>
    </tr>
  </template>

  <dialog data-recharge-dialog aria-labelledby="recharge-title" class={ui.dialog}>
    <form data-recharge-form class="grid gap-5 p-6" novalidate data-wa={contact.whatsappHref} data-mail={contact.email}>
      <h2 id="recharge-title" class="text-lg font-bold text-ink-900">Recharge</h2>
      <Field name="amount" label="Amount (₹)" type="number" autocomplete="off" min={100} />
      <p class="text-sm text-ink-600">We’ll share payment details and add the amount to your balance once it’s paid.</p>
      <button type="submit" class={`${ui.primary} min-h-11 w-full`}>Continue on WhatsApp</button>
      <div class="flex items-center justify-between">
        <button type="button" data-mail-instead class={`${ui.link} -ml-2 text-brand-700`}>Email instead</button>
        <button type="button" data-close class={`${ui.link} -mr-2 text-ink-600`}>Cancel</button>
      </div>
    </form>
  </dialog>
</AppShell>

<script>
  import { api } from '../../scripts/client-api';

  type Entry = { amount_paise: number; balance_after_paise: number; kind: string; note: string; created_at: string };

  const $ = <T extends Element = HTMLElement>(sel: string, root: ParentNode = document) => root.querySelector<T>(sel)!;
  const home = $('#home');
  const rupees = (paise: number) => new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR' }).format(paise / 100);
  const date = (iso: string) => new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }).format(new Date(iso));
  const time = (iso: string) => new Intl.DateTimeFormat('en-IN', { hour: 'numeric', minute: '2-digit' }).format(new Date(iso));
  const LABEL: Record<string, string> = { recharge: 'Recharge', usage: 'API call', refund: 'Refund', adjustment: 'Adjustment' };
  let email = '';

  function renderEntries(entries: Entry[]) {
    const tpl = $<HTMLTemplateElement>('[data-entry-row]').content.firstElementChild as HTMLElement;
    $('[data-entries]').replaceChildren(
      ...entries.map((e) => {
        const tr = tpl.cloneNode(true) as HTMLElement;
        $('[data-date]', tr).textContent = date(e.created_at);
        $('[data-time]', tr).textContent = time(e.created_at);
        $('[data-what]', tr).textContent = LABEL[e.kind] ?? e.kind;
        $('[data-note]', tr).textContent = e.note;
        const amt = $('[data-amount]', tr);
        amt.textContent = `${e.amount_paise > 0 ? '+' : '−'}${rupees(Math.abs(e.amount_paise))}`;
        amt.classList.add(e.amount_paise > 0 ? 'text-emerald-700' : 'text-ink-900');
        return tr;
      }),
    );
    $('[data-entries-empty]').hidden = entries.length > 0;
  }

  async function load() {
    const r = await api('/account');
    if (r.status === 401) return; // AppShell sends the visitor to the login page
    home.removeAttribute('aria-busy');
    if (!r.ok) return void ($('[data-load-error]').textContent = 'Could not load your account. Refresh the page.');
    email = r.data.email;
    $('[data-balance]').textContent = rupees(r.data.balance_paise);
    renderEntries(r.data.entries);
  }

  // --- Recharge (manual for now: WhatsApp or email with the amount)
  const recharge = $<HTMLDialogElement>('[data-recharge-dialog]');
  const form = $<HTMLFormElement>('[data-recharge-form]', recharge);
  const amount = $<HTMLInputElement>('#f-amount');
  const message = () => `Recharge request\nAccount: ${email}\nAmount: ₹${amount.value}`;

  $('[data-recharge]').addEventListener('click', () => {
    form.reset(); // fresh amount every time, however it was closed last
    recharge.showModal();
  });
  $('[data-close]', recharge).addEventListener('click', () => recharge.close());
  recharge.addEventListener('click', (e) => e.target === recharge && recharge.close());

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;
    window.open(`${form.dataset.wa}?text=${encodeURIComponent(message())}`, '_blank', 'noopener');
    recharge.close();
  });
  $('[data-mail-instead]', recharge).addEventListener('click', () => {
    if (!form.reportValidity()) return;
    location.href = `mailto:${form.dataset.mail}?subject=${encodeURIComponent('Recharge request')}&body=${encodeURIComponent(message())}`;
    recharge.close();
  });

  load();
</script>
