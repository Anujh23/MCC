---
import { MessageCircle } from '@lucide/astro';
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import ContactForm from '../components/company/ContactForm.astro';
import Email from '../components/ui/Email.astro';
import { contact } from '../data/site';
import { breadcrumbList } from '../data/schema';

const crumbs = [{ label: 'Contact' }];
// The side panel offers the phone next to the form. Without a form key, the form is already a call block.
const aside = Boolean(contact.formKey && contact.phone);
---

<Base
  title="Book a free call"
  description="Book a free 30-minute call with a Manka engineer about a CRM, HR system, website, data project or lending tool. We aim to reply within one working day."
  schema={breadcrumbList(crumbs, '/contact/')}
>
  <div class="flex min-h-[calc(100dvh-4rem)] flex-col">
  <section class="relative overflow-hidden bg-ink-950 text-white">
    <div class="bg-grid mask-fade-y pointer-events-none absolute inset-0"></div>
    <div class="pointer-events-none absolute -top-40 -right-32 h-96 w-96 rounded-full bg-brand-600/30 blur-3xl"></div>
    <div class="container-page relative pt-4 pb-16 sm:pt-6 sm:pb-20">
      <Breadcrumbs items={crumbs} class="mb-3" />
      <h1 class="text-3xl leading-tight font-extrabold text-white sm:text-4xl lg:text-5xl">
        Talk to an <span class="text-gradient-saffron">engineer.</span>
      </h1>
    </div>
  </section>

  <section class="flex-1 bg-ink-50 pb-12 lg:pb-16">
    <div class="container-page">
      <div class={`relative -mt-10 grid overflow-hidden rounded-3xl bg-white shadow-xl shadow-ink-900/[0.06] ring-1 ring-ink-100 sm:-mt-12 ${aside ? 'lg:grid-cols-[1fr_24rem]' : ''}`}>
        <div class="p-5 sm:p-8 lg:p-10">
          <ContactForm />
        </div>

        {aside && (
          <aside class="relative bg-ink-950 p-5 text-white sm:p-8 lg:p-10" aria-labelledby="call-title">
            <div class="bg-grid pointer-events-none absolute inset-0 opacity-60"></div>
            <div class="relative">
              <h2 id="call-title" class="text-sm font-semibold text-ink-300">Prefer to talk now?</h2>
              <a
                href={contact.phoneHref}
                class="mt-1 inline-flex min-h-11 items-center rounded-lg text-2xl font-extrabold tracking-tight text-white transition hover:text-brand-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-400"
              >{contact.phone}</a>
              {contact.whatsappHref && (
                <a href={contact.whatsappHref} target="_blank" rel="noopener" class="btn mt-4 bg-white/10 text-white ring-1 ring-white/20 hover:bg-white/15">
                  <MessageCircle size={16} aria-hidden="true" />WhatsApp<span class="sr-only"> (opens in a new tab)</span>
                </a>
              )}
              {contact.email && (
                <a href={contact.emailHref} class="mt-6 block rounded-lg text-sm font-semibold text-ink-200 transition hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-400"><Email /></a>
              )}
            </div>
          </aside>
        )}
      </div>
    </div>
  </section>
  </div>
</Base>
