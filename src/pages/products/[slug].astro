---
import { ArrowRight, Check, ShieldCheck } from '@lucide/astro';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Section from '../../components/ui/Section.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import IconBadge from '../../components/ui/IconBadge.astro';
import Steps from '../../components/ui/Steps.astro';
import Faq from '../../components/ui/Faq.astro';
import RelatedCards from '../../components/ui/RelatedCards.astro';
import ProductMockup from '../../components/products/ProductMockup.astro';
import FeatureVisual from '../../components/products/FeatureVisual.astro';
import CodeBlock from '../../components/products/CodeBlock.astro';
import { products, contactHref, cta, productStatus, relatedFrom } from '../../data/site';
import { softwareLd, breadcrumbList } from '../../data/schema';
import { productsContent, securityCommon } from '../../data/products-content';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params as { slug: string };
const product = products.find((p) => p.slug === slug)!;
const c = productsContent[slug];
const name = product.short ?? product.title;
const path = `/products/${slug}/`;
const crumbs = [{ label: 'Products', path: '/products/' }, { label: product.title }];
const secondary = c.hero.secondary === 'api' ? { label: cta.api, url: '#api' } : { label: cta.how, url: '#how' };
const related = c.related.flatMap((r) => relatedFrom([r.slug]).map((item) => ({ ...item, blurb: r.reason })));
const featured = c.features.items.slice(0, 2);
const rest = c.features.items.slice(2);
---

<Base
  title={c.meta.title}
  description={c.meta.description}
  schema={[
    softwareLd({ name: product.title, description: c.meta.description, path, category: slug === 'maps-api' ? 'DeveloperApplication' : 'BusinessApplication' }),
    breadcrumbList(crumbs, path),
  ]}
>
  <PageHero title={c.hero.title} highlight={c.hero.highlight} intro={c.hero.intro} breadcrumbs={crumbs} status={productStatus}>
    <Fragment slot="actions">
      <a href={contactHref(slug)} class="btn btn-primary group px-6 py-3 text-base">
        {cta.demo}<ArrowRight size={18} class="transition group-hover:translate-x-0.5" aria-hidden="true" />
      </a>
      <a href={secondary.url} class="btn bg-white/10 px-6 py-3 text-base text-white ring-1 ring-white/20 hover:bg-white/15">{secondary.label}</a>
    </Fragment>
    <div slot="aside" class="lg:pl-4">
      <ProductMockup slug={slug} />
    </div>
  </PageHero>

  <!-- Key outcomes strip, overlapping the hero edge -->
  <section class="relative z-10 -mt-10 pb-4 lg:-mt-14">
    <div class="container-page">
      <ul class="grid grid-cols-2 overflow-hidden rounded-2xl bg-white shadow-xl shadow-ink-900/[0.08] ring-1 ring-ink-100 lg:grid-cols-4">
        {c.outcomes.map((o, i) => (
          <li class={`flex flex-col gap-2.5 border-ink-100 p-4 sm:flex-row sm:gap-3.5 sm:p-5 lg:p-6 ${i % 2 === 1 ? 'border-l' : ''} ${i >= 2 ? 'border-t lg:border-t-0' : ''} ${i === 2 ? 'lg:border-l' : ''}`}>
            <span class="mt-0.5 grid h-9 w-9 shrink-0 place-items-center rounded-lg bg-brand-50 text-brand-600 ring-1 ring-brand-100">
              <o.icon size={18} stroke-width={1.9} />
            </span>
            <span>
              <span class="block text-[15px] leading-snug font-semibold text-ink-900 sm:text-base">{o.title}</span>
              <span class="mt-1 hidden text-sm leading-relaxed text-ink-600 sm:block">{o.text}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Features: two featured with a mini-visual, the rest as a plain list -->
  <Section class="max-sm:py-14" eyebrow="Features" title={c.features.title} highlight={c.features.highlight} intro={c.features.intro}>
    <div class="grid gap-5 lg:grid-cols-2">
      {featured.map((f, i) => (
        <div class="card reveal grid gap-5 p-5 sm:grid-cols-[1fr_1.15fr] sm:items-center sm:p-6" style={`--d: ${i * 80}ms`}>
          <div>
            <IconBadge icon={f.icon} />
            <h3 class="mt-4 text-lg font-bold">{f.title}</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-ink-600">{f.text}</p>
          </div>
          {f.visual && <div class="hidden sm:block"><FeatureVisual kind={f.visual} /></div>}
        </div>
      ))}
    </div>
    <ul class="mt-10 grid gap-x-8 gap-y-6 sm:mt-12 sm:grid-cols-2 sm:gap-y-8 lg:grid-cols-4">
      {rest.map((f, i) => (
        <li class="reveal flex gap-4" style={`--d: ${(i % 4) * 80}ms`}>
          <IconBadge icon={f.icon} />
          <span>
            <span class="block font-bold text-ink-900">{f.title}</span>
            <span class="mt-1 block text-sm leading-relaxed text-ink-600 sm:text-[15px]">{f.text}</span>
          </span>
        </li>
      ))}
    </ul>
  </Section>

  <!-- How it works -->
  <Section tone="muted" id="how" class="max-sm:py-14" eyebrow="How it works" title={c.steps.title}>
    <Steps steps={c.steps.items} />
  </Section>

  <!-- API / integration -->
  <Section tone="dark" id="api" class="max-sm:py-14">
    <div class="bg-grid mask-fade-y pointer-events-none absolute inset-0"></div>
    <div class="animate-glow pointer-events-none absolute -top-40 -left-40 h-[30rem] w-[30rem] rounded-full bg-brand-600/25 blur-3xl"></div>
    <div class="relative grid gap-10 lg:grid-cols-[1fr_1.15fr] lg:items-start lg:gap-12">
      <div class="reveal">
        <span class="eyebrow-pill"><span class="h-1.5 w-1.5 rounded-full bg-saffron-500" aria-hidden="true"></span>API &amp; integration</span>
        <h2 class="mt-4 text-3xl leading-tight font-extrabold text-white sm:text-4xl">{c.api.title}</h2>
        <p class="mt-4 text-lg leading-relaxed text-ink-300">{c.api.intro}</p>
        <p class="mt-6">
          <span class="rounded-md bg-white/10 px-2 py-1 font-mono text-xs text-white ring-1 ring-white/10">{c.api.method} {c.api.endpoint}</span>
        </p>
        <ul class="mt-6 grid gap-2.5 sm:mt-8 sm:gap-3">
          {c.api.options.map((o) => (
            <li class="card-dark flex items-center gap-4 p-3 sm:items-start sm:p-5">
              <IconBadge icon={o.icon} tone="dark" />
              <span>
                <span class="block font-semibold text-white">{o.title}</span>
                <span class="mt-1 hidden text-sm leading-relaxed text-ink-300 sm:block">{o.text}</span>
              </span>
            </li>
          ))}
        </ul>
      </div>
      <div class="reveal min-w-0" style="--d: 120ms">
        <CodeBlock method={c.api.method} endpoint={c.api.endpoint} request={c.api.request} response={c.api.response} />
      </div>
    </div>
  </Section>

  <!-- Security & deployment -->
  <Section class="max-sm:py-14" eyebrow="Security" title="Your data, under your control">
    <div class="grid gap-8 lg:grid-cols-[1.6fr_1fr]">
      <ul class="grid gap-x-8 gap-y-5 sm:grid-cols-2 sm:gap-y-7">
        {securityCommon.map((s, i) => (
          <li class="reveal flex gap-4" style={`--d: ${(i % 2) * 80}ms`}>
            <IconBadge icon={s.icon} />
            <span>
              <span class="block font-semibold text-ink-900">{s.title}</span>
              <span class="mt-1 block text-sm leading-relaxed text-ink-600 sm:text-[15px]">{s.text}</span>
            </span>
          </li>
        ))}
      </ul>
      <div class="reveal relative overflow-hidden rounded-2xl bg-ink-950 p-6 text-ink-300 sm:p-7" style="--d: 120ms">
        <div class="bg-grid pointer-events-none absolute inset-0 opacity-60"></div>
        <div class="relative">
          <span class="grid h-11 w-11 place-items-center rounded-xl bg-white/10 text-saffron-400 ring-1 ring-white/15"><ShieldCheck size={22} stroke-width={1.75} /></span>
          <h3 class="mt-5 text-lg font-bold text-white">Specific to {name}</h3>
          <ul class="mt-4 space-y-3">
            {c.security.map((s) => (
              <li class="flex gap-2.5 text-[15px] leading-relaxed">
                <Check size={18} class="mt-0.5 shrink-0 text-saffron-400" aria-hidden="true" />{s}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </Section>

  <!-- Works well with -->
  <Section tone="muted" class="max-sm:py-14" eyebrow="Works well with" title="Better together" intro="Each product works on its own. Connected, nobody re-keys anything.">
    <RelatedCards items={related} />
  </Section>

  <!-- FAQ -->
  <Section class="max-sm:py-14">
    <Faq title={`Questions about ${name}`} items={c.faqs} />
  </Section>

  <CtaBand title={c.cta.title} text={c.cta.text} primary={{ label: cta.demo }} interest={slug} />
</Base>
