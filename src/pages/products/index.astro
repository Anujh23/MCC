---
import { ArrowRight, Check } from '@lucide/astro';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Section from '../../components/ui/Section.astro';
import CtaBand from '../../components/ui/CtaBand.astro';
import IconBadge from '../../components/ui/IconBadge.astro';
import ProductMockup from '../../components/products/ProductMockup.astro';
import { products, href, contactHref, cta, productStatus } from '../../data/site';
import { collectionLd, breadcrumbList } from '../../data/schema';
import { productsContent, lendingJourney } from '../../data/products-content';

const journey = lendingJourney.map((j) => ({ ...j, product: products.find((p) => p.slug === j.slug)! }));
const title = 'Products: Lending, CRM, HRMS & Maps Software';
const description =
  'Ready-to-deploy software from Manka: a lending-ready CRM, bank statement analyser, payslip verification, a Maps API for Indian addresses and an HRMS.';
const crumbs = [{ label: 'Products' }];
---

<Base
  title={title}
  description={description}
  schema={[collectionLd({ name: 'Manka products', description, path: '/products/' }), breadcrumbList(crumbs, '/products/')]}
>
  <PageHero
    title="Ready-made software for lending, sales and HR"
    highlight="Ready-made software"
    intro="Five products, built and ready to deploy. We're onboarding our first clients now."
    breadcrumbs={crumbs}
    status={productStatus}
  >
    <Fragment slot="actions">
      <a href={contactHref()} class="btn btn-primary group px-6 py-3 text-base">
        {cta.demo}<ArrowRight size={18} class="transition group-hover:translate-x-0.5" aria-hidden="true" />
      </a>
      <a href="#lenders" class="btn bg-white/10 px-6 py-3 text-base text-white ring-1 ring-white/20 hover:bg-white/15">See the loan journey</a>
    </Fragment>
    <ul slot="aside" class="grid gap-2.5 sm:gap-3">
      {products.map((p) => (
        <li>
          <a href={href(`/products/${p.slug}/`)} class="card-dark-link group flex items-center gap-4 p-3 sm:p-4">
            <IconBadge icon={p.icon} tone="dark" />
            <span class="min-w-0 flex-1">
              <span class="block font-semibold text-white">{p.title}</span>
              <span class="mt-0.5 hidden text-sm text-ink-300 sm:block">{p.blurb}</span>
            </span>
            <ArrowRight size={18} class="shrink-0 text-ink-300 transition group-hover:translate-x-0.5 group-hover:text-white" aria-hidden="true" />
          </a>
        </li>
      ))}
    </ul>
  </PageHero>

  <!-- Showcase -->
  <Section class="max-sm:py-14" eyebrow="The line-up" title="Real software, not slideware" highlight="not slideware" intro="Shown with sample data, the way your team would see it.">
    <div class="space-y-16 lg:space-y-28">
      {products.map((p, i) => {
        const c = productsContent[p.slug];
        const flip = i % 2 === 1;
        return (
          <article class={`grid items-center gap-8 lg:grid-cols-2 lg:gap-16 ${i > 0 ? 'cv-auto' : ''}`}>
            <div class={`reveal ${flip ? 'lg:order-2' : ''}`}>
              <div class="flex items-center gap-3">
                <IconBadge icon={p.icon} size="lg" />
                <span class="text-sm font-semibold text-brand-700 tabular-nums" aria-hidden="true">0{i + 1}</span>
              </div>
              <h3 class="mt-5 text-2xl font-extrabold sm:mt-6 sm:text-3xl">{p.title}</h3>
              <p class="mt-2 text-lg font-medium text-ink-900">{c.card.tagline}</p>
              <ul class="mt-5 space-y-2.5 sm:mt-6">
                {c.card.bullets.map((b) => (
                  <li class="flex gap-3 text-ink-700">
                    <span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-brand-50 text-brand-600 ring-1 ring-brand-100"><Check size={12} stroke-width={3} /></span>
                    {b}
                  </li>
                ))}
              </ul>
              <div class="mt-7 flex flex-wrap gap-3 sm:mt-8">
                <a href={href(`/products/${p.slug}/`)} class="btn btn-primary group">
                  {cta.explore(p.short ?? p.title)}<ArrowRight size={16} class="transition group-hover:translate-x-0.5" aria-hidden="true" />
                </a>
              </div>
            </div>
            <div class={`reveal min-w-0 ${flip ? 'lg:order-1' : ''}`} style="--d: 120ms">
              <a href={href(`/products/${p.slug}/`)} tabindex="-1" aria-hidden="true" class="group relative block overflow-hidden rounded-3xl bg-ink-950 p-4 max-sm:max-h-[22rem] sm:p-8">
                <div class="bg-grid pointer-events-none absolute inset-0"></div>
                <div class={`animate-glow pointer-events-none absolute -top-24 h-72 w-72 rounded-full blur-3xl ${i % 2 ? '-left-16 bg-saffron-500/20' : '-right-16 bg-brand-600/40'}`}></div>
                <div class="relative transition duration-500 ease-out-expo group-hover:-translate-y-1">
                  <ProductMockup slug={p.slug} float={false} />
                </div>
                <div class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-ink-950 to-transparent sm:hidden"></div>
              </a>
            </div>
          </article>
        );
      })}
    </div>
  </Section>

  <!-- Built for lenders -->
  <Section tone="dark" id="lenders" class="max-sm:py-14" eyebrow="Built for lenders" title="One loan journey, four products, no re-keying" intro="BSA, Payslip Checker, Maps API and our CRM share data, so every check stays on the file.">
    <div class="bg-grid mask-fade-y pointer-events-none absolute inset-0 -z-0"></div>
    <ol class="relative -mx-4 flex snap-x snap-mandatory scroll-px-4 gap-4 overflow-x-auto px-4 pb-2 sm:mx-0 sm:grid sm:grid-cols-2 sm:overflow-visible sm:px-0 sm:pb-0 lg:grid-cols-5">
      <span class="absolute top-[2.15rem] right-[10%] left-[10%] hidden h-px bg-gradient-to-r from-brand-500/0 via-brand-400/60 to-saffron-500/60 lg:block" aria-hidden="true"></span>
      {journey.map((j, i) => (
        <li class="reveal relative flex w-[78%] shrink-0 snap-start sm:w-auto" style={`--d: ${i * 90}ms`}>
          <div class="card-dark flex w-full flex-col p-5">
            <div class="flex items-center justify-between">
              <span class="relative grid h-11 w-11 place-items-center rounded-xl bg-ink-900 text-saffron-400 ring-1 ring-white/15"><j.icon size={20} stroke-width={1.75} /></span>
              <span class="text-xs font-semibold tracking-wide text-ink-300 uppercase">Step {i + 1}</span>
            </div>
            <p class="mt-5 text-xs font-semibold tracking-wide text-saffron-400 uppercase">{j.stage}</p>
            <h3 class="mt-1 text-lg font-bold text-white">{j.title}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-300">{j.text}</p>
            <a href={href(`/products/${j.slug}/`)} class="mt-5 inline-flex min-h-9 items-center gap-1.5 self-start rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-white ring-1 ring-white/15 hover:bg-white/15">
              <j.product.icon size={13} aria-hidden="true" />{j.product.short ?? j.product.title}
            </a>
          </div>
        </li>
      ))}
    </ol>
  </Section>

  <CtaBand
    title="Not sure which product fits?"
    text="Tell us how your team works. An engineer will show you the right product in 30 minutes."
    primary={{ label: cta.demo }}
  />
</Base>
